DEV_PREVIEW_BYPASS="true"

# 2. Google Cloud Service Account (for Sheets v4 & Drive v3 REST APIs)
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
# Note: Code automatically normalizes escaped newlines (\n)
GOOGLE_PRIVATE_KEY=""

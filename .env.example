# 3. Email Notifications & Login OTP (Resend REST API)
RESEND_API_KEY=""
PORTAL_FROM_EMAIL="Kantorei Portal <onboarding@resend.dev>"
SANDBOX_OVERRIDE_EMAIL=""

# 4. Box Office & Fundraising Embeds (Use "DEMO" in sandbox mode)

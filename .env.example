# ==============================================================================
# KANTOREI ENVIRONMENT POLICY & CONFIGURATION TEMPLATE (.env.example)
#
# Rules:
# 1. Never commit `.env` or `.dev.vars` to Git (enforced in .gitignore).
# 2. In Local Dev: If Google/Resend are empty or set to "DEMO", realistic mock
#    repertoire, schedule, and roster data will automatically be used.
# 3. Before deploying to Cloudflare Workers, audit your environment with:
#    npm run doctor:env:prod
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SITE & STATELESS AUTH
# ------------------------------------------------------------------------------
# [Public] The public canonical URL of the site. In production, must be https://
PUBLIC_SITE_URL="http://localhost:4321"

# [Secret] Required in production! High-entropy 32+ character key for Web Crypto JWTs and OTPs.
# Generate production secret with: openssl rand -base64 32
AUTH_SECRET="dev-kantorei-secret-change-me-in-production-32bytes"

# [Config] DEV ONLY. Strictly ignored outside Vite local development (import.meta.env.DEV).
# Set to "true" to enable 1-click role switcher in the portal navigation bar without logging in.
DEV_PREVIEW_BYPASS="true"

# [Config] Optional Google OAuth 2.0 PKCE credentials (if offering 1-click Google Login)
GOOGLE_OAUTH_CLIENT_ID=""
# [Secret] Optional client secret for Google OAuth
GOOGLE_OAUTH_CLIENT_SECRET=""

# ------------------------------------------------------------------------------
# 2. GOOGLE CLOUD SERVICE ACCOUNT & MASTER SHEET (CMS)
# ------------------------------------------------------------------------------
# [Secret] Service Account email created in Google Cloud Console
# Quick setup: npm run setup:key -- ~/Downloads/your-sa-key.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=""

# [Secret] RS256 PEM Private Key (escaped \n newlines are normalized automatically)
GOOGLE_PRIVATE_KEY=""

# [Config] Master Google Sheet ID or URL. Use "DEMO" to run with mock choir data.
GOOGLE_MASTER_SHEET_ID="DEMO"

# [Config] Google Drive Folder ID containing repertoire piece subfolders (PDFs & rehearsal MP3s)
REPERTOIRE_DRIVE_FOLDER_ID="1tIPYJBkibVLjQOaGSzZ2y7L9UOTNOyJc"

# [Config] Optional Google Calendar ID for live call sync (falls back to Schedule sheet tab)
GOOGLE_CALENDAR_ID=""

# ------------------------------------------------------------------------------
# 3. EMAIL NOTIFICATIONS & LOGIN OTP (RESEND REST API)
# ------------------------------------------------------------------------------
# [Secret] Resend API key (re_...). If left empty, OTP login code displays on-screen in dev.
RESEND_API_KEY=""

# [Config] Sender display name & email address.
# In production, use your verified domain (e.g., "Kantorei Portal <portal@kantorei.net>").
# In dev/sandbox without DNS, keep "Kantorei Portal <onboarding@resend.dev>".
PORTAL_FROM_EMAIL="Kantorei Portal <onboarding@resend.dev>"

# [Config] Dev/Sandbox testing safety: if set, ALL portal emails route exclusively to this address
# so real singers/section leaders are never emailed during development or staging tests.
SANDBOX_OVERRIDE_EMAIL=""

# [Config] Optional comma-separated email list to receive absence alert copies
ABSENCE_NOTIFICATION_EMAILS=""

# ------------------------------------------------------------------------------
# 4. BOX OFFICE & FUNDRAISING EMBEDS
# ------------------------------------------------------------------------------
# [Public] Base Ticket Tailor box office URL (renders interactive sandbox UI if "demo")
PUBLIC_TICKET_TAILOR_BOX_OFFICE_URL="https://www.tickettailor.com/events/demo"

# [Public] Little Green Light (LGL) online donation form URL (supports Stripe Enhanced Checkout & Apple Pay)
PUBLIC_LGL_FORM_URL="https://secure.lglforms.com/form_engine/s/BM1h-KN91G0MJHiPSzPbsA"

# [Secret] Optional webhook secret for inbound `singers@kantorei.net` email bot (`/api/webhooks/incoming-email`)
EMAIL_BOT_WEBHOOK_SECRET="DEMO"


---
import '../styles/global.css';
import Navbar from '../components/public/Navbar.astro';
import Footer from '../components/public/Footer.astro';
import { getPortalConfig } from '../lib/google';
import {
  getSiteUrl,
  toAbsoluteUrl,
  buildMusicGroupSchema,
  DEFAULT_SEO_KEYWORDS,
} from '../lib/seo';

interface Props {
  title: string;
  description?: string;
  canonicalUrl?: string;
  ogImage?: string;
  ogType?: 'website' | 'music.musical_work' | 'article';
  keywords?: string;
  noindex?: boolean;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = 'Founded in 1988 by Axel Theimer and led by Artistic Director Adam Reinwald, Kantorei is one of the premier a cappella choral ensembles in the Twin Cities, Minnesota.',
  canonicalUrl: customCanonical,
  ogImage: customOgImage,
  ogType = 'website',
  keywords = DEFAULT_SEO_KEYWORDS,
  noindex = false,
  structuredData,
} = Astro.props;

const config = await getPortalConfig(Astro.locals);
const choirName = config.Choir_Name || 'Kantorei';
const isSignedIn = Boolean(Astro.locals.singer);
const siteUrl = getSiteUrl(Astro.locals);

// Format page title cleanly: avoid "Kantorei | Kantorei" if title already contains the choir name
const pageTitle = title.includes(choirName)
  ? title
  : `${title} | ${choirName} · Twin Cities Chamber Choir`;

// Canonical and OpenGraph Absolute URLs
const canonicalUrl = customCanonical || new URL(Astro.url.pathname, siteUrl).toString();
const resolvedOgImage = toAbsoluteUrl(
  customOgImage || config.Hero_Image_URL || '/images/kantorei-logo.webp',
  Astro.locals,
);

// Structured Data (JSON-LD) composition
const baseOrganizationSchema = buildMusicGroupSchema(config, siteUrl);
const extraSchemas = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];
const allJsonLd = [baseOrganizationSchema, ...extraSchemas];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <link rel="canonical" href={canonicalUrl} />

    {noindex ? (
      <meta name="robots" content="noindex, nofollow" />
    ) : (
      <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    )}

    <!-- Geographic & Entity Signals (Twin Cities, Minneapolis–Saint Paul, Minnesota) -->
    <meta name="geo.region" content="US-MN" />
    <meta name="geo.placename" content="Minneapolis-Saint Paul, Minnesota" />
    <meta name="geo.position" content="45.0506;-93.1818" />
    <meta name="ICBM" content="45.0506, -93.1818" />

    <!-- Favicon & PWA Icons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.png" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.webp" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0c1524" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content={choirName} />

    <!-- Open Graph & Social Sharing Cards (Requires Absolute URLs) -->
    <meta property="og:site_name" content={`${choirName} · Twin Cities Choral Ensemble`} />
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:alt" content={`${choirName} Choral Ensemble`} />
    <meta property="og:locale" content="en_US" />

    <!-- Twitter / X Cards -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />
    <meta name="twitter:image:alt" content={`${choirName} Choral Ensemble`} />

    <!-- Schema.org JSON-LD Structured Data -->
    {allJsonLd.map((schema) => (
      <script type="application/ld+json" set:html={JSON.stringify(schema)} />
    ))}

    <!-- Typography Preconnects -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600;1,700&family=Playfair+Display:ital,wght@0,400;0,600;1,400;1,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col bg-[#0B131E] text-zinc-900 antialiased selection:bg-copper-500 selection:text-white">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-copper-600 focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white focus:shadow-xl focus:ring-2 focus:ring-white focus:outline-none"
    >
      Skip to main content
    </a>
    <Navbar
      choirName={choirName}
      currentPath={Astro.url.pathname}
      isSignedIn={isSignedIn}
      facebookUrl={config.Facebook_URL}
      instagramUrl={config.Instagram_URL}
      youtubeUrl={config.YouTube_URL}
    />
    <main id="main-content" class="flex-1 bg-[#FAF7F2]">
      <slot />
    </main>
    <Footer
      choirName={choirName}
      youtubeUrl={config.YouTube_URL}
      instagramUrl={config.Instagram_URL}
      facebookUrl={config.Facebook_URL}
      taxExemptDisclaimer={config.Tax_Exempt_Disclaimer}
      contactEmail={config.Contact_Email}
      contactPhone={config.Contact_Phone}
      contactAddress={config.Contact_Address}
      newsletterCategory={config.Newsletter_Category}
      newsletterHeadline={config.Newsletter_Headline}
      newsletterDescription={config.Newsletter_Description}
      newsletterButtonText={config.Newsletter_Button_Text}
      footerAboutBlurb={config.Footer_About_Blurb}
    />
  </body>
</html>

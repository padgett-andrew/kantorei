---
import '../styles/global.css';
import PortalNav from '../components/portal/PortalNav.astro';
import DevPersonaSwitcher from '../components/portal/DevPersonaSwitcher';
import MobileBottomNav from '../components/portal/MobileBottomNav';
import { getCalendarId } from '../lib/env';
import { getPortalConfig, getRoster, getWorkspaceLinks } from '../lib/google';

interface Props {
  title: string;
}

const { title } = Astro.props;
const singer = Astro.locals.singer;

if (!singer) {
  return Astro.redirect('/login');
}

const config = await getPortalConfig(Astro.locals);
const choirName = config.Choir_Name || 'Kantorei';
const isDevPreview = Boolean(Astro.locals.isDevPreview);
const isAdmin = singer.role === 'Admin';
const workspace = getWorkspaceLinks(isAdmin, config, Astro.locals);
const calendarId = getCalendarId(Astro.locals);
const calendarUrl =
  calendarId && calendarId !== 'DEMO'
    ? `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(calendarId)}`
    : 'https://calendar.google.com/calendar/u/0/r';

let devPersonas: { email: string; label: string }[] = [];
if (isDevPreview) {
  const activeRoster = (await getRoster(Astro.locals)).filter((s) => s.active);
  const picked = [
    activeRoster.find((s) => s.role === 'Admin'),
    activeRoster.find((s) => s.role === 'Section_Leader'),
    activeRoster.find((s) => s.role === 'Singer'),
  ].filter((s): s is NonNullable<typeof s> => Boolean(s));

  const seen = new Set(picked.map((p) => p.email));
  for (const s of activeRoster) {
    if (picked.length >= 3) break;
    if (!seen.has(s.email)) {
      picked.push(s);
      seen.add(s.email);
    }
  }

  devPersonas = picked.map((s) => ({
    email: s.email,
    label: `${s.name} (${s.voicePart} · ${s.role.replace('_', ' ')})`,
  }));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.png" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.webp" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Kantorei" />
    <title>{title} — {choirName} Singer Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col justify-between bg-[#FAF7F2] text-stone-900 antialiased selection:bg-copper-500 selection:text-white">
    <a
      href="#portal-main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-lg focus:bg-copper-600 focus:px-4 focus:py-2.5 focus:text-sm focus:font-semibold focus:text-white focus:shadow-xl"
    >
      Skip to main content
    </a>
    <div>
      {isDevPreview && (
        <DevPersonaSwitcher client:load currentSinger={singer} personas={devPersonas} />
      )}
      <PortalNav
        singer={singer}
        choirName={choirName}
        currentPath={Astro.url.pathname}
        masterSheetUrl={workspace.masterSheetUrl}
        repertoireDriveUrl={workspace.repertoireDriveUrl}
        calendarUrl={calendarUrl}
        isSheetAdmin={isAdmin}
      />
      <main id="portal-main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-7 sm:px-6 sm:py-10 pb-24 sm:pb-10">
        <slot />
      </main>
    </div>

    <footer class="border-t border-stone-200/80 bg-[#FAF7F2] py-6 text-xs text-stone-500 pb-[calc(5.5rem+env(safe-area-inset-bottom,0px))] sm:pb-6">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-3 px-4 sm:flex-row sm:px-6">
        <div class="flex flex-wrap items-center justify-center gap-2 text-center sm:text-left">
          <span class="font-editorial text-base font-semibold text-navy-950">{choirName} Singer Portal</span>
          <span class="text-stone-300">·</span>
          <span>Google Workspace Connected</span>
          <span class="text-stone-300">·</span>
          <span
            class:list={[
              'px-2 py-0.5 text-xs font-semibold uppercase tracking-wider',
              isAdmin ? 'bg-emerald-100 text-emerald-900' : 'bg-stone-100 text-stone-700',
            ]}
          >
            {isAdmin ? 'Admin Edit Access' : 'Singer View Access'}
          </span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="/"
            class="inline-flex items-center gap-1 border-b border-transparent font-medium text-stone-600 transition hover:border-copper-500 hover:text-navy-950"
            title="Return to Kantorei Public Website"
          >
            <span>← Public Website</span>
          </a>
          {isAdmin && (
            <a
              href={workspace.masterSheetUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 font-medium text-stone-600 transition hover:text-navy-950"
              title="Open Master Google Sheet with Edit Access"
            >
              <span>📊 Master Google Sheet (Edit)</span>
              <span class="text-stone-400">↗</span>
            </a>
          )}
        </div>
      </div>
    </footer>

    <MobileBottomNav
      client:load
      currentPath={Astro.url.pathname}
      singer={singer}
      isAdmin={singer.role === 'Admin' || singer.role === 'Section_Leader'}
      singerName={singer.name}
      voicePart={singer.voicePart}
      masterSheetUrl={workspace.masterSheetUrl}
      repertoireDriveUrl={workspace.repertoireDriveUrl}
      isSheetAdmin={isAdmin}
      calendarUrl={calendarUrl}
    />
  </body>
</html>

---
import '../styles/global.css';
import PortalNav from '../components/portal/PortalNav.astro';
import DevPersonaSwitcher from '../components/portal/DevPersonaSwitcher';
import MobileBottomNav from '../components/portal/MobileBottomNav';
import { getCalendarId } from '../lib/env';
import { getPortalConfig, getRoster, getWorkspaceLinks } from '../lib/google';

interface Props {
  title: string;
}

const { title } = Astro.props;
const singer = Astro.locals.singer;

if (!singer) {
  return Astro.redirect('/login');
}

const config = await getPortalConfig(Astro.locals);
const choirName = config.Choir_Name || 'Kantorei';
const isDevPreview = Boolean(Astro.locals.isDevPreview);
const isAdmin = singer.role === 'Admin';
const workspace = getWorkspaceLinks(isAdmin, config, Astro.locals);
const calendarId = getCalendarId(Astro.locals);
const calendarUrl =
  calendarId && calendarId !== 'DEMO'
    ? `https://calendar.google.com/calendar/u/0/r?cid=${encodeURIComponent(calendarId)}`
    : 'https://calendar.google.com/calendar/u/0/r';

let devPersonas: { email: string; label: string }[] = [];
if (isDevPreview) {
  const activeRoster = (await getRoster(Astro.locals)).filter((s) => s.active);
  const picked = [
    activeRoster.find((s) => s.role === 'Admin'),
    activeRoster.find((s) => s.role === 'Section_Leader'),
    activeRoster.find((s) => s.role === 'Singer'),
  ].filter((s): s is NonNullable<typeof s> => Boolean(s));

  const seen = new Set(picked.map((p) => p.email));
  for (const s of activeRoster) {
    if (picked.length >= 3) break;
    if (!seen.has(s.email)) {
      picked.push(s);
      seen.add(s.email);
    }
  }

  devPersonas = picked.map((s) => ({
    email: s.email,
    label: `${s.name} (${s.voicePart} · ${s.role.replace('_', ' ')})`,
  }));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.png" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.webp" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#FAF7F2" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Kantorei" />
    <title>{title} — {choirName} Singer Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;0,700;1,400;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="flex min-h-screen flex-col justify-between bg-[#FAF7F2] text-stone-900 antialiased selection:bg-copper-500 selection:text-white">
    <a
      href="#portal-main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-100 focus:rounded-sm focus:bg-navy-950 focus:px-4 focus:py-2.5 focus:text-xs focus:font-semibold focus:uppercase focus:tracking-widest focus:text-white focus:shadow-xl"
    >
      Skip to main content
    </a>
    <div>
      {isDevPreview && (
        <DevPersonaSwitcher client:load currentSinger={singer} personas={devPersonas} />
      )}
      <PortalNav
        singer={singer}
        choirName={choirName}
        currentPath={Astro.url.pathname}
        masterSheetUrl={workspace.masterSheetUrl}
        repertoireDriveUrl={workspace.repertoireDriveUrl}
        calendarUrl={calendarUrl}
        isSheetAdmin={isAdmin}
      />
      <main id="portal-main" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8 sm:px-8 sm:py-12 pb-28 xl:pb-16">
        <slot />
      </main>
    </div>

    <footer class="border-t border-stone-200/90 bg-[#FAF7F2] py-8 text-xs text-stone-500 pb-[calc(5.75rem+env(safe-area-inset-bottom,0px))] xl:pb-8">
      <div class="mx-auto flex max-w-6xl flex-col items-center justify-between gap-4 px-4 sm:flex-row sm:px-8">
        <div class="flex flex-wrap items-baseline justify-center gap-2.5 text-center sm:text-left">
          <span class="font-editorial text-lg font-medium tracking-tight text-navy-950">{choirName}</span>
          <span class="text-stone-300" aria-hidden="true">/</span>
          <span class="text-[11px] font-medium uppercase tracking-[0.18em] text-stone-500">
            Ensemble Member Portal
          </span>
        </div>

        <div class="flex flex-wrap items-center justify-center gap-5 text-[11px] font-medium uppercase tracking-[0.14em]">
          <a
            href="/portal/handbook"
            class="text-stone-500 transition hover:text-navy-950"
          >
            Handbook &amp; Bylaws
          </a>
          <span class="text-stone-300" aria-hidden="true">·</span>
          <a
            href="/"
            class="text-stone-500 transition hover:text-copper-600"
            title="Return to Kantorei Public Website"
          >
            Public Website ↗
          </a>
          {isAdmin && (
            <>
              <span class="text-stone-300" aria-hidden="true">·</span>
              <a
                href={workspace.masterSheetUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-stone-500 transition hover:text-copper-600"
                title="Open Master Google Sheet"
              >
                Master Sheet ↗
              </a>
            </>
          )}
        </div>
      </div>
    </footer>

    <MobileBottomNav
      client:load
      currentPath={Astro.url.pathname}
      singer={singer}
      isAdmin={singer.role === 'Admin' || singer.role === 'Section_Leader'}
      singerName={singer.name}
      voicePart={singer.voicePart}
      masterSheetUrl={workspace.masterSheetUrl}
      repertoireDriveUrl={workspace.repertoireDriveUrl}
      isSheetAdmin={isAdmin}
      calendarUrl={calendarUrl}
    />
  </body>
</html>

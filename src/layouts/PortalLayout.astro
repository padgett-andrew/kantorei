---
import '../styles/global.css';
import PortalNav from '../components/portal/PortalNav.astro';
import DevPersonaSwitcher from '../components/portal/DevPersonaSwitcher';
import MobileBottomNav from '../components/portal/MobileBottomNav';
import { getPortalConfig, getRoster } from '../lib/google';

interface Props {
  title: string;
}

const { title } = Astro.props;
const singer = Astro.locals.singer;

if (!singer) {
  return Astro.redirect('/login');
}

const config = await getPortalConfig(Astro.locals);
const choirName = config.Choir_Name || 'Kantorei';
const isDevPreview = Boolean(Astro.locals.isDevPreview);

let devPersonas: { email: string; label: string }[] = [];
if (isDevPreview) {
  const activeRoster = (await getRoster(Astro.locals)).filter((s) => s.active);
  const picked = [
    activeRoster.find((s) => s.role === 'Admin'),
    activeRoster.find((s) => s.role === 'Section_Leader'),
    activeRoster.find((s) => s.role === 'Singer'),
  ].filter((s): s is NonNullable<typeof s> => Boolean(s));

  const seen = new Set(picked.map((p) => p.email));
  for (const s of activeRoster) {
    if (picked.length >= 3) break;
    if (!seen.has(s.email)) {
      picked.push(s);
      seen.add(s.email);
    }
  }

  devPersonas = picked.map((s) => ({
    email: s.email,
    label: `${s.name} (${s.voicePart} · ${s.role.replace('_', ' ')})`,
  }));
}
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/images/kantorei-logo-transparent.webp" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#0c1524" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
    <meta name="apple-mobile-web-app-title" content="Kantorei" />
    <title>{title} — {choirName} Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,600;0,700;1,500&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class="min-h-screen bg-ivory-50/60 text-zinc-900 antialiased">
    {isDevPreview && (
      <DevPersonaSwitcher client:load currentSinger={singer} personas={devPersonas} />
    )}
    <PortalNav singer={singer} choirName={choirName} currentPath={Astro.url.pathname} />
    <main class="mx-auto max-w-6xl px-4 py-6 sm:px-6 sm:py-8 pb-24 sm:pb-8">
      <slot />
    </main>
    <MobileBottomNav
      client:load
      currentPath={Astro.url.pathname}
      isAdmin={singer.role === 'Admin' || singer.role === 'Section_Leader'}
      singerName={singer.name}
      voicePart={singer.voicePart}
    />
  </body>
</html>


---
import PublicLayout from "../layouts/PublicLayout.astro";
import ConcertArtwork from "../components/public/ConcertArtwork.astro";
import TicketTailorEmbed from "../components/public/TicketTailorEmbed";
import NewsletterForm from "../components/public/NewsletterForm";
import { getEnv } from "../lib/env";
import { getConcerts, getPortalConfig } from "../lib/google";
import { resolveTicketTailorEntries } from "../lib/tickettailor";

const [config, allConcerts] = await Promise.all([
  getPortalConfig(Astro.locals),
  getConcerts(Astro.locals),
]);

const boxOfficeBaseUrl =
  getEnv("PUBLIC_TICKET_TAILOR_BOX_OFFICE_URL", Astro.locals) ||
  "https://www.tickettailor.com/events/demo";

const isAdmin = Astro.locals.singer?.role === "Admin";

const activeConcerts = await Promise.all(
  allConcerts
    .filter((c) => c.status === "On_Sale" || c.status === "Upcoming")
    .map(async (c) => {
      const defaultLabels =
        c.performances && c.performances.length > 0
          ? c.performances.map((p) => p.label || p.dateDisplay)
          : c.datesDisplay.includes("&")
            ? c.datesDisplay.split("&").map((s) => s.trim())
            : [c.datesDisplay];
      const resolvedEntries = await resolveTicketTailorEntries(
        c.ttEventSeriesId,
        boxOfficeBaseUrl,
        defaultLabels,
      );
      return { ...c, resolvedEntries };
    }),
);

const pastConcerts = allConcerts.filter((c) => c.status === "Past");

// Unpublished draft concerts: kept hidden from the public, visible only to logged-in admins
const draftConcerts = isAdmin
  ? await Promise.all(
      allConcerts
        .filter((c) => c.status === "Draft")
        .map(async (c) => {
          const defaultLabels =
            c.performances && c.performances.length > 0
              ? c.performances.map((p) => p.label || p.dateDisplay)
              : c.datesDisplay.includes("&")
                ? c.datesDisplay.split("&").map((s) => s.trim())
                : [c.datesDisplay];
          const resolvedEntries = await resolveTicketTailorEntries(
            c.ttEventSeriesId,
            boxOfficeBaseUrl,
            defaultLabels,
          );
          return { ...c, resolvedEntries };
        }),
    )
  : [];
---

<PublicLayout
  title="Concerts & Tickets"
  description="Upcoming concerts and ticket box office for Kantorei choral ensemble performances in Minnesota."
>
  <!-- Concerts Editorial Hero -->
  <section
    class="relative overflow-hidden bg-[#0B131E] pt-28 pb-14 text-ivory-50 sm:pt-36 sm:pb-20"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    >
    </div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      <span
        class="text-xs sm:text-sm font-semibold uppercase tracking-[0.2em] text-gold-300"
      >
        2026–2027 Season &bull; Box Office & Tickets
      </span>
      <h1
        class="mt-2.5 font-editorial text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.08]"
      >
        Upcoming Concerts
      </h1>
      <p
        class="mt-3.5 max-w-2xl text-base sm:text-lg leading-relaxed text-[#E6E1DA]"
      >
        Experience luminous a cappella chamber singing live in Twin Cities
        sanctuaries and premier acoustic halls.
      </p>
    </div>
  </section>

  <!-- Concerts List on Warm Alabaster -->
  <section class="mx-auto max-w-6xl px-3.5 sm:px-6 py-8 sm:py-16">
    {isAdmin && draftConcerts.length > 0 && (
      <aside
        aria-label="Admin Draft Preview"
        class="mb-12 rounded-2xl border-2 border-dashed border-amber-300 bg-amber-50/70 p-5 sm:p-7 shadow-xs"
      >
        <div class="flex flex-wrap items-center justify-between gap-3 border-b border-amber-200/80 pb-4">
          <div class="flex items-center gap-2.5">
            <span class="inline-flex items-center rounded-md bg-amber-200 px-2.5 py-1 text-xs font-bold uppercase tracking-wider text-amber-950">
              Admin Preview
            </span>
            <h2 class="text-base sm:text-lg font-bold text-amber-950">
              Unpublished Concert Draft{draftConcerts.length > 1 ? 's' : ''} ({draftConcerts.length})
            </h2>
          </div>
          <p class="text-xs font-medium text-amber-800">
            Visible only to logged-in Admins. To publish publicly, set Status to <code class="rounded bg-amber-100 px-1 py-0.5 font-bold">Upcoming</code> or <code class="rounded bg-amber-100 px-1 py-0.5 font-bold">On_Sale</code> in the Master Sheet.
          </p>
        </div>

        <div class="mt-6 space-y-6">
          {draftConcerts.map((concert) => (
            <article class="rounded-xl border border-amber-200 bg-white p-5 sm:p-7 shadow-xs">
              <div class="grid gap-6 lg:grid-cols-12 lg:items-start">
                <div class="lg:col-span-5">
                  {(concert.heroImageUrl || concert.posterImageUrl) && (
                    <div class="mb-4">
                      <ConcertArtwork
                        heroImageUrl={concert.heroImageUrl}
                        posterImageUrl={concert.posterImageUrl}
                        title={concert.title}
                      />
                    </div>
                  )}
                  <span class="inline-flex items-center rounded-full bg-amber-100 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-amber-800">
                    Draft &bull; Unpublished
                  </span>
                  <h3 class="mt-2 font-editorial text-2xl font-bold text-navy-950 sm:text-3xl">
                    {concert.title}
                  </h3>
                  <p class="mt-2 text-sm text-stone-600">
                    <strong>Dates:</strong> {concert.datesDisplay}
                  </p>
                  <p class="mt-1 text-sm text-stone-600">
                    <strong>Venue:</strong> {concert.venueName}
                  </p>
                  <p class="mt-3 text-sm leading-relaxed text-stone-700">
                    {concert.description}
                  </p>
                </div>
                <div class="lg:col-span-7">
                  <TicketTailorEmbed
                    client:load
                    mode="concert"
                    resolvedEntries={concert.resolvedEntries}
                    concertTitle={concert.title}
                    datesDisplay={concert.datesDisplay}
                    venueName={concert.venueName}
                    venueAddress={concert.venueAddress}
                    boxOfficeNote={concert.boxOfficeNote}
                    performances={concert.performances}
                    concertDescription={concert.description}
                  />
                </div>
              </div>
            </article>
          ))}
        </div>
      </aside>
    )}

    {activeConcerts.length > 0 ? (
      <div class="space-y-8 sm:space-y-12">
        {activeConcerts.map((concert) => (
          <article
            id={concert.slug}
            class="scroll-mt-24 rounded-2xl border border-stone-200/80 bg-white shadow-sm relative z-10 overflow-hidden"
          >
            <div class="grid gap-6 sm:gap-8 p-4 sm:p-7 lg:p-9 lg:grid-cols-12 lg:items-start">
              <div class="lg:col-span-5">
                {(concert.heroImageUrl || concert.posterImageUrl) && (
                  <div class="mb-5 sm:mb-6">
                    <ConcertArtwork
                      heroImageUrl={concert.heroImageUrl}
                      posterImageUrl={concert.posterImageUrl}
                      title={concert.title}
                    />
                  </div>
                )}

                <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-copper-600">
                  {concert.status === "On_Sale"
                    ? "Tickets Available"
                    : "Upcoming Program"}
                </p>

                <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl leading-tight">
                  {concert.title}
                </h2>

                <p class="mt-4 text-base sm:text-lg leading-relaxed text-stone-700">
                  {concert.description}
                </p>
              </div>

              <div class="lg:col-span-7">
                <TicketTailorEmbed
                  client:load
                  mode="concert"
                  resolvedEntries={concert.resolvedEntries}
                  concertTitle={concert.title}
                  datesDisplay={concert.datesDisplay}
                  venueName={concert.venueName}
                  venueAddress={concert.venueAddress}
                  boxOfficeNote={concert.boxOfficeNote}
                  performances={concert.performances}
                  concertDescription={concert.description}
                />
              </div>
            </div>
          </article>
        ))}
      </div>
    ) : (
      <div class="rounded-2xl border border-stone-200/90 bg-white p-7 sm:p-10 shadow-xs">
        <span class="text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-copper-600">
          Season Updates
        </span>
        <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
          {config.No_Concerts_Title || 'No Upcoming Concerts'}
        </h2>
        <p class="mt-3 text-base sm:text-lg leading-relaxed text-stone-700 max-w-2xl">
          {config.No_Concerts_Blurb ||
            "We don't have any upcoming concerts scheduled at this time. Join our email list below to be notified as soon as new concert dates, programs, and tickets are announced."}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-4">
          <a
            href="/media"
            class="inline-flex items-center justify-center rounded-sm bg-copper-500 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition hover:bg-copper-600"
          >
            Listen to Recordings &rarr;
          </a>
          <a
            href="/support"
            class="inline-flex items-center justify-center rounded-sm border border-stone-300 bg-stone-50 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-navy-950 transition hover:bg-stone-100"
          >
            Support Kantorei
          </a>
          <a
            href="/auditions"
            class="text-xs sm:text-sm font-medium uppercase tracking-[0.14em] text-stone-600 underline decoration-stone-300 underline-offset-4 hover:text-navy-950 hover:decoration-copper-500 transition-colors"
          >
            Audition Information &rarr;
          </a>
        </div>
      </div>
    )}

    <!-- Stay in Tune / Early Access Callout -->
    <div class="mt-14 sm:mt-16">
      <NewsletterForm
        client:visible
        variant="card"
        source="Concerts_Page"
        title={config.Concerts_Newsletter_Title ||
          config.Newsletter_Headline ||
          "Never Miss a Concert Announcement"}
        description={config.Concerts_Newsletter_Description ||
          config.Newsletter_Description ||
          "Be the first to hear about upcoming season programs, early-access ticket sales, and guest artist appearances across the Twin Cities."}
        buttonText={config.Newsletter_Button_Text || "Get Early Concert Access"}
      />
    </div>

    {
      pastConcerts.length > 0 && (
        <div class="mt-16">
          <h3 class="font-editorial text-2xl font-bold text-stone-700">
            Past Programs
          </h3>
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            {pastConcerts.map((c) => (
              <div class="rounded-2xl border border-stone-200 bg-white p-5">
                <p class="font-editorial text-xl font-bold text-navy-950">
                  {c.title}
                </p>
                <p class="mt-1 text-sm font-medium text-stone-600">
                  {c.datesDisplay} · {c.venueName}
                </p>
              </div>
            ))}
          </div>
        </div>
      )
    }
  </section>
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import TicketTailorEmbed from '../components/public/TicketTailorEmbed';
import LocationDirectionsButton from '../components/common/LocationDirectionsButton';
import AddToCalendarButton from '../components/common/AddToCalendarButton';
import NewsletterForm from '../components/public/NewsletterForm';
import { buildCleanLocationQuery } from '../lib/maps';
import { getEnv } from '../lib/env';
import { getConcerts } from '../lib/google';
import { resolveTicketTailorEntries } from '../lib/tickettailor';

const allConcerts = await getConcerts(Astro.locals);

const boxOfficeBaseUrl =
  getEnv('PUBLIC_TICKET_TAILOR_BOX_OFFICE_URL', Astro.locals) ||
  'https://www.tickettailor.com/events/demo';

const activeConcerts = await Promise.all(
  allConcerts
    .filter((c) => c.status === 'On_Sale' || c.status === 'Upcoming')
    .map(async (c) => {
      const defaultLabels =
        c.performances && c.performances.length > 0
          ? c.performances.map((p) => p.label || p.dateDisplay)
          : c.datesDisplay.includes('&')
            ? c.datesDisplay.split('&').map((s) => s.trim())
            : [c.datesDisplay];
      const resolvedEntries = await resolveTicketTailorEntries(
        c.ttEventSeriesId,
        boxOfficeBaseUrl,
        defaultLabels
      );
      return { ...c, resolvedEntries };
    })
);
const pastConcerts = allConcerts.filter((c) => c.status === 'Past');
---

<PublicLayout title="Concerts & Tickets" description="Upcoming concerts and ticket box office for Kantorei choral ensemble performances in Minnesota.">
  <!-- Concerts Editorial Hero -->
  <section class="relative overflow-hidden bg-[#0B131E] pt-28 pb-14 text-ivory-50 sm:pt-36 sm:pb-20">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-copper-500">
        2026–2027 Season &bull; Box Office & Tickets
      </span>
      <h1 class="mt-2.5 font-editorial text-4xl sm:text-5xl lg:text-6xl font-medium text-white tracking-tight leading-[1.08]">
        Upcoming Concerts
      </h1>
      <p class="mt-3.5 max-w-2xl text-sm sm:text-base leading-relaxed text-[#E6E1DA]">
        Experience luminous a cappella chamber singing live in Twin Cities sanctuaries and premier acoustic halls.
      </p>
    </div>
  </section>

  <!-- Concerts List on Warm Alabaster -->
  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6 sm:py-16">

    <div class="space-y-12">
      {activeConcerts.map((concert) => {
        const concertImage =
          concert.heroImageUrl === '/images/advent-with-kantorei.webp'
            ? '/images/advent-lantern.jpg'
            : concert.heroImageUrl;
        return (
          <article
            id={concert.slug}
            class="scroll-mt-24 overflow-hidden rounded-xl sm:rounded-2xl border border-stone-200/80 bg-[#FAF7F2] shadow-sm"
          >
            <div class="grid gap-8 p-6 sm:p-9 lg:grid-cols-12 lg:items-start">
              <div class="lg:col-span-6">
                {concertImage && (
                  <div class="mb-6 overflow-hidden rounded-lg bg-navy-950">
                    <img
                      src={concertImage}
                      alt={concert.title}
                      class="block h-56 sm:h-72 w-full object-cover object-[15%_center] sm:object-[20%_center]"
                    />
                  </div>
                )}

                <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-500">
                  {concert.status === 'On_Sale' ? 'Tickets Available' : 'Upcoming Program'}
                </p>

                <h3 class="mt-2.5 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
                  {concert.title}
                </h3>

                {concert.performances && concert.performances.length > 1 ? (
                  <div class="mt-5 space-y-3 rounded-lg border border-stone-200/80 bg-white p-4 text-sm">
                    {concert.performances.map((perf, pIdx) => (
                      <div
                        class:list={[
                          'flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between',
                          pIdx > 0 && 'border-t border-zinc-200 pt-3',
                        ]}
                      >
                        <div>
                          <p class="font-bold text-navy-950">{perf.dateDisplay}</p>
                          <p class="text-xs text-zinc-600">{perf.venueName}</p>
                        </div>
                        <div class="flex flex-wrap items-center gap-2">
                          <LocationDirectionsButton
                            client:load
                            location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                            venueName={perf.venueName}
                            label={perf.label ? `${perf.label} Directions` : 'Directions'}
                            variant="pill"
                          />
                          <AddToCalendarButton
                            client:load
                            title={concert.title}
                            description={concert.description}
                            dateStr={perf.dateDisplay}
                            location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                            venueName={perf.venueName}
                            venueAddress={perf.venueAddress}
                            variant="pill"
                          />
                        </div>
                      </div>
                    ))}
                  </div>
                ) : (
                  <div class="mt-3 space-y-2">
                    <p class="text-sm font-semibold text-zinc-800">
                      🗓 {concert.datesDisplay}
                    </p>
                    {concert.venueName && (
                      <div class="flex flex-wrap items-center gap-2">
                        <LocationDirectionsButton
                          client:load
                          location={buildCleanLocationQuery(concert.venueName, concert.venueAddress)}
                          venueName={concert.venueName}
                          variant="pill"
                        />
                        <AddToCalendarButton
                          client:load
                          title={concert.title}
                          description={concert.description}
                          dateStr={concert.datesDisplay}
                          location={buildCleanLocationQuery(concert.venueName, concert.venueAddress)}
                          venueName={concert.venueName}
                          venueAddress={concert.venueAddress}
                          variant="pill"
                        />
                      </div>
                    )}
                  </div>
                )}

                <p class="mt-5 text-sm leading-relaxed text-zinc-600 sm:text-base">
                  {concert.description}
                </p>
              </div>

              <div class="lg:col-span-6">
                <TicketTailorEmbed
                  client:visible
                  mode="concert"
                  resolvedEntries={concert.resolvedEntries}
                  concertTitle={concert.title}
                  datesDisplay={concert.datesDisplay}
                  venueName={concert.venueName}
                  boxOfficeNote={concert.boxOfficeNote}
                />
              </div>
            </div>
          </article>
        );
      })}
    </div>

    <!-- Stay in Tune / Early Access Callout -->
    <div class="mt-14 sm:mt-16">
      <NewsletterForm
        client:visible
        variant="card"
        source="Concerts_Page"
        title="Never Miss a Concert Announcement"
        description="Be the first to hear about upcoming season programs, early-access ticket sales, and guest artist appearances across the Twin Cities."
        buttonText="Get Early Concert Access"
      />
    </div>

    {pastConcerts.length > 0 && (
      <div class="mt-16">
        <h3 class="font-editorial text-2xl font-bold text-zinc-500">Past Programs</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {pastConcerts.map((c) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
              <p class="font-editorial text-xl font-bold text-zinc-800">{c.title}</p>
              <p class="text-xs text-zinc-500">{c.datesDisplay} · {c.venueName}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import TicketTailorEmbed from '../components/public/TicketTailorEmbed';
import { getEnv } from '../lib/env';
import { getConcerts, getPortalConfig } from '../lib/google';

const [config, allConcerts] = await Promise.all([
  getPortalConfig(Astro.locals),
  getConcerts(Astro.locals),
]);

const boxOfficeBaseUrl =
  getEnv('PUBLIC_TICKET_TAILOR_BOX_OFFICE_URL', Astro.locals) ||
  'https://www.tickettailor.com/events/demo';

const activeConcerts = allConcerts.filter(
  (c) => c.status === 'On_Sale' || c.status === 'Upcoming'
);
const pastConcerts = allConcerts.filter((c) => c.status === 'Past');
---

<PublicLayout title="Concerts & Flex Season Pass">
  <!-- Top Section: Season Pass (Buy Now, Pick Your Dates Later) -->
  <section class="bg-navy-950 py-16 text-ivory-50 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-6">
          <span class="inline-block rounded-full border border-gold-400/40 bg-gold-500/15 px-3.5 py-1 text-xs font-semibold uppercase tracking-[0.18em] text-gold-300">
            Flex Season Pass · Priority Seating
          </span>
          <h1 class="mt-4 font-editorial text-4xl font-bold text-white sm:text-5xl">
            Season Pass: Buy Now, Pick Your Performance Later
          </h1>
          <p class="mt-4 text-sm leading-relaxed text-zinc-300 sm:text-base">
            Enjoy VIP reserved seating across Kantorei’s Minnesota concert season while choosing whichever performance day or Twin Cities venue fits your weekend best.
          </p>

          <!-- Clear 2-Step Visual Guide -->
          <ol class="mt-7 space-y-4">
            <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-500 font-bold text-white text-sm">
                1
              </span>
              <div>
                <h2 class="font-sans text-sm font-bold text-white">
                  Step 1: Purchase Your Season Pass
                </h2>
                <p class="mt-1 text-xs leading-relaxed text-zinc-300">
                  Receive your personal <strong>Pass Code</strong> immediately by email—valid for 1 VIP admission per concert cycle plus pass-holder perks.
                </p>
              </div>
            </li>

            <li class="flex gap-4 rounded-2xl border border-white/10 bg-white/5 p-4">
              <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-gold-500 font-bold text-white text-sm">
                2
              </span>
              <div>
                <h2 class="font-sans text-sm font-bold text-white">
                  Step 2: Reserve Your Performance Day & Venue Anytime
                </h2>
                <p class="mt-1 text-xs leading-relaxed text-zinc-300">
                  When you know whether you plan to attend Saturday (e.g., Shoreview) or Sunday (e.g., Edina), select that concert below and enter your Pass Code to unlock your <strong>$0.00 Season Pass VIP Ticket</strong> from that performance’s capacity.
                </p>
              </div>
            </li>
          </ol>
        </div>

        <div class="lg:col-span-6">
          <TicketTailorEmbed
            client:load
            mode="season-pass"
            widgetUrl={config.Season_Pass_TT_Widget_URL}
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Individual Concert Cards -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-10">
      <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
        Single Tickets & Pass Reservations
      </span>
      <h2 class="mt-1 font-editorial text-4xl font-bold text-navy-950">
        Upcoming Concerts
      </h2>
    </div>

    <div class="space-y-10">
      {activeConcerts.map((concert) => {
        const mapsUrl = `https://www.google.com/maps/search/?api=1&query=${encodeURIComponent(
          `${concert.venueName} ${concert.venueAddress}`
        )}`;
        const isAdvent = concert.slug === 'advent-with-kantorei';

        return (
          <article
            id={concert.slug}
            class="scroll-mt-24 overflow-hidden rounded-3xl border border-zinc-200 bg-white shadow-sm"
          >
            {concert.heroImageUrl && (
              <div class="max-h-96 w-full overflow-hidden bg-navy-950">
                <img
                  src={concert.heroImageUrl}
                  alt={concert.title}
                  class="h-full max-h-96 w-full object-cover"
                />
              </div>
            )}

            <div class="grid gap-8 p-6 sm:p-9 lg:grid-cols-12">
              <div class="lg:col-span-6">
                <div class="flex flex-wrap items-center gap-2">
                  <span
                    class:list={[
                      'rounded-full px-3 py-0.5 text-xs font-bold uppercase tracking-wider',
                      concert.status === 'On_Sale'
                        ? 'bg-emerald-100 text-emerald-900'
                        : 'bg-amber-100 text-amber-900',
                    ]}
                  >
                    {concert.status === 'On_Sale' ? 'Tickets Available' : 'Upcoming Program'}
                  </span>
                </div>

                <h3 class="mt-3 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
                  {concert.title}
                </h3>

                {isAdvent ? (
                  <div class="mt-4 space-y-3 rounded-2xl border border-zinc-200 bg-ivory-50 p-4 text-sm">
                    <div>
                      <p class="font-bold text-navy-950">Saturday, December 19 · 3:00 PM</p>
                      <a
                        href="https://www.google.com/maps/search/?api=1&query=Shepherd+of+the+Hills+Lutheran+Church+Shoreview+MN"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-medium text-gold-500 underline underline-offset-3 hover:text-navy-950"
                      >
                        📍 Shepherd of the Hills Lutheran Church, Shoreview ↗
                      </a>
                    </div>
                    <div class="border-t border-zinc-200 pt-3">
                      <p class="font-bold text-navy-950">Sunday, December 20 · 3:00 PM</p>
                      <a
                        href="https://www.google.com/maps/search/?api=1&query=Lutheran+Church+of+the+Good+Shepherd+Edina+MN"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="text-xs font-medium text-gold-500 underline underline-offset-3 hover:text-navy-950"
                      >
                        📍 Lutheran Church of the Good Shepherd, Edina ↗
                      </a>
                    </div>
                  </div>
                ) : (
                  <>
                    <p class="mt-2 text-sm font-semibold text-zinc-800">
                      🗓 {concert.datesDisplay}
                    </p>
                    <p class="mt-1 text-sm text-zinc-600">
                      📍 {concert.venueName} —{' '}
                      <a
                        href={mapsUrl}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="font-medium text-gold-500 underline underline-offset-4"
                      >
                        {concert.venueAddress} ↗
                      </a>
                    </p>
                  </>
                )}

                <p class="mt-5 text-sm leading-relaxed text-zinc-600 sm:text-base">
                  {concert.description}
                </p>
              </div>

              <div class="lg:col-span-6">
                <TicketTailorEmbed
                  client:visible
                  mode="concert"
                  boxOfficeBaseUrl={boxOfficeBaseUrl}
                  ttEventSeriesId={concert.ttEventSeriesId}
                  concertTitle={concert.title}
                  datesDisplay={concert.datesDisplay}
                />
              </div>
            </div>
          </article>
        );
      })}
    </div>

    {pastConcerts.length > 0 && (
      <div class="mt-16">
        <h3 class="font-editorial text-2xl font-bold text-zinc-500">Past Programs</h3>
        <div class="mt-4 grid gap-4 sm:grid-cols-2">
          {pastConcerts.map((c) => (
            <div class="rounded-2xl border border-zinc-200 bg-zinc-50 p-5">
              <p class="font-editorial text-xl font-bold text-zinc-800">{c.title}</p>
              <p class="text-xs text-zinc-500">{c.datesDisplay} · {c.venueName}</p>
            </div>
          ))}
        </div>
      </div>
    )}
  </section>
</PublicLayout>

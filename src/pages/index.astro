---
import PublicLayout from "../layouts/PublicLayout.astro";
import NewsletterForm from "../components/public/NewsletterForm";
import HomeHero from "../components/home/HomeHero.astro";
import HomeSpotlight from "../components/home/HomeSpotlight.astro";
import HomeIdentity from "../components/home/HomeIdentity.astro";
import HomeInstagramFeed from "../components/home/HomeInstagramFeed.astro";
import HomeFeaturedMedia from "../components/home/HomeFeaturedMedia.astro";
import HomeAuditionsCallout from "../components/home/HomeAuditionsCallout.astro";
import { getConcerts, getMedia, getPortalConfig } from "../lib/google";
import { extractYouTubeEmbedUrl, getInstagramShowcase } from "../lib/media";
import { getTodayIso } from "../lib/utils";
import { detectProviderFromUrl } from "../lib/tickettailor";
import {
  getSiteUrl,
  buildWebSiteSchema,
  buildConcertEventSchemas,
} from "../lib/seo";

const [config, concerts, media] = await Promise.all([
  getPortalConfig(Astro.locals),
  getConcerts(Astro.locals),
  getMedia(Astro.locals),
]);

const instagramShowcase = await getInstagramShowcase(config);
const featuredInstagram = instagramShowcase.posts.slice(0, 3);
const choirName = config.Choir_Name || "Kantorei";
const activeConcerts = concerts.filter(
  (c) => c.status === "On_Sale" || c.status === "Upcoming",
);

// Home Spotlight resolution
const requestedSpotlightType = (
  config.Home_Spotlight_Type ||
  config.Spotlight_Type ||
  ""
)
  .trim()
  .toLowerCase();
const requestedMediaId = (
  config.Home_Spotlight_Media_ID ||
  config.Spotlight_Media_ID ||
  ""
).trim();

let spotlightMode: "concert" | "recording" | "friends" = "friends";
let spotlightConcert: (typeof concerts)[0] | null = null;
let spotlightMedia: (typeof media)[0] | null = null;

if (
  requestedSpotlightType === "recording" ||
  requestedSpotlightType === "media" ||
  requestedMediaId
) {
  spotlightMedia =
    (requestedMediaId ? media.find((m) => m.id === requestedMediaId) : null) ||
    media[0] ||
    null;
  if (spotlightMedia) {
    spotlightMode = "recording";
  } else if (activeConcerts.length > 0) {
    spotlightMode = "concert";
    spotlightConcert = activeConcerts[0];
  } else {
    spotlightMode = "friends";
  }
} else if (
  requestedSpotlightType === "friends" ||
  requestedSpotlightType === "newsletter"
) {
  spotlightMode = "friends";
} else if (requestedSpotlightType === "concert") {
  if (activeConcerts.length > 0) {
    spotlightMode = "concert";
    spotlightConcert = activeConcerts[0];
  } else {
    spotlightMode = "friends";
  }
} else {
  if (activeConcerts.length > 0) {
    spotlightMode = "concert";
    spotlightConcert = activeConcerts[0];
  } else {
    spotlightMode = "friends";
  }
}

// Dynamic Spotlight Concert Metadata & Eyebrow
let spotlightEyebrow = "Next Performance";
let spotlightActionLabel = "Reserve Tickets →";

if (spotlightConcert) {
  const isFreeAdmission =
    /free|goodwill|open seating|admission/i.test(
      spotlightConcert.ttEventSeriesId || "",
    ) || /free/i.test(spotlightConcert.datesDisplay || "");

  const isExternalBoxOffice =
    /^https?:\/\//i.test(spotlightConcert.ttEventSeriesId || "") &&
    !spotlightConcert.ttEventSeriesId.includes("tickettailor.com");

  const externalProvider = isExternalBoxOffice
    ? detectProviderFromUrl(spotlightConcert.ttEventSeriesId)
    : null;

  const today = getTodayIso("America/Chicago");

  const upcomingPerfs = spotlightConcert.performances?.filter((p) => {
    if (!p.isoDate) return true;
    return p.isoDate >= today;
  });
  const nextPerf =
    (upcomingPerfs && upcomingPerfs.length > 0
      ? upcomingPerfs[0]
      : spotlightConcert.performances?.[0]) || null;

  let daysAway: number | null = null;
  if (nextPerf?.isoDate) {
    const diffMs =
      new Date(nextPerf.isoDate + "T12:00:00").getTime() -
      new Date(today + "T12:00:00").getTime();
    daysAway = Math.round(diffMs / 86400000);
  }

  let eyebrowPrefix = "Next Performance";
  let eyebrowContext = "2026–2027 Season";

  if (daysAway !== null && daysAway >= 0 && daysAway <= 7) {
    eyebrowPrefix =
      daysAway === 0
        ? "Live Today"
        : daysAway === 1
          ? "Tomorrow"
          : "This Weekend";
  } else if (isExternalBoxOffice && externalProvider) {
    eyebrowPrefix = "Guest Appearance";
    eyebrowContext = `With ${externalProvider}`;
  } else if (isFreeAdmission) {
    eyebrowPrefix = "Community Concert";
    eyebrowContext = "Free Admission";
  }

  spotlightEyebrow = eyebrowContext
    ? `${eyebrowPrefix} • ${eyebrowContext}`
    : eyebrowPrefix;

  spotlightActionLabel = isFreeAdmission
    ? "Event Details & Schedule →"
    : isExternalBoxOffice && externalProvider
      ? `Tickets via ${externalProvider} →`
      : spotlightConcert.status === "On_Sale"
        ? "Reserve Tickets →"
        : "Concert Details →";
}

const spotlightVideoEmbed = spotlightMedia
  ? extractYouTubeEmbedUrl(spotlightMedia.youtubeUrl)
  : null;
const featuredMedia = media.slice(0, 3);

const heroTagline =
  config.Hero_Tagline || "Sing, Laugh, Cry. Be Real…Together.";
const heroSubtitle =
  config.Hero_Subtitle ||
  `${choirName} is an a cappella chamber choir based in the Minnesota Twin Cities. Fascinatingly remarkable artistic expression, inviting deep meaning and belonging.`;
const missionStatement =
  config.Mission_Statement ||
  "Expanding the worldview of artists and audiences through passionate and crafted artistic performances, partnerships, and projects.";
const visionStatement =
  config.Vision_Statement ||
  "Fascinatingly remarkable artistic expression, inviting deep meaning and belonging.";

const heroVideoRaw = (
  config.Hero_Video_URL || "https://www.youtube.com/watch?v=GIvF19VzNPE"
).trim();
const heroVideo = heroVideoRaw ? extractYouTubeEmbedUrl(heroVideoRaw) : null;
const heroBgImage = config.Hero_Image_URL || "";
const siteUrl = getSiteUrl(Astro.locals);
const webSiteSchema = buildWebSiteSchema(siteUrl, choirName);
const spotlightSchemas = spotlightConcert
  ? buildConcertEventSchemas([spotlightConcert], siteUrl, config)
  : [];
const homeStructuredData = [webSiteSchema, ...spotlightSchemas];
const homeOgImage =
  spotlightConcert?.heroImageUrl ||
  spotlightConcert?.posterImageUrl ||
  heroBgImage ||
  "/images/kantorei-logo.webp";
---

<PublicLayout
  title={`${choirName} | Premier Twin Cities A Cappella Chamber Choir · Minneapolis & St. Paul, MN`}
  description={`${choirName} is one of Minnesota's premier a cappella chamber choirs, based in Minneapolis and Saint Paul (Twin Cities). Explore upcoming choral concerts, our beloved Advent & Christmas traditions, singer auditions, and recordings.`}
  keywords="choral music twin cities, best choirs in the twin cities, chamber choir minneapolis, a cappella choir st paul, Christmas concerts twin cities, Advent with Kantorei, choir auditions twin cities, choral concerts minneapolis, kantorei minnesota, kantorei net"
  ogImage={homeOgImage}
  structuredData={homeStructuredData}
>
  <!-- Editorial Hero -->
  <HomeHero
    choirName={choirName}
    heroTagline={heroTagline}
    heroSubtitle={heroSubtitle}
    heroVideo={heroVideo}
    heroBgImage={heroBgImage}
    hasActiveConcerts={activeConcerts.length > 0}
  />

  <!-- Next Concert / Recording / Friends of Kantorei Spotlight -->
  <HomeSpotlight
    spotlightMode={spotlightMode}
    spotlightConcert={spotlightConcert}
    spotlightMedia={spotlightMedia}
    spotlightEyebrow={spotlightEyebrow}
    spotlightActionLabel={spotlightActionLabel}
    spotlightVideoEmbed={spotlightVideoEmbed}
    config={config}
  />

  <!-- Ensemble Identity & Mission -->
  <HomeIdentity
    choirName={choirName}
    visionStatement={visionStatement}
    missionStatement={missionStatement}
    aboutBlurb={config.Footer_About_Blurb ||
      `Founded in 1988 by Axel Theimer and led today by Artistic Director Adam Reinwald, ${choirName} brings together passionate artists and audiences through choral singing from around the world.`}
  />

  <!-- Instagram Feed -->
  <HomeInstagramFeed
    choirName={choirName}
    instagramShowcase={instagramShowcase}
    featuredInstagram={featuredInstagram}
  />

  <!-- Featured YouTube Recordings -->
  <HomeFeaturedMedia
    choirName={choirName}
    featuredMedia={featuredMedia}
    youtubeChannelUrl={config.YouTube_URL || "https://www.youtube.com/@kantoreiMN"}
  />

  <!-- Friends of Kantorei Patron Community Banner -->
  <section class="border-t border-zinc-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <NewsletterForm
        client:visible
        variant="banner"
        source="Home_Page"
        title={config.Home_Newsletter_Title ||
          config.Newsletter_Headline ||
          "Stay in Tune with Friends of Kantorei"}
        description={config.Home_Newsletter_Description ||
          config.Newsletter_Description ||
          "Join our circle of patrons, alumni, and choral lovers. Get first access to concert tickets, conductor Adam Reinwald’s listening guides, and unreleased choral recordings."}
        buttonText={config.Newsletter_Button_Text || "Join Friends of Kantorei"}
      />
    </div>
  </section>

  <!-- Tax-Deductible Patronage CTA -->
  <section class="border-t border-stone-200/80 bg-ivory-100/90 py-16">
    <div
      class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:px-6 md:flex-row md:items-center"
    >
      <div class="max-w-2xl">
        <span
          class="text-xs font-semibold uppercase tracking-[0.18em] text-copper-600"
        >
          501(c)(3) Nonprofit Ensemble
        </span>
        <h2
          class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl"
        >
          Help sustain {choirName}’s concerts, recordings, and community
          outreach.
        </h2>
      </div>
      <a
        href="/support"
        class="shrink-0 rounded-sm bg-copper-500 px-7 py-3.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white transition hover:bg-copper-600"
      >
        Make a Tax-Deductible Gift
      </a>
    </div>
  </section>

  <!-- Sing With Us / Auditions Callout -->
  <HomeAuditionsCallout choirName={choirName} />
</PublicLayout>

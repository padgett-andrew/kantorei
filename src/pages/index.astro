---
import PublicLayout from '../layouts/PublicLayout.astro';
import LocationDirectionsButton from '../components/common/LocationDirectionsButton';
import AddToCalendarButton from '../components/common/AddToCalendarButton';
import NewsletterForm from '../components/public/NewsletterForm';
import { buildCleanLocationQuery } from '../lib/maps';
import { getConcerts, getMedia, getPortalConfig } from '../lib/google';
import {
  extractYouTubeEmbedUrl,
  getInstagramShowcase,
} from '../lib/media';

const [config, concerts, media] = await Promise.all([
  getPortalConfig(Astro.locals),
  getConcerts(Astro.locals),
  getMedia(Astro.locals),
]);

const instagramShowcase = await getInstagramShowcase(config);
const featuredInstagram = instagramShowcase.posts.slice(0, 3);
const choirName = config.Choir_Name || 'Kantorei';
const activeConcerts = concerts.filter((c) => c.status === 'On_Sale' || c.status === 'Upcoming');
const featuredConcert = activeConcerts[0] ?? concerts[0];
const featuredMedia = media.slice(0, 3);

const heroTagline = config.Hero_Tagline || 'Sing, Laugh, Cry. Be Real…Together.';
const heroSubtitle =
  config.Hero_Subtitle ||
  `${choirName} is an a cappella chamber choir based in the Minnesota Twin Cities. Fascinatingly remarkable artistic expression, inviting deep meaning and belonging.`;
const missionStatement =
  config.Mission_Statement ||
  'Expanding the worldview of artists and audiences through passionate and crafted artistic performances, partnerships, and projects.';
const visionStatement =
  config.Vision_Statement ||
  'Fascinatingly remarkable artistic expression, inviting deep meaning and belonging.';
---

<PublicLayout title="Sing, Laugh, Cry — Twin Cities A Cappella Chamber Choir">
  <!-- Editorial Hero -->
  <section class="relative overflow-hidden bg-navy-950 text-ivory-50">
    <div
      class="pointer-events-none absolute inset-0 opacity-35"
      style="background: radial-gradient(circle at 22% 20%, #b16437 0%, transparent 46%), radial-gradient(circle at 80% 75%, #233d5c 0%, transparent 52%);"
    ></div>

    <div class="relative mx-auto max-w-6xl px-4 py-8 sm:px-6 sm:py-10 md:py-12 lg:pb-16 lg:pt-10">
      <div class="max-w-3xl">
        <h1 class="font-editorial text-3xl font-bold leading-[1.12] tracking-tight text-white sm:text-5xl lg:text-6xl">
          {heroTagline.includes('Be Real') ? (
            <>
              Sing, Laugh, Cry. <br />
              <span class="text-gold-300">Be Real…Together.</span>
            </>
          ) : (
            heroTagline
          )}
        </h1>
        <p class="mt-3.5 max-w-2xl text-sm leading-relaxed text-zinc-200 sm:text-base">
          {heroSubtitle}
        </p>

        <div class="mt-5 flex flex-wrap items-center gap-3">
          <a
            href="/concerts"
            class="rounded-full bg-gold-500 px-5 py-2.5 text-xs font-bold uppercase tracking-[0.14em] text-white shadow-lg transition hover:bg-copper-600 sm:px-6 sm:tracking-[0.16em]"
          >
            Concerts & Tickets
          </a>
          <a
            href="/media"
            class="rounded-full border border-white/25 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.14em] text-ivory-50 transition hover:border-gold-400 hover:text-gold-300 sm:px-6 sm:tracking-[0.16em]"
          >
            Watch & Listen
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Next Concert Spotlight (Advent with Kantorei Banner + Shoreview & Edina Dates) -->
  {featuredConcert && (
    <section class="mx-auto -mt-8 sm:-mt-10 relative z-10 max-w-6xl px-4 sm:px-6">
      <div class="overflow-hidden rounded-3xl border border-zinc-200/90 bg-white shadow-xl">
        <div class="grid lg:grid-cols-12 lg:items-stretch">
          {featuredConcert.heroImageUrl && (
            <div class="flex items-center justify-center bg-gradient-to-br from-navy-950 via-navy-900 to-navy-950 p-4 sm:p-6 lg:col-span-6">
              <img
                src={featuredConcert.heroImageUrl}
                alt={featuredConcert.title}
                class="block h-auto w-full rounded-2xl object-contain shadow-2xl ring-1 ring-white/10"
              />
            </div>
          )}

          <div
            class:list={[
              'p-7 sm:p-10',
              featuredConcert.heroImageUrl ? 'lg:col-span-6 flex flex-col justify-between' : 'lg:col-span-12',
            ]}
          >
            {featuredConcert.heroImageUrl ? (
              <>
                <div>
                  <div class="flex flex-wrap items-center gap-2.5">
                    <span class="rounded-full bg-navy-900 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-gold-300">
                      Next Concert
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700">
                      {featuredConcert.status === 'On_Sale' ? 'Tickets Available' : 'Upcoming'}
                    </span>
                  </div>

                  <h2 class="mt-3 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
                    {featuredConcert.title}
                  </h2>

                  {featuredConcert.performances && featuredConcert.performances.length > 1 ? (
                    <div class="mt-4 space-y-3 rounded-2xl bg-ivory-100 p-4 text-sm">
                      {featuredConcert.performances.map((perf, pIdx) => (
                        <div
                          class:list={[
                            'flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between',
                            pIdx > 0 && 'border-t border-zinc-200/80 pt-3',
                          ]}
                        >
                          <div>
                            <p class="font-bold text-navy-950">{perf.dateDisplay}</p>
                            <p class="text-xs text-zinc-700">{perf.venueName}</p>
                          </div>
                          <div class="flex flex-wrap items-center gap-2">
                            <LocationDirectionsButton
                              client:load
                              location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                              venueName={perf.venueName}
                              label={perf.label ? `${perf.label} Directions` : 'Directions'}
                              variant="pill"
                            />
                            <AddToCalendarButton
                              client:load
                              title={featuredConcert.title}
                              description={featuredConcert.description}
                              dateStr={perf.dateDisplay}
                              location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                              venueName={perf.venueName}
                              venueAddress={perf.venueAddress}
                              variant="pill"
                            />
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="mt-3 space-y-2">
                      <p class="text-sm font-semibold text-zinc-800">
                        🗓 {featuredConcert.datesDisplay}
                      </p>
                      {featuredConcert.venueName && (
                        <div class="flex flex-wrap items-center gap-2">
                          <LocationDirectionsButton
                            client:load
                            location={buildCleanLocationQuery(featuredConcert.venueName, featuredConcert.venueAddress)}
                            venueName={featuredConcert.venueName}
                            variant="pill"
                          />
                          <AddToCalendarButton
                            client:load
                            title={featuredConcert.title}
                            description={featuredConcert.description}
                            dateStr={featuredConcert.datesDisplay}
                            location={buildCleanLocationQuery(featuredConcert.venueName, featuredConcert.venueAddress)}
                            venueName={featuredConcert.venueName}
                            venueAddress={featuredConcert.venueAddress}
                            variant="pill"
                          />
                        </div>
                      )}
                    </div>
                  )}

                  <p class="mt-4 text-sm leading-relaxed text-zinc-600">
                    {featuredConcert.description}
                  </p>
                </div>

                <div class="mt-6 flex flex-wrap items-center gap-3">
                  <a
                    href={`/concerts#${featuredConcert.slug}`}
                    class="rounded-full bg-gold-500 px-6 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-copper-600"
                  >
                    Reserve Tickets →
                  </a>
                </div>
              </>
            ) : (
              <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
                <div class="lg:col-span-7">
                  <div class="flex flex-wrap items-center gap-2.5">
                    <span class="rounded-full bg-navy-900 px-3 py-1 text-[11px] font-bold uppercase tracking-wider text-gold-300">
                      Next Concert
                    </span>
                    <span class="text-xs font-semibold uppercase tracking-wider text-emerald-700">
                      {featuredConcert.status === 'On_Sale' ? 'Tickets Available' : 'Upcoming'}
                    </span>
                  </div>

                  <h2 class="mt-3 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
                    {featuredConcert.title}
                  </h2>

                  {featuredConcert.performances && featuredConcert.performances.length > 1 ? (
                    <div class="mt-4 space-y-3 rounded-2xl bg-ivory-100 p-4 text-sm">
                      {featuredConcert.performances.map((perf, pIdx) => (
                        <div
                          class:list={[
                            'flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between',
                            pIdx > 0 && 'border-t border-zinc-200/80 pt-3',
                          ]}
                        >
                          <div>
                            <p class="font-bold text-navy-950">{perf.dateDisplay}</p>
                            <p class="text-xs text-zinc-700">{perf.venueName}</p>
                          </div>
                          <div class="flex flex-wrap items-center gap-2">
                            <LocationDirectionsButton
                              client:load
                              location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                              venueName={perf.venueName}
                              label={perf.label ? `${perf.label} Directions` : 'Directions'}
                              variant="pill"
                            />
                            <AddToCalendarButton
                              client:load
                              title={featuredConcert.title}
                              description={featuredConcert.description}
                              dateStr={perf.dateDisplay}
                              location={buildCleanLocationQuery(perf.venueName, perf.venueAddress)}
                              venueName={perf.venueName}
                              venueAddress={perf.venueAddress}
                              variant="pill"
                            />
                          </div>
                        </div>
                      ))}
                    </div>
                  ) : (
                    <div class="mt-3 space-y-2">
                      <p class="text-sm font-semibold text-zinc-800">
                        🗓 {featuredConcert.datesDisplay}
                      </p>
                      {featuredConcert.venueName && (
                        <div class="flex flex-wrap items-center gap-2">
                          <LocationDirectionsButton
                            client:load
                            location={buildCleanLocationQuery(featuredConcert.venueName, featuredConcert.venueAddress)}
                            venueName={featuredConcert.venueName}
                            variant="pill"
                          />
                          <AddToCalendarButton
                            client:load
                            title={featuredConcert.title}
                            description={featuredConcert.description}
                            dateStr={featuredConcert.datesDisplay}
                            location={buildCleanLocationQuery(featuredConcert.venueName, featuredConcert.venueAddress)}
                            venueName={featuredConcert.venueName}
                            venueAddress={featuredConcert.venueAddress}
                            variant="pill"
                          />
                        </div>
                      )}
                    </div>
                  )}
                </div>

                <div class="flex flex-col justify-between gap-6 rounded-2xl border border-zinc-200/80 bg-ivory-50 p-6 lg:col-span-5">
                  <div>
                    <h3 class="text-xs font-bold uppercase tracking-wider text-zinc-500">
                      Program Notes
                    </h3>
                    <p class="mt-2 text-sm leading-relaxed text-zinc-700">
                      {featuredConcert.description}
                    </p>
                  </div>

                  <div class="pt-2">
                    <a
                      href={`/concerts#${featuredConcert.slug}`}
                      class="inline-block w-full rounded-full bg-gold-500 px-6 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white transition hover:bg-copper-600 shadow-sm"
                    >
                      Reserve Tickets →
                    </a>
                  </div>
                </div>
              </div>
            )}
          </div>
        </div>
      </div>
    </section>
  )}

  <!-- Ensemble Identity & Mission -->
  <section class="mx-auto max-w-6xl px-4 py-20 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-12 lg:items-center">
      <div class="lg:col-span-7 space-y-4">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          Who We Are
        </span>
        <h2 class="font-editorial text-4xl font-bold text-navy-950 sm:text-5xl">
          {visionStatement}
        </h2>
        <p class="text-base leading-relaxed text-zinc-700 sm:text-lg">
          Founded in 1988 by Axel Theimer and led today by Artistic Director Adam Reinwald, {choirName} brings together passionate artists and audiences through choral singing from around the world.
        </p>

        <!-- Official Mission & Vision Statements -->
        <div class="mt-6 grid gap-4 pt-2 sm:grid-cols-2">
          <div class="rounded-2xl border border-zinc-200 bg-ivory-100 p-5 sm:p-6">
            <span class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">
              Our Vision
            </span>
            <p class="mt-2 font-editorial text-xl font-bold leading-snug text-navy-950">
              {visionStatement}
            </p>
          </div>
          <div class="rounded-2xl border border-zinc-200 bg-ivory-100 p-5 sm:p-6">
            <span class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">
              Our Mission
            </span>
            <p class="mt-2 font-editorial text-xl font-bold leading-snug text-navy-950">
              {missionStatement}
            </p>
          </div>
        </div>

        <div class="pt-2 flex flex-wrap items-center gap-x-5 gap-y-2">
          <a
            href="/about"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4"
          >
            Learn more about our artistic leadership & history →
          </a>
          <a
            href="/auditions"
            class="inline-flex items-center gap-1.5 text-sm font-semibold text-gold-600 hover:text-navy-950 underline decoration-gold-400 decoration-2 underline-offset-4"
          >
            Audition for {choirName} →
          </a>
        </div>
      </div>

      <div class="flex flex-col gap-4 lg:col-span-5">
        <div class="rounded-2xl border border-zinc-200 bg-ivory-100 p-5 sm:p-6">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">
            Global Repertoire
          </span>
          <p class="mt-2 font-editorial text-xl font-bold leading-snug text-navy-950">
            Signature choral works paired with music from well-known and emerging composers.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-ivory-100 p-5 sm:p-6">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500">
            Vocal Health & Outreach
          </span>
          <p class="mt-2 font-editorial text-xl font-bold leading-snug text-navy-950">
            Inviting singers and audiences of all ages to share the pursuit of singing for a lifetime.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Instagram Feed First (Lead with most updated media) -->
  <section class="border-t border-zinc-200 bg-ivory-50/50 py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-pink-600">
            Instagram Feed · {instagramShowcase.handle}
          </span>
          <h2 class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
            Behind the Scenes with {choirName}
          </h2>
          <p class="mt-1.5 text-xs text-zinc-600 sm:text-sm">
            Recent rehearsal blends, singer spotlights, and community concert updates.
          </p>
        </div>
        <a
          href={instagramShowcase.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-pink-300 bg-pink-50/70 px-4 py-2 text-xs font-bold uppercase tracking-wider text-pink-700 transition hover:bg-pink-100"
        >
          Follow on Instagram →
        </a>
      </div>

      <!-- Vertical Flowing Grid of Captioned Instagram Posts -->
      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3 items-start">
        {featuredInstagram.map((post) => (
          <div class="w-full flex justify-center">
            <blockquote
              class="instagram-media w-full overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xs"
              data-instgrm-captioned
              data-instgrm-permalink={`https://www.instagram.com/p/${post.shortcode}/?utm_source=ig_embed&amp;utm_campaign=loading`}
              data-instgrm-version="14"
              style="margin: 0; min-width: 280px; max-width: 100%; width: 100%;"
            >
              <iframe
                src={`https://www.instagram.com/p/${post.shortcode}/embed/captioned/`}
                title={`Instagram post from ${instagramShowcase.handle}`}
                loading="lazy"
                allowtransparency="true"
                allow="encrypted-media"
                class="w-full border-0 overflow-hidden rounded-2xl"
                style="min-height: 640px; height: 680px;"
              />
            </blockquote>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Featured YouTube Recordings (Directly Embedded) -->
  <section class="border-t border-zinc-200 bg-white py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
            Recordings Shared Worldwide
          </span>
          <h2 class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
            Watch & Listen to {choirName}
          </h2>
          <p class="mt-1.5 text-xs text-zinc-600 sm:text-sm">
            Studio recordings and signature a cappella performances shared from Minnesota.
          </p>
        </div>
        <a
          href="/media"
          class="text-sm font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4"
        >
          Explore Full Media Library →
        </a>
      </div>

      <div class="mt-10 grid gap-8 md:grid-cols-2 lg:grid-cols-3">
        {featuredMedia.map((item) => {
          const { embedUrl } = extractYouTubeEmbedUrl(item.youtubeUrl);

          return (
            <article class="flex flex-col overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xs transition hover:border-gold-400/60 hover:shadow-md">
              {embedUrl ? (
                <div class="aspect-video w-full bg-navy-950">
                  <iframe
                    src={embedUrl}
                    title={item.title}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    allowfullscreen
                    class="h-full w-full border-0"
                  />
                </div>
              ) : (
                <a
                  href={item.youtubeUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group relative flex aspect-video w-full flex-col items-center justify-center overflow-hidden bg-navy-950 p-6 text-center text-white"
                >
                  <span class="relative flex h-12 w-12 items-center justify-center rounded-full bg-gold-500 text-white shadow-lg">
                    <svg class="ml-0.5 h-5 w-5 fill-current" viewBox="0 0 24 24">
                      <path d="M8 5v14l11-7z" />
                    </svg>
                  </span>
                  <span class="relative mt-2 text-xs font-semibold uppercase tracking-widest text-gold-300">
                    Watch on YouTube ↗
                  </span>
                </a>
              )}

              <div class="flex flex-1 flex-col justify-between p-6">
                <div>
                  <span class="inline-block rounded-full bg-copper-100 px-2.5 py-0.5 text-[11px] font-bold uppercase tracking-wider text-gold-500">
                    {item.category}
                  </span>
                  <h3 class="mt-2.5 font-editorial text-2xl font-bold text-navy-950 leading-snug">
                    {item.title}
                  </h3>
                  {item.subtitle && (
                    <p class="mt-1 text-xs font-semibold text-zinc-600">{item.subtitle}</p>
                  )}
                  {item.description && (
                    <p class="mt-3 text-sm leading-relaxed text-zinc-600 line-clamp-2">
                      {item.description}
                    </p>
                  )}
                </div>

                <div class="mt-5 border-t border-zinc-100 pt-3.5">
                  <a
                    href={item.youtubeUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="inline-flex items-center gap-1.5 text-xs font-bold uppercase tracking-wider text-gold-500 hover:text-navy-950"
                  >
                    Open on YouTube ↗
                  </a>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </div>
  </section>

  <!-- Optional Instagram client script for native responsive embedding -->
  <script is:inline async src="//www.instagram.com/embed.js"></script>

  <!-- Friends of Kantorei Patron Community Banner -->
  <section class="border-t border-zinc-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <NewsletterForm
        client:visible
        variant="banner"
        source="Home_Page"
        title="Stay in Tune with Friends of Kantorei"
        description="Join our circle of patrons, alumni, and choral lovers. Get first access to concert tickets, conductor Adam Reinwald’s listening guides, and unreleased choral recordings."
        buttonText="Join Friends of Kantorei"
      />
    </div>
  </section>

  <!-- Tax-Deductible Patronage CTA -->
  <section class="border-t border-zinc-200 bg-ivory-100/90 py-16">
    <div class="mx-auto flex max-w-6xl flex-col items-start justify-between gap-6 px-4 sm:px-6 md:flex-row md:items-center">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          501(c)(3) Nonprofit Ensemble
        </span>
        <h2 class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
          Help sustain {choirName}’s concerts, recordings, and community outreach.
        </h2>
      </div>
      <a
        href="/support"
        class="shrink-0 rounded-full bg-navy-900 px-7 py-3.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-navy-800"
      >
        Make a Tax-Deductible Gift
      </a>
    </div>
  </section>

  <!-- Sing With Us / Auditions Callout (Bottom of Home Page) -->
  <section class="border-t border-zinc-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col items-start justify-between gap-6 rounded-3xl border border-zinc-200 bg-ivory-50 p-7 sm:flex-row sm:items-center sm:p-10">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
            Sing With Us
          </span>
          <h2 class="mt-1 font-editorial text-2xl font-bold text-navy-950 sm:text-3xl">
            Interested in auditioning for {choirName}?
          </h2>
          <p class="mt-2 text-xs leading-relaxed text-zinc-600 sm:text-sm">
            We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. Kantorei rehearses Sunday evenings at rotating venues across the Twin Cities metro area. Inquiries and submissions are warmly welcomed year-round. Come sing with us!
          </p>
        </div>
        <div class="flex shrink-0 flex-wrap items-center gap-3">
          <a
            href="/auditions"
            class="rounded-full bg-gold-500 px-6 py-3 text-xs font-bold uppercase tracking-wider text-white shadow-xs transition hover:bg-copper-600"
          >
            Audition Information &amp; Form &rarr;
          </a>
          <a
            href="/login"
            class="rounded-full border border-zinc-300 bg-white px-5 py-3 text-xs font-semibold uppercase tracking-wider text-zinc-700 transition hover:bg-zinc-50"
          >
            Singer Portal
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

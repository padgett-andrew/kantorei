---
import PublicLayout from '../layouts/PublicLayout.astro';
import GivebutterEmbed from '../components/public/GivebutterEmbed';
import { getEnv } from '../lib/env';
import { getPortalConfig } from '../lib/google';

const config = await getPortalConfig(Astro.locals);
const choirName = config.Choir_Name || 'Kantorei';
const accountId = getEnv('PUBLIC_GIVEBUTTER_ACCOUNT_ID', Astro.locals) || 'DEMO';
const campaignId = getEnv('PUBLIC_GIVEBUTTER_CAMPAIGN_ID', Astro.locals) || 'DEMO';

const givingTiers = [
  { name: 'Friend', range: '$25 – $99', desc: 'Recognition in all digital & printed concert programs.' },
  { name: 'Chorister Circle', range: '$100 – $249', desc: 'Sponsors sheet music & educational student tickets.' },
  { name: 'Section Patron', range: '$250 – $499', desc: 'Invitations to open acoustic dress rehearsals.' },
  { name: 'Conductor’s Circle', range: '$500+', desc: 'Underwrites guest instrumentalists & new commissions.' },
];
---

<PublicLayout title="Support Our Season">
  <section class="bg-navy-950 py-16 text-ivory-50 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
        501(c)(3) Tax-Deductible Giving
      </span>
      <h1 class="mt-3 max-w-3xl font-editorial text-4xl font-bold text-white sm:text-5xl">
        Sustain choral beauty in our community.
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300 sm:text-base">
        Every contribution to {choirName} directly funds guest chamber musicians, historic sanctuary acoustics, living composer commissions, and $10 accessible tickets for students and young adults.
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-12 lg:grid-cols-12">
      <!-- Givebutter Interactive Donation Embed -->
      <div class="lg:col-span-7">
        <GivebutterEmbed
          client:load
          accountId={accountId}
          campaignId={campaignId}
          choirName={choirName}
        />
      </div>

      <!-- Giving Circles & Employer Matching -->
      <div class="space-y-6 lg:col-span-5">
        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs">
          <h2 class="font-editorial text-2xl font-bold text-navy-950">
            Annual Giving Circles
          </h2>
          <ul class="mt-4 divide-y divide-zinc-100">
            {givingTiers.map((tier) => (
              <li class="py-3.5">
                <div class="flex items-baseline justify-between">
                  <span class="font-semibold text-navy-950">{tier.name}</span>
                  <span class="text-xs font-bold text-gold-500">{tier.range}</span>
                </div>
                <p class="mt-1 text-xs text-zinc-600">{tier.desc}</p>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-ivory-100 p-6">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            Employer Matching, DAFs & Checks
          </h3>
          <p class="mt-2 text-xs leading-relaxed text-zinc-700">
            {choirName} welcomes corporate matching gifts (Benevity, CyberGrants, YourCause), Donor-Advised Fund grants, and gifts of appreciated securities. Contact{' '}
            <a
              href={`mailto:${config.Manager_Email || 'manager@kantorei.net'}`}
              class="font-semibold text-navy-900 underline"
            >
              {config.Manager_Email || 'manager@kantorei.net'}
            </a>{' '}
            for our EIN and mailing details.
          </p>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>


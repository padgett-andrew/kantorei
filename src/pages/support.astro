---
import PublicLayout from '../layouts/PublicLayout.astro';
import SupportDonationManager from '../components/public/SupportDonationManager';
import { getEnv } from '../lib/env';
import { getGivingTiers, getPortalConfig } from '../lib/google';
import { formatRichText } from '../lib/config-interpolate';
import { getSiteUrl, buildBreadcrumbsSchema } from '../lib/seo';

const [config, givingTiers] = await Promise.all([
  getPortalConfig(Astro.locals),
  getGivingTiers(Astro.locals),
]);

const choirName = config.Choir_Name || 'Kantorei';
const publicContactEmail = config.Contact_Email || 'info@kantorei.net';
const publicContactPhone = config.Contact_Phone || '612-21-SINGS (612-217-4647)';
const publicContactAddress = config.Contact_Address || '660 23rd Ave NW, Saint Paul, MN 55112';
const siteUrl = getSiteUrl(Astro.locals);
const breadcrumbs = buildBreadcrumbsSchema(
  [
    { name: 'Home', path: '/' },
    { name: 'Support Our Season', path: '/support' },
  ],
  siteUrl,
);
const supportHeroTitle =
  config.Support_Hero_Title || 'Sustain choral artistry and lifelong singing in Minnesota.';
const supportHeroSubtitle =
  config.Support_Hero_Subtitle ||
  `Every contribution to ${choirName} funds performances, composer commissions, recordings shared worldwide, Friends of Kantorei community programming, and keeps ensemble membership free of mandatory singer dues.`;
const supportGalaTitle = config.Support_Gala_Title || `Annual ${choirName} Gala & Friendraisers`;
const supportGalaBlurb =
  config.Support_Gala_Blurb ||
  `Our annual Gala is ${choirName}’s signature fundraising celebration—bringing singers, alumni, and patrons together for live music, hospitality, and community support. Follow us on Instagram and Facebook for upcoming Gala dates and sponsorship opportunities.`;

const supportMatchingTitle = config.Support_Matching_Title || 'Employer Matching, DAFs & Checks';
const defaultMatchingBlurb = `${choirName} welcomes corporate matching gifts (Benevity, CyberGrants, YourCause), Donor-Advised Fund grants, and gifts of appreciated securities. Contact [${publicContactEmail}](mailto:${publicContactEmail}) or call [${publicContactPhone}](tel:${publicContactPhone.replace(/[^0-9+]/g, '')}) for our EIN and delivery instructions. Checks may be mailed to ${publicContactAddress}.`;
const rawMatchingBlurb = (config.Support_Matching_Blurb || defaultMatchingBlurb).trim();

const supportAuditionsTitle = config.Support_Auditions_Title || `Audition for ${choirName}`;
const supportAuditionsBlurb =
  config.Support_Auditions_Blurb ||
  `Beyond financial contributions, ${choirName} is sustained by the dedication and artistry of our singers. We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out our roster of singers for the coming season, rehearsing at rotating venues across the Twin Cities. Inquiries and submissions are warmly welcomed year-round. Come sing with us!`;

const accountId =
  config.Givebutter_Account_ID ||
  getEnv('PUBLIC_GIVEBUTTER_ACCOUNT_ID', Astro.locals) ||
  'DEMO';
const campaignId =
  config.Givebutter_Widget_ID ||
  config.Givebutter_Campaign_ID ||
  getEnv('PUBLIC_GIVEBUTTER_CAMPAIGN_ID', Astro.locals) ||
  'DEMO';
const lglFormUrl =
  config.LGL_Form_URL ||
  getEnv('PUBLIC_LGL_FORM_URL', Astro.locals) ||
  'https://secure.lglforms.com/form_engine/s/BM1h-KN91G0MJHiPSzPbsA';

// Donation Platform Feature Flag: 'givebutter' | 'lgl' | 'both'
// Priority: 1. URL search param (?platform= / ?provider=) -> 2. Sheet Config -> 3. Environment Variable -> 4. Default 'both'
const queryParamPlatform = (
  Astro.url.searchParams.get('platform') ||
  Astro.url.searchParams.get('provider') ||
  ''
).toLowerCase();

const configuredPlatform = (
  config.Donation_Platform ||
  getEnv('PUBLIC_DONATION_PLATFORM', Astro.locals) ||
  'both'
).toLowerCase();

const initialPlatform: 'givebutter' | 'lgl' | 'both' =
  queryParamPlatform === 'lgl' || queryParamPlatform === 'givebutter' || queryParamPlatform === 'both'
    ? (queryParamPlatform as 'givebutter' | 'lgl' | 'both')
    : configuredPlatform === 'lgl' || configuredPlatform === 'givebutter' || configuredPlatform === 'both'
      ? (configuredPlatform as 'givebutter' | 'lgl' | 'both')
      : 'both';

const allowToggle =
  configuredPlatform === 'both' ||
  Boolean(Astro.url.searchParams.get('demo')) ||
  Boolean(Astro.url.searchParams.get('platform')) ||
  Boolean(Astro.url.searchParams.get('provider')) ||
  import.meta.env.DEV;
---

<PublicLayout
  title={`Support ${choirName} | 501(c)(3) Nonprofit Choral Arts · Twin Cities, MN`}
  description={`Support ${choirName}'s choral artistry, commissions, and lifelong singing in Minnesota. Contributions to our 501(c)(3) nonprofit keep singer membership free of mandatory dues.`}
  keywords="support kantorei, donate to choir minnesota, twin cities arts nonprofit, choral philanthropy minneapolis st paul, 501c3 choir twin cities"
  structuredData={breadcrumbs}
>
  <section class="relative overflow-hidden bg-[#0B131E] pt-28 pb-16 text-ivory-50 sm:pt-36 sm:pb-20">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
        501(c)(3) Tax-Deductible Giving
      </span>
      <h1 class="mt-3 max-w-3xl font-editorial text-4xl font-bold text-white sm:text-5xl">
        {supportHeroTitle}
      </h1>
      <p class="mt-4 max-w-2xl text-sm leading-relaxed text-zinc-300 sm:text-base">
        {supportHeroSubtitle}
      </p>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6">
    <div class="grid gap-8 lg:gap-12 lg:grid-cols-12 lg:items-start">
      <!-- Interactive Donation Platform (Givebutter vs Little Green Light) -->
      <div class="lg:col-span-7">
        <SupportDonationManager
          client:load
          accountId={accountId}
          campaignId={campaignId}
          choirName={choirName}
          givingTiers={givingTiers}
          lglFormUrl={lglFormUrl}
          initialPlatform={initialPlatform}
          allowToggle={allowToggle}
        />
      </div>

      <!-- Gala, Employer Matching & Auditions Callout -->
      <div class="space-y-6 lg:col-span-5">
        <div class="rounded-2xl border border-stone-200/80 bg-[#FAF7F2] p-6 shadow-xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            {supportGalaTitle}
          </h3>
          <p class="mt-2 text-sm sm:text-base leading-relaxed text-stone-700">
            {supportGalaBlurb}
          </p>
        </div>

        <div class="rounded-2xl border border-stone-200/80 bg-white p-6 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            {supportMatchingTitle}
          </h3>
          <p
            class="mt-2 text-sm sm:text-base leading-relaxed text-stone-700"
            set:html={formatRichText(rawMatchingBlurb)}
          />
          {lglFormUrl && (
            <p class="mt-3 border-t border-stone-200/80 pt-3 text-sm text-stone-600 sm:text-base">
              Prefer giving through our Little Green Light constituent form?{' '}
              <a
                href={lglFormUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="font-semibold text-navy-900 underline decoration-gold-500 underline-offset-4 hover:text-gold-600"
              >
                Open LGL donation portal &rarr;
              </a>
            </p>
          )}
        </div>

        <!-- Sing With Us / Auditions Callout -->
        <div class="rounded-2xl border border-gold-200/80 bg-amber-50/70 p-6 shadow-2xs">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-gold-600">
            Support with Your Voice
          </span>
          <h3 class="mt-1 font-editorial text-xl font-bold text-navy-950">
            {supportAuditionsTitle}
          </h3>
          <p
            class="mt-2 text-sm sm:text-base leading-relaxed text-stone-700"
            set:html={formatRichText(supportAuditionsBlurb)}
          />
          <div class="mt-4">
            <a
              href="/auditions"
              class="inline-flex items-center gap-1.5 text-xs sm:text-sm font-bold uppercase tracking-wider text-navy-950 underline decoration-gold-500 underline-offset-4 hover:text-gold-600"
            >
              Audition Information &amp; Interest Form &rarr;
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>


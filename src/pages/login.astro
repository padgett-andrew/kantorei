---
import PublicLayout from '../layouts/PublicLayout.astro';
import LoginCard from '../components/portal/LoginCard';
import { isDevPreviewEnabled } from '../lib/env';
import { getPortalConfig, getRoster } from '../lib/google';

const errorParam = Astro.url.searchParams.get('error') ?? undefined;
const nextPath = Astro.url.searchParams.get('next') ?? '/portal';

// If already signed in via real session (and no error), go straight to /portal
if (Astro.locals.singer && !Astro.locals.isDevPreview && !errorParam) {
  return Astro.redirect(nextPath);
}

const devAvailable = isDevPreviewEnabled(Astro.locals);
const [config, allSingers] = await Promise.all([
  getPortalConfig(Astro.locals),
  devAvailable ? getRoster(Astro.locals) : Promise.resolve([]),
]);

const choirName = config.Choir_Name || 'Kantorei';
const publicContactEmail = config.Contact_Email || 'info@kantorei.net';
const auditionsTimingNote =
  config.Auditions_Timing_Note ||
  'We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview. Inquiries and submissions are warmly welcomed year-round. Come sing with us!';
const auditionsBlurb =
  config.Auditions_Blurb ||
  'We welcome inquiries from experienced Twin Cities choral singers across all voice parts who share our commitment to vocal health, independent preparation, and expressive a cappella ensemble singing.';
const auditionsCadence =
  config.Auditions_Rehearsal_Cadence ||
  `${choirName} rehearses Sunday evenings at rotating venues across the Twin Cities metro area.`;

let devPersonas: { email: string; shortLabel: string }[] = [];
if (devAvailable) {
  const activeRoster = allSingers.filter((s) => s.active);
  const picked = [
    activeRoster.find((s) => s.role === 'Admin'),
    activeRoster.find((s) => s.role === 'Section_Leader'),
    activeRoster.find((s) => s.role === 'Singer'),
  ].filter((s): s is NonNullable<typeof s> => Boolean(s));

  const seen = new Set(picked.map((p) => p.email));
  for (const s of activeRoster) {
    if (picked.length >= 3) break;
    if (!seen.has(s.email)) {
      picked.push(s);
      seen.add(s.email);
    }
  }

  devPersonas = picked.map((s) => ({
    email: s.email,
    shortLabel: `${s.name.split(' ')[0]} (${s.role.replace('_', ' ')} · ${s.voicePart})`,
  }));
}
---

<PublicLayout
  title={`Singer Portal & Auditions · ${choirName}`}
  description={`Sign in to the ${choirName} Singer Portal or learn how to audition for our upcoming concert season.`}
>
  <!-- Dark Slate-Navy Editorial Hero Section -->
  <section class="relative overflow-hidden bg-[#0B131E] pt-24 pb-10 text-ivory-50 sm:pt-28 sm:pb-12">
    <div
      class="pointer-events-none absolute inset-0 opacity-20"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      <p class="text-[11px] font-semibold uppercase tracking-[0.22em] text-copper-400">
        Ensemble Member Access &amp; Auditions
      </p>
      <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-white sm:text-5xl">
        Singers of {choirName}
      </h1>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed text-[#E6E1DA] sm:text-base">
        Sign in to the ensemble member portal for scores, rehearsal calls, and stage formations, or inquire about auditioning for our upcoming season.
      </p>
    </div>
  </section>

  <!-- Portal Sign-in & Auditions Grid -->
  <section class="mx-auto max-w-6xl px-4 pt-8 pb-16 sm:px-6 sm:pt-10 sm:pb-20">
    <div class="grid gap-10 lg:grid-cols-12 lg:items-start">
      <!-- Current Members: Sign-In Column -->
      <div class="lg:col-span-7">
        <div class="mb-5">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
            Current Ensemble Members
          </p>
          <h2 class="mt-1.5 font-editorial text-3xl font-normal text-navy-950 sm:text-4xl">
            Member Portal Sign-In
          </h2>
          <p class="mt-1.5 text-sm leading-relaxed text-stone-600">
            Authenticate with Google or receive a single-use 6-digit login code at your active roster email address.
          </p>
        </div>

        <LoginCard
          client:load
          oauthError={errorParam}
          nextPath={nextPath}
          isDevPreviewAvailable={devAvailable}
          devPersonas={devPersonas}
        />
      </div>

      <!-- Prospective Singers: Auditions Information Column -->
      <div class="space-y-4 lg:col-span-5">
        <div class="rounded-sm border border-stone-200/90 bg-white p-6 sm:p-7">
          <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
            Prospective Singers
          </p>
          <h2 class="mt-1.5 font-editorial text-3xl font-normal text-navy-950">
            Audition for {choirName}
          </h2>

          <div class="mt-4 border-l-2 border-copper-500 bg-[#FAF7F2] px-4 py-3 text-xs leading-relaxed text-stone-700 sm:text-sm">
            <strong class="font-semibold text-navy-950">Audition Schedule:</strong> {auditionsTimingNote}
          </div>

          <p class="mt-4 text-sm leading-relaxed text-stone-600">
            {auditionsBlurb}
          </p>

          <ul class="mt-4 space-y-2.5 border-t border-stone-200/80 pt-4 text-sm text-stone-700">
            <li class="flex items-start gap-2.5">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-copper-600" aria-hidden="true"></span>
              <span>{auditionsCadence}</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-copper-600" aria-hidden="true"></span>
              <span>Prepared a cappella selection, musicianship checks, and brief conversation with Artistic Director Adam Reinwald and section leaders</span>
            </li>
            <li class="flex items-start gap-2.5">
              <span class="mt-2 h-1 w-1 shrink-0 rounded-full bg-copper-600" aria-hidden="true"></span>
              <span>Accessible participation with zero mandatory singer dues</span>
            </li>
          </ul>

          <div class="mt-6 flex flex-col gap-2.5">
            <a
              href="/auditions"
              class="inline-flex items-center justify-center gap-2 rounded-sm bg-copper-600 px-5 py-3 text-center text-xs font-semibold uppercase tracking-[0.16em] text-white transition hover:bg-copper-700"
            >
              Audition Details &amp; Application &rarr;
            </a>
            <a
              href={`mailto:${publicContactEmail}?subject=${encodeURIComponent(
                `${choirName} Audition Inquiry`
              )}`}
              class="inline-flex items-center justify-center gap-2 rounded-sm border border-stone-300 bg-white px-5 py-3 text-center text-xs font-semibold uppercase tracking-[0.16em] text-stone-700 transition hover:border-navy-950 hover:text-navy-950"
            >
              Inquire via Email
            </a>
          </div>
        </div>

        <div class="rounded-sm border border-stone-200/90 bg-[#FAF7F2] px-5 py-4 text-xs leading-relaxed text-stone-600">
          <strong class="font-semibold text-navy-950">Questions about auditioning?</strong> Write to Artistic Director Adam Reinwald at{' '}
          <a href={`mailto:${publicContactEmail}`} class="text-navy-950 underline decoration-copper-500 underline-offset-2 hover:text-copper-700">
            {publicContactEmail}
          </a>.
        </div>
      </div>
    </div>
  </section>
</PublicLayout>


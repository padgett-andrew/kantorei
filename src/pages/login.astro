---
import PublicLayout from '../layouts/PublicLayout.astro';
import LoginCard from '../components/portal/LoginCard';
import { isDevPreviewEnabled } from '../lib/env';
import { getPortalConfig, getRoster } from '../lib/google';

const errorParam = Astro.url.searchParams.get('error') ?? undefined;
const nextPath = Astro.url.searchParams.get('next') ?? '/portal';

// If already signed in via real session (and no error), go straight to /portal
if (Astro.locals.singer && !Astro.locals.isDevPreview && !errorParam) {
  return Astro.redirect(nextPath);
}

const devAvailable = isDevPreviewEnabled(Astro.locals);
const [config, allSingers] = await Promise.all([
  getPortalConfig(Astro.locals),
  devAvailable ? getRoster(Astro.locals) : Promise.resolve([]),
]);

const choirName = config.Choir_Name || 'Kantorei';
const publicContactEmail = config.Contact_Email || 'info@kantorei.net';
const auditionsTimingNote =
  config.Auditions_Timing_Note ||
  'We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview. Inquiries and submissions are warmly welcomed year-round. Come sing with us!';
const auditionsBlurb =
  config.Auditions_Blurb ||
  'We welcome inquiries from experienced Twin Cities choral singers across all voice parts who share our commitment to vocal health, independent preparation, and expressive a cappella ensemble singing.';
const auditionsCadence =
  config.Auditions_Rehearsal_Cadence ||
  `${choirName} rehearses Sunday evenings at rotating venues across the Twin Cities metro area.`;

let devPersonas: { email: string; shortLabel: string }[] = [];
if (devAvailable) {
  const activeRoster = allSingers.filter((s) => s.active);
  const picked = [
    activeRoster.find((s) => s.role === 'Admin'),
    activeRoster.find((s) => s.role === 'Section_Leader'),
    activeRoster.find((s) => s.role === 'Singer'),
  ].filter((s): s is NonNullable<typeof s> => Boolean(s));

  const seen = new Set(picked.map((p) => p.email));
  for (const s of activeRoster) {
    if (picked.length >= 3) break;
    if (!seen.has(s.email)) {
      picked.push(s);
      seen.add(s.email);
    }
  }

  devPersonas = picked.map((s) => ({
    email: s.email,
    shortLabel: `${s.name.split(' ')[0]} (${s.role.replace('_', ' ')} · ${s.voicePart})`,
  }));
}
---

<PublicLayout
  title={`Singer Portal & Auditions · ${choirName}`}
  description={`Sign in to the ${choirName} Singer Portal or learn how to audition for our upcoming concert season.`}
>
  <!-- Dark Slate-Navy Editorial Hero Section (Compact & above-the-fold optimized) -->
  <section class="relative overflow-hidden bg-[#0B131E] pt-20 pb-7 text-ivory-50 sm:pt-24 sm:pb-8">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="relative z-10 mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-[11px] sm:text-xs font-semibold uppercase tracking-[0.2em] text-copper-500">
        Ensemble Portal & Singer Access
      </span>
      <h1 class="mt-1 font-editorial text-3xl sm:text-4xl lg:text-5xl font-medium text-white tracking-tight leading-tight">
        Singers of {choirName}
      </h1>
      <p class="mt-1.5 max-w-2xl text-xs sm:text-sm text-[#E6E1DA]">
        Sign in to your member portal account or learn how to audition for our upcoming concert season.
      </p>
    </div>
  </section>

  <!-- Portal Sign-in & Auditions Grid on Warm Alabaster/Ivory -->
  <section class="mx-auto max-w-6xl px-4 pt-5 pb-12 sm:px-6 sm:pt-6 sm:pb-16">
    <div class="grid gap-8 lg:grid-cols-12 lg:items-start">
      <!-- Current Members: Sign-In Column -->
      <div class="lg:col-span-7">
        <div class="mb-3.5">
          <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
            Current Ensemble Members
          </span>
          <h2 class="mt-0.5 font-editorial text-2xl font-bold text-navy-950 sm:text-3xl">
            Portal Sign-In
          </h2>
          <p class="mt-1 text-xs sm:text-sm leading-relaxed text-stone-600">
            Sign in with your Google account or receive an instant 6-digit login code at your roster email address.
          </p>
        </div>

        <LoginCard
          client:load
          oauthError={errorParam}
          nextPath={nextPath}
          isDevPreviewAvailable={devAvailable}
          devPersonas={devPersonas}
        />
      </div>

      <!-- Prospective Singers: Auditions Information Column -->
      <div class="space-y-4 lg:col-span-5">
        <div class="rounded-2xl border border-stone-200/80 bg-white p-5 sm:p-6 shadow-xs">
          <span class="text-xs font-bold uppercase tracking-[0.18em] text-copper-600">
            Prospective Singers
          </span>
          <h2 class="mt-1 font-editorial text-2xl sm:text-3xl font-bold text-navy-950">
            Audition for {choirName}
          </h2>

          <!-- Gentle Timing Reminder -->
          <div class="mt-3 rounded-xl border border-gold-300/50 bg-amber-50/60 p-3.5 text-xs leading-relaxed text-stone-800">
            <span class="font-bold text-navy-950">Audition Schedule:</span> {auditionsTimingNote}
          </div>

          <p class="mt-3 text-xs leading-relaxed text-stone-600 sm:text-sm">
            {auditionsBlurb}
          </p>

          <ul class="mt-3 space-y-2 text-xs text-stone-600">
            <li class="flex items-start gap-2">
              <span class="font-bold text-copper-500">✓</span>
              <span>{auditionsCadence}</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-copper-500">✓</span>
              <span>Prepared a cappella selection, basic musicianship checks &amp; interview with Adam Reinwald and section leaders</span>
            </li>
            <li class="flex items-start gap-2">
              <span class="font-bold text-copper-500">✓</span>
              <span>Accessible participation with zero mandatory singer dues</span>
            </li>
          </ul>

          <div class="mt-5 flex flex-col gap-2.5">
            <a
              href="/auditions"
              class="inline-flex items-center justify-center gap-2 rounded-sm bg-copper-500 px-5 py-2.5 text-center text-xs font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition duration-200 hover:bg-copper-600"
            >
              Audition Details & Google Form &rarr;
            </a>
            <a
              href={`mailto:${publicContactEmail}?subject=${encodeURIComponent(
                `${choirName} Audition Inquiry`
              )}`}
              class="inline-flex items-center justify-center gap-2 rounded-sm border border-stone-300 bg-white px-5 py-2.5 text-center text-xs font-semibold uppercase tracking-[0.14em] text-stone-700 transition hover:bg-stone-50 hover:text-navy-950"
            >
              Email Adam Reinwald Directly
            </a>
          </div>
        </div>

        <div class="rounded-xl border border-stone-200/80 bg-white p-4 text-xs text-stone-600 shadow-2xs">
          <span class="font-bold text-navy-950">Questions about auditioning?</span> Contact Artistic Director Adam Reinwald at{' '}
          <a href={`mailto:${publicContactEmail}`} class="text-navy-900 underline decoration-copper-500 underline-offset-2 hover:text-copper-600">
            {publicContactEmail}
          </a>.
        </div>
      </div>
    </div>
  </section>
</PublicLayout>


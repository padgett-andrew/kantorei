---
import PortalLayout from '../../layouts/PortalLayout.astro';
import SnackBoard from '../../components/portal/SnackBoard';
import { getPortalConfig, getSchedule } from '../../lib/google';
import { getTodayIso } from '../../lib/utils';

const singer = Astro.locals.singer!;
const [config, schedule] = await Promise.all([
  getPortalConfig(Astro.locals),
  getSchedule(Astro.locals),
]);

const today = getTodayIso(config.Calendar_Timezone || 'America/Chicago');
const snackEvents = schedule.filter((ev) => ev.date >= today);
---

<PortalLayout title="Hospitality & Volunteer Duties">
  <div class="mb-6">
    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
      Rehearsal Hospitality &amp; Concert Duties
    </span>
    <h1 class="mt-1 font-editorial text-3xl font-medium text-navy-950 sm:text-4xl">
      Hospitality &amp; Volunteer Duty Signups
    </h1>
    <p class="mt-1.5 text-sm sm:text-base leading-relaxed text-stone-600">
      Four singers team up for each rehearsal break to bring refreshments (~45 singers), and key volunteer roles (Setup &amp; Risers, Strike &amp; Cleanup, Box Office, Patron Reception) power each concert call. Claim a slot and let the ensemble know how you're pitching in!
    </p>
  </div>

  <SnackBoard client:load singer={singer} initialEvents={snackEvents} />
</PortalLayout>


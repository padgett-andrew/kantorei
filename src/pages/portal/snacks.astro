---
import PortalLayout from '../../layouts/PortalLayout.astro';
import SnackBoard from '../../components/portal/SnackBoard';
import { getPortalConfig, getSchedule } from '../../lib/google';
import { getTodayIso } from '../../lib/utils';

const singer = Astro.locals.singer!;
const [config, schedule] = await Promise.all([
  getPortalConfig(Astro.locals),
  getSchedule(Astro.locals),
]);

const today = getTodayIso(config.Calendar_Timezone || 'America/Chicago');
const snackEvents = schedule.filter((ev) => ev.date >= today);
---

<PortalLayout title="Sign-Ups & Duties">
  <header class="mb-8">
    <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
      Rehearsal &amp; Concert Volunteer Call
    </p>
    <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
      Sign-Ups &amp; Duties
    </h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-600">
      Sign up for rehearsal duties (break refreshments, room setup, cleanup) and concert crew roles (stage setup, box office, greeting, reception) across the season.
    </p>
  </header>

  <SnackBoard client:load singer={singer} initialEvents={snackEvents} />
</PortalLayout>


---
import PortalLayout from '../../layouts/PortalLayout.astro';
import AdminGuideContent from '../../../docs/admin-guide.md';
import { hasRole } from '../../lib/auth';

const singer = Astro.locals.singer;
if (!singer || !hasRole(singer, ['Section_Leader', 'Admin'])) {
  return Astro.redirect('/portal/handbook');
}
---

<PortalLayout title="Board & Operations Manual">
  <header class="mb-8">
    <p class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
      <span>Board, Section Leaders &amp; Staff Reference</span>
      <span class="text-stone-300" aria-hidden="true">/</span>
      <span class="text-stone-500">Leadership Edition</span>
    </p>
    <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
      Board &amp; Operations Manual
    </h1>
  </header>

  <article class="rounded-sm border border-stone-200/90 bg-white px-6 py-8 sm:px-12 sm:py-12">
    <div class="handbook-prose max-w-3xl">
      <AdminGuideContent />
    </div>
  </article>
</PortalLayout>

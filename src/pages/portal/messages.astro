---
import PortalLayout from '../../layouts/PortalLayout.astro';
import BulletinBoard from '../../components/portal/BulletinBoard';
import { hasRole } from '../../lib/auth';
import {
  getBulletinMessages,
  getRepertoire,
  getRoster,
} from '../../lib/google';

const singer = Astro.locals.singer!;
const canManage = hasRole(singer, ['Section_Leader', 'Admin']);

const [messages, roster, repertoire] = await Promise.all([
  getBulletinMessages(Astro.locals),
  getRoster(Astro.locals),
  getRepertoire(Astro.locals),
]);
---

<PortalLayout title="Bulletin & List Archive">
  <div class="space-y-8 sm:space-y-10">
    <header class="flex flex-col justify-between gap-4 border-b border-stone-200/90 pb-6 sm:flex-row sm:items-end">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
          Ensemble Dispatches · singers@kantorei.net
        </p>
        <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
          Ensemble Bulletin Board
        </h1>
      </div>
      <p class="max-w-md text-xs leading-relaxed text-stone-600 sm:text-right">
        Rehearsal setlists, small-group voicings, and director announcements synced from the <span class="font-medium text-navy-950">singers@kantorei.net</span> mailing list.
      </p>
    </header>

    <BulletinBoard
      client:load
      initialMessages={messages}
      currentSinger={singer}
      roster={roster}
      repertoire={repertoire}
      canManage={canManage}
    />
  </div>
</PortalLayout>

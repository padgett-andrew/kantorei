---
import PortalLayout from '../../layouts/PortalLayout.astro';
import RosterDirectory from '../../components/portal/RosterDirectory';
import {
  getAllSheetWarnings,
  getPortalConfig,
  getRoster,
  getWorkspaceLinks,
} from '../../lib/google';

const singer = Astro.locals.singer;
if (!singer) {
  return Astro.redirect('/login');
}

const isAdmin = singer.role === 'Admin';

const [config, roster, sheetWarnings] = await Promise.all([
  getPortalConfig(Astro.locals),
  getRoster(Astro.locals),
  getAllSheetWarnings(Astro.locals),
]);

const workspace = getWorkspaceLinks(isAdmin, config, Astro.locals);
const initialViewMode = Astro.url.searchParams.get('view') === 'table' ? 'table' : 'cards';
---

<PortalLayout title="Roster & Directory">
  <header class="mb-8">
    <p class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
      <span>Ensemble Roster</span>
      {isAdmin && (
        <>
          <span class="text-stone-300" aria-hidden="true">/</span>
          <span class="text-stone-500">Roster Administration</span>
        </>
      )}
    </p>
    <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
      Member Directory
    </h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-600">
      Connect with fellow singers and section leaders, review vocal part assignments, and message ensemble sections via Bcc.
    </p>
  </header>

  <RosterDirectory
    client:load
    caller={singer}
    initialRoster={roster}
    sheetWarnings={sheetWarnings}
    masterSheetUrl={workspace.masterSheetUrl}
    initialViewMode={initialViewMode}
  />
</PortalLayout>

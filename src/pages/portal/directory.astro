---
import PortalLayout from '../../layouts/PortalLayout.astro';
import RosterDirectory from '../../components/portal/RosterDirectory';
import {
  getAllSheetWarnings,
  getPortalConfig,
  getRoster,
  getWorkspaceLinks,
} from '../../lib/google';

const singer = Astro.locals.singer;
if (!singer) {
  return Astro.redirect('/login');
}

const isAdmin = singer.role === 'Admin';

const [config, roster, sheetWarnings] = await Promise.all([
  getPortalConfig(Astro.locals),
  getRoster(Astro.locals),
  getAllSheetWarnings(Astro.locals),
]);

const workspace = getWorkspaceLinks(isAdmin, config, Astro.locals);
const initialViewMode = Astro.url.searchParams.get('view') === 'table' ? 'table' : 'cards';
---

<PortalLayout title="Roster & Directory">
  <div class="mb-5">
    <div class="flex items-center gap-2">
      <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
        Choir Ensemble
      </span>
      {isAdmin && (
        <span class="rounded-sm bg-navy-900 px-2 py-0.5 text-xs font-medium text-gold-300">
          Admin Enabled
        </span>
      )}
    </div>
    <h1 class="mt-1 font-editorial text-3xl font-medium text-navy-950 sm:text-4xl">
      Roster &amp; Member Directory
    </h1>
    <p class="mt-1.5 text-sm sm:text-base leading-relaxed text-stone-600">
      Contact active singers and section leaders, review section assignments, and manage ensemble member status.
    </p>
  </div>

  <RosterDirectory
    client:load
    caller={singer}
    initialRoster={roster}
    sheetWarnings={sheetWarnings}
    masterSheetUrl={workspace.masterSheetUrl}
    initialViewMode={initialViewMode}
  />
</PortalLayout>

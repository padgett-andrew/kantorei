---
import PortalLayout from '../../layouts/PortalLayout.astro';
import DirectoryList from '../../components/portal/DirectoryList';
import { getRoster } from '../../lib/google';

const roster = await getRoster(Astro.locals);
const activeMembers = roster
  .filter((m) => m.active)
  .sort((a, b) => a.name.localeCompare(b.name));
---

<PortalLayout title="Member Directory">
  <div class="mb-6">
    <span class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-500">
      Active Season Roster
    </span>
    <h1 class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
      Ensemble Member Directory
    </h1>
    <p class="mt-1 text-sm text-zinc-600">
      Contact fellow singers and section leaders for carpools, score markings, or sectional coordination.
    </p>
  </div>

  <DirectoryList client:load members={activeMembers} />
</PortalLayout>


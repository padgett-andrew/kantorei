---
import PortalLayout from '../../layouts/PortalLayout.astro';
import SeatingChartManager from '../../components/portal/seating/SeatingChartManager';
import {
  getAbsences,
  getConcerts,
  getPortalConfig,
  getRoster,
  getSchedule,
  getSeatingCharts,
} from '../../lib/google';
import { getTodayIso } from '../../lib/utils';
import type { SeatingMode } from '../../components/portal/seating/types';

const singer = Astro.locals.singer;
if (!singer) {
  return Astro.redirect('/login');
}

const isAdmin = singer.role === 'Admin';
const isSectionLeader = singer.role === 'Section_Leader';
const canTakeAttendance = isAdmin || isSectionLeader;

const [config, roster, schedule, absences, allCharts, concerts] = await Promise.all([
  getPortalConfig(Astro.locals),
  getRoster(Astro.locals),
  getSchedule(Astro.locals),
  getAbsences(Astro.locals),
  getSeatingCharts(Astro.locals),
  getConcerts(Astro.locals),
]);

// Non-admins and non-section-leaders only see published charts
const visibleCharts = allCharts.filter((c) => {
  if (c.status === 'Published') return true;
  return canTakeAttendance;
});

const today = getTodayIso(config.Calendar_Timezone || 'America/Chicago');
const upcomingEvents = schedule.filter((ev) => ev.date >= today);

// URL parameters
const requestedMode = Astro.url.searchParams.get('mode') as SeatingMode | null;
const initialMode: SeatingMode =
  requestedMode === 'attendance' && canTakeAttendance
    ? 'attendance'
    : requestedMode === 'edit' && isAdmin
    ? 'edit'
    : 'view';

const initialChartId = Astro.url.searchParams.get('chartId') || undefined;
const initialEventId = Astro.url.searchParams.get('eventId') || undefined;
const currentSeason = '2026–2027';
---

<PortalLayout title="Seating & Standing Chart">
  <header class="mb-8">
    <p class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
      <span>Stage Formation &amp; Roll Call</span>
      {isAdmin && (
        <>
          <span class="text-stone-300" aria-hidden="true">/</span>
          <span class="text-stone-500">Formation Editor Access</span>
        </>
      )}
    </p>
    <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
      Seating &amp; Standing Chart
    </h1>
    <p class="mt-2 max-w-2xl text-sm leading-relaxed text-stone-600">
      Locate your position and neighboring singers, toggle between conductor and stage perspectives, and record rehearsal roll call.
    </p>
  </header>

  <SeatingChartManager
    client:load
    caller={singer}
    initialCharts={visibleCharts}
    roster={roster}
    upcomingEvents={upcomingEvents}
    allScheduleEvents={schedule}
    initialAbsences={absences}
    concerts={concerts}
    currentSeason={currentSeason}
    initialMode={initialMode}
    initialChartId={initialChartId}
    initialEventId={initialEventId}
  />
</PortalLayout>

---
import PortalLayout from '../../layouts/PortalLayout.astro';
import { getHandbookHtml, getStrategicPlanHtml } from '../../lib/google';

const docParam = Astro.url.searchParams.get('doc');
const activeDoc = docParam === 'strategic-plan' ? 'strategic-plan' : 'handbook';

const { html, isDemo } =
  activeDoc === 'strategic-plan'
    ? await getStrategicPlanHtml(Astro.locals)
    : await getHandbookHtml(Astro.locals);
---

<PortalLayout
  title={activeDoc === 'strategic-plan' ? '2026–2036 Strategic Vision' : 'Singer Handbook'}
>
  <div class="mb-6 flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="text-xs font-semibold uppercase tracking-[0.16em] text-gold-500">
        {activeDoc === 'strategic-plan'
          ? '10-Year Ensemble Roadmap & Goals'
          : 'Policies, Roster Leadership, Attire & Rehearsal Standards'}
      </span>
      <h1 class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
        {activeDoc === 'strategic-plan'
          ? 'Strategic Vision (2026–2036)'
          : 'Singer Handbook (2026–2027)'}
      </h1>
    </div>

    <div class="flex flex-wrap items-center gap-2">
      {activeDoc === 'strategic-plan' && isDemo && (
        <span class="rounded-full border border-amber-300 bg-amber-50 px-3 py-1 text-xs font-semibold text-amber-900">
          Singer Review Working Draft
        </span>
      )}
      {!isDemo && (
        <span class="rounded-full bg-emerald-100 px-3 py-1 text-xs font-semibold text-emerald-800">
          Synced Live from Google Docs
        </span>
      )}
    </div>
  </div>

  <!-- Document Switcher: Singer Handbook vs. 2026-2036 Strategic Vision -->
  <div
    class="mb-6 inline-flex flex-wrap gap-1.5 rounded-2xl border border-zinc-200 bg-zinc-100/80 p-1.5"
    role="tablist"
    aria-label="Member Documents"
  >
    <a
      href="/portal/handbook"
      role="tab"
      aria-selected={activeDoc === 'handbook'}
      class:list={[
        'rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider transition',
        activeDoc === 'handbook'
          ? 'bg-navy-950 text-white shadow-2xs'
          : 'text-zinc-600 hover:bg-white/70 hover:text-navy-950',
      ]}
    >
      2026–2027 Singer Handbook
    </a>
    <a
      href="/portal/handbook?doc=strategic-plan"
      role="tab"
      aria-selected={activeDoc === 'strategic-plan'}
      class:list={[
        'inline-flex items-center gap-2 rounded-xl px-4 py-2 text-xs font-bold uppercase tracking-wider transition',
        activeDoc === 'strategic-plan'
          ? 'bg-navy-950 text-white shadow-2xs'
          : 'text-zinc-600 hover:bg-white/70 hover:text-navy-950',
      ]}
    >
      <span>2026–2036 Strategic Plan</span>
      <span
        class:list={[
          'rounded-full px-2 py-0.5 text-[10px] font-bold',
          activeDoc === 'strategic-plan'
            ? 'bg-gold-500 text-white'
            : 'bg-amber-100 text-amber-900',
        ]}
      >
        Draft
      </span>
    </a>
  </div>

  <article
    class="handbook-prose rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs sm:p-10"
    set:html={html}
  />
</PortalLayout>


---
import PortalLayout from '../../layouts/PortalLayout.astro';
import AdminGuideContent from '../../../docs/admin-guide.md';
import { getHandbookHtml, getStrategicPlanHtml } from '../../lib/google';
import { hasRole } from '../../lib/auth';

const singer = Astro.locals.singer;
const isAdminOrLeader = singer ? hasRole(singer, ['Section_Leader', 'Admin']) : false;

const docParam = Astro.url.searchParams.get('doc');
let activeDoc: 'handbook' | 'strategic-plan' | 'admin-guide' = 'handbook';

if (docParam === 'strategic-plan') {
  activeDoc = 'strategic-plan';
} else if (docParam === 'admin-guide' && isAdminOrLeader) {
  activeDoc = 'admin-guide';
}

const { html, isDemo } =
  activeDoc === 'strategic-plan'
    ? await getStrategicPlanHtml(Astro.locals)
    : activeDoc === 'admin-guide'
      ? { html: '', isDemo: false }
      : await getHandbookHtml(Astro.locals);

const pageTitle =
  activeDoc === 'admin-guide'
    ? 'Board & Operations Manual'
    : activeDoc === 'strategic-plan'
      ? '2026–2036 Strategic Vision'
      : 'Singer Handbook & Bylaws';

const subtitle =
  activeDoc === 'admin-guide'
    ? 'Board, Section Leaders & Staff Reference'
    : activeDoc === 'strategic-plan'
      ? 'Ten-Year Artistic & Organizational Roadmap'
      : 'Ensemble Policies, Rehearsal Standards & Concert Attire';
---

<PortalLayout title={pageTitle}>
  <header class="mb-8">
    <p class="flex flex-wrap items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
      <span>{subtitle}</span>
      {activeDoc === 'admin-guide' && (
        <>
          <span class="text-stone-300" aria-hidden="true">/</span>
          <span class="text-stone-500">Leadership Edition</span>
        </>
      )}
      {activeDoc === 'strategic-plan' && isDemo && (
        <>
          <span class="text-stone-300" aria-hidden="true">/</span>
          <span class="text-stone-500">Member Review Draft</span>
        </>
      )}
    </p>
    <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
      {pageTitle}
    </h1>
  </header>

  <!-- Editorial Underline Document Tabs -->
  <nav
    class="mb-8 flex flex-wrap items-center gap-x-7 gap-y-2 border-b border-stone-200/90"
    role="tablist"
    aria-label="Ensemble Documents"
  >
    <a
      href="/portal/handbook"
      role="tab"
      aria-selected={activeDoc === 'handbook'}
      class:list={[
        'relative pb-3 text-xs font-semibold uppercase tracking-[0.16em] transition',
        activeDoc === 'handbook'
          ? 'text-navy-950'
          : 'text-stone-500 hover:text-navy-950',
      ]}
    >
      <span>2026–2027 Singer Handbook</span>
      {activeDoc === 'handbook' && (
        <span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-copper-600"></span>
      )}
    </a>

    <a
      href="/portal/handbook?doc=strategic-plan"
      role="tab"
      aria-selected={activeDoc === 'strategic-plan'}
      class:list={[
        'relative inline-flex items-center gap-2 pb-3 text-xs font-semibold uppercase tracking-[0.16em] transition',
        activeDoc === 'strategic-plan'
          ? 'text-navy-950'
          : 'text-stone-500 hover:text-navy-950',
      ]}
    >
      <span>2026–2036 Strategic Plan</span>
      <span class="rounded-sm border border-[#e6d5bc] bg-[#f8efe2] px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-[#7d5220]">
        Draft
      </span>
      {activeDoc === 'strategic-plan' && (
        <span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-copper-600"></span>
      )}
    </a>

    {isAdminOrLeader && (
      <a
        href="/portal/handbook?doc=admin-guide"
        role="tab"
        aria-selected={activeDoc === 'admin-guide'}
        class:list={[
          'relative inline-flex items-center gap-2 pb-3 text-xs font-semibold uppercase tracking-[0.16em] transition',
          activeDoc === 'admin-guide'
            ? 'text-navy-950'
            : 'text-stone-500 hover:text-navy-950',
        ]}
      >
        <span>Board &amp; Operations Manual</span>
        <span class="rounded-sm border border-stone-200 bg-[#FAF7F2] px-1.5 py-0.5 text-[9px] font-semibold uppercase tracking-[0.12em] text-stone-600">
          Leadership
        </span>
        {activeDoc === 'admin-guide' && (
          <span class="absolute inset-x-0 bottom-0 h-[1.5px] bg-copper-600"></span>
        )}
      </a>
    )}
  </nav>

  {activeDoc === 'admin-guide' ? (
    <article class="rounded-sm border border-stone-200/90 bg-white px-6 py-8 sm:px-12 sm:py-12">
      <div class="handbook-prose max-w-3xl">
        <AdminGuideContent />
      </div>
    </article>
  ) : (
    <article class="rounded-sm border border-stone-200/90 bg-white px-6 py-8 sm:px-12 sm:py-12">
      <div class="handbook-prose max-w-3xl" set:html={html} />
    </article>
  )}
</PortalLayout>

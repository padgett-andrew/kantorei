---
import PortalLayout from '../../layouts/PortalLayout.astro';
import CalendarSubscribeModal from '../../components/portal/CalendarSubscribeModal';
import CalendarAdminControls from '../../components/portal/CalendarAdminControls';
import LocationDirectionsButton from '../../components/common/LocationDirectionsButton';
import QuickLateNoticeModal from '../../components/portal/QuickLateNoticeModal';
import { getCalendarFeedToken } from '../../lib/calendar';
import { getCalendarId } from '../../lib/env';
import {
  getAbsences,
  getPortalConfig,
  getRepertoire,
  getSchedule,
  getSeatingCharts,
} from '../../lib/google';
import { findSingerSeatInChart, parseSnackEntry } from '../../types/choir';
import {
  eventTypeBadgeColor,
  formatEventDate,
  formatShortMonthDay,
  getTodayIso,
} from '../../lib/utils';

const singer = Astro.locals.singer!;
const [config, schedule, absences, repertoire, feedToken, seatingCharts] = await Promise.all([
  getPortalConfig(Astro.locals),
  getSchedule(Astro.locals),
  getAbsences(Astro.locals),
  getRepertoire(Astro.locals),
  getCalendarFeedToken(Astro.locals),
  getSeatingCharts(Astro.locals),
]);

const isAdmin = singer.role === 'Admin';
const calendarId = getCalendarId(Astro.locals);

const today = getTodayIso(config.Calendar_Timezone || 'America/Chicago');
const upcomingEvents = schedule.filter((ev) => ev.date >= today);
const nextEvent = upcomingEvents[0];
const isCallToday = Boolean(nextEvent && nextEvent.date === today);

const myUpcomingConflicts = absences.filter(
  (a) =>
    a.singerEmail === singer.email &&
    (a.status === 'Absent' || a.status === 'Late') &&
    a.date >= today
);
const myUpcomingAbsences = myUpcomingConflicts.filter((a) => a.status === 'Absent');
const myUpcomingLates = myUpcomingConflicts.filter((a) => a.status === 'Late');

const nextEventConflict = nextEvent
  ? absences.find(
      (a) =>
        a.singerEmail === singer.email &&
        a.eventId === nextEvent.eventId &&
        (a.status === 'Absent' || a.status === 'Late')
    )
  : undefined;

const mySnackDates = upcomingEvents.filter((ev) =>
  [ev.snack1Name, ev.snack2Name, ev.snack3Name, ev.snack4Name].some(
    (raw) => parseSnackEntry(raw).name.toLowerCase() === singer.name.toLowerCase()
  )
);

const openSnackSlotsCount = upcomingEvents.reduce(
  (acc, ev) =>
    acc +
    (ev.snack1Name ? 0 : 1) +
    (ev.snack2Name ? 0 : 1) +
    (ev.snack3Name ? 0 : 1) +
    (ev.snack4Name ? 0 : 1),
  0
);

const totalScoreFiles = repertoire.reduce(
  (sum, p) => sum + p.files.filter((f) => !f.isDoc).length,
  0
);
const totalMarkingsDocs = repertoire.reduce(
  (sum, p) => sum + p.files.filter((f) => f.isDoc).length,
  0
);
const uniqueConcertPrograms = new Set(
  repertoire.map((p) => p.concertTitle || p.title)
).size;

const isOnLeave = singer.status === 'On_Leave';

const publishedCharts = seatingCharts.filter((c) => c.status === 'Published');
const primaryChart = publishedCharts[0];
const mySeatLocation = primaryChart ? findSingerSeatInChart(primaryChart, singer.email) : null;

const httpsFeedUrl = `${Astro.url.origin}/api/calendar.ics?token=${feedToken}`;
const webcalFeedUrl = httpsFeedUrl.replace(/^https?:\/\//i, 'webcal://');
---

<PortalLayout title="Overview">
  <div class="space-y-6 sm:space-y-7">
    <!-- Season Leave (Asleep) Status Notice -->
    {isOnLeave && (
      <div class="flex items-start gap-3.5 rounded-2xl border border-indigo-200 bg-indigo-50/90 px-5 py-4 text-sm text-indigo-950 shadow-2xs">
        <span class="mt-0.5 text-lg leading-none">🌙</span>
        <div>
          <p class="font-semibold text-indigo-950">Season Leave Active (Skipping Current Cycle)</p>
          <p class="mt-0.5 text-xs leading-relaxed text-indigo-800">
            You’re currently paused from rehearsal roll call and season absence alerts, while keeping full access to future scores, schedules, and the Singer Handbook.
          </p>
        </div>
      </div>
    )}

    <!-- Optional Board Announcement Banner from Config Sheet -->
    {config.Portal_Announcement && (
      <div class="flex flex-col gap-2 rounded-2xl border border-gold-400/40 bg-gradient-to-r from-amber-50/90 to-[#FAF7F2] px-5 py-3.5 text-sm text-navy-950 shadow-xs sm:flex-row sm:items-center sm:gap-3">
        <span class="w-fit shrink-0 rounded-sm bg-navy-900 px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-gold-300">
          Season Note
        </span>
        <span class="text-sm font-medium leading-relaxed text-stone-800">
          {config.Portal_Announcement}
        </span>
      </div>
    )}

    <!-- Greeting & Calendar Sync Row -->
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
      <div>
        <div class="flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center rounded-sm bg-white px-2.5 py-0.5 text-xs font-semibold uppercase tracking-wider text-copper-600 border border-stone-200/80 shadow-2xs">
            {singer.sectionGroup} Section · {singer.voicePart}
          </span>
        </div>
        <h1 class="mt-1.5 font-editorial text-3xl font-medium tracking-tight text-navy-950 sm:text-4xl">
          Welcome back, {singer.name.split(' ')[0]}
        </h1>
      </div>

      <CalendarSubscribeModal
        client:load
        httpsFeedUrl={httpsFeedUrl}
        webcalFeedUrl={webcalFeedUrl}
      />
    </div>

    <!-- Next Rehearsal Hero Card + Modern Quick Action Tiles -->
    <div class="grid gap-5 lg:grid-cols-12">
      <!-- Left: Next Call Hero -->
      <div class="relative overflow-hidden rounded-2xl border border-stone-200/80 bg-white p-6 shadow-xs sm:p-7 lg:col-span-7 flex flex-col justify-between">
        <div class="relative">
          <div class="flex items-center justify-between gap-2">
            <span
              class:list={[
                'text-xs font-semibold uppercase tracking-[0.18em]',
                isCallToday ? 'text-amber-700 flex items-center gap-1.5' : 'text-copper-600',
              ]}
            >
              {isCallToday && <span class="h-2 w-2 rounded-full bg-amber-500 animate-pulse" />}
              {isCallToday ? 'Today’s Ensemble Call' : 'Next Ensemble Call'}
            </span>
            {nextEvent && (
              <span class="rounded-full border border-stone-200/80 bg-[#FAF7F2] px-3 py-0.5 text-xs font-semibold text-navy-950">
                {nextEvent.type}
              </span>
            )}
          </div>

          {nextEvent ? (
            <div class="mt-4">
              <h2 class="font-editorial text-3xl font-semibold text-navy-950 sm:text-4xl">
                {nextEvent.title}
              </h2>
              <div class="mt-3 flex flex-wrap items-center gap-x-4 gap-y-2 text-sm">
                <span class="font-serif font-semibold text-navy-950">
                  🗓 {isCallToday ? 'Today · ' : ''}{formatEventDate(nextEvent.date)} · {nextEvent.time}
                </span>
                <LocationDirectionsButton
                  client:load
                  location={nextEvent.location}
                  variant="badge"
                />
              </div>

              {nextEvent.notes && (
                <div class="mt-4 rounded-xl border border-stone-200/70 bg-[#FAF7F2] p-4 text-sm leading-relaxed text-stone-700">
                  <span class="font-semibold uppercase tracking-wider text-copper-600 text-xs block mb-1">
                    Call Details &amp; Rehearsal Focus
                  </span>
                  <p class="whitespace-pre-line leading-relaxed text-stone-700">
                    {nextEvent.notes}
                  </p>
                </div>
              )}

              {nextEventConflict && (
                <div
                  class:list={[
                    'mt-4 flex items-start gap-2.5 rounded-xl border p-3.5 text-xs sm:text-sm font-semibold',
                    nextEventConflict.status === 'Late'
                      ? 'border-amber-300 bg-amber-50 text-amber-950'
                      : 'border-rose-300 bg-rose-50 text-rose-950',
                  ]}
                >
                  <span class="text-base mt-0.5">{nextEventConflict.status === 'Late' ? '⏰' : '🔴'}</span>
                  <div>
                    <span class="font-bold">
                      {nextEventConflict.status === 'Late'
                        ? 'Running Late Notice Active'
                        : 'Absence Reported for this Call'}
                    </span>
                    <p class="mt-0.5 opacity-90 text-xs font-normal">
                      {nextEventConflict.reason || (nextEventConflict.status === 'Late' ? 'Running late' : 'Absence recorded')}
                    </p>
                  </div>
                </div>
              )}
            </div>
          ) : (
            <p class="mt-4 text-sm text-stone-500">
              No upcoming rehearsals are posted on the Schedule tab right now.
            </p>
          )}
        </div>

        <div class="relative mt-6 flex flex-wrap items-center gap-3 pt-2">
          <a
            href="/portal/music"
            class="inline-flex items-center justify-center rounded-sm bg-copper-500 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition hover:bg-copper-600"
          >
            Open Digital Scores ({totalScoreFiles})
          </a>
          {nextEvent && (
            <QuickLateNoticeModal
              client:load
              eventId={nextEvent.eventId}
              eventTitle={nextEvent.title}
              eventDate={nextEvent.date}
              sectionGroup={singer.sectionGroup}
              buttonLabel={
                nextEventConflict
                  ? nextEventConflict.status === 'Late'
                    ? 'Update Late ETA'
                    : 'Update Absence'
                  : isCallToday
                  ? 'Running Late? Send 1-Tap Notice'
                  : 'Report Conflict / Late'
              }
            />
          )}
        </div>
      </div>

      <!-- Right: Clean, Modern Status & Action Cards -->
      <div class="flex flex-col gap-3.5 lg:col-span-5">
        <!-- 1. Attendance Status Card (Positive, Clear UX — No Weird "0 Absences") -->
        <a
          href="/portal/absences"
          class="group flex items-start justify-between gap-4 rounded-xl border border-stone-200/80 bg-white p-4.5 shadow-xs transition hover:border-gold-400/60 hover:shadow-sm sm:p-5"
        >
          <div class="flex items-start gap-3.5">
            <span
              class:list={[
                'flex h-10 w-10 shrink-0 items-center justify-center rounded-sm text-base font-bold ring-1',
                myUpcomingConflicts.length === 0
                  ? 'bg-emerald-50 text-emerald-700 ring-emerald-200/80'
                  : myUpcomingAbsences.length > 0
                  ? 'bg-rose-50 text-rose-700 ring-rose-200/80'
                  : 'bg-amber-50 text-amber-700 ring-amber-200/80',
              ]}
            >
              {myUpcomingConflicts.length === 0 ? '✓' : myUpcomingConflicts.length}
            </span>
            <div>
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
                Attendance
              </span>
              <h3 class="mt-0.5 font-sans text-base font-bold text-navy-950">
                {myUpcomingConflicts.length === 0
                  ? 'Attending All Upcoming Calls'
                  : myUpcomingAbsences.length > 0 && myUpcomingLates.length > 0
                  ? `${myUpcomingAbsences.length} Absence, ${myUpcomingLates.length} Late Notice`
                  : myUpcomingAbsences.length > 0
                  ? `${myUpcomingAbsences.length} Absence${myUpcomingAbsences.length > 1 ? 's' : ''} Logged`
                  : `${myUpcomingLates.length} Late Notice${myUpcomingLates.length > 1 ? 's' : ''} Logged`}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-stone-600">
                {myUpcomingConflicts.length === 0
                  ? `Marked present across all ${upcomingEvents.length} scheduled dates.`
                  : `Next notice: ${formatEventDate(myUpcomingConflicts[0].date)} (${
                      myUpcomingConflicts[0].status === 'Late' ? 'Running Late' : 'Absent'
                    })`}
              </p>
            </div>
          </div>
          <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-copper-600 transition group-hover:translate-x-0.5">
            {myUpcomingConflicts.length === 0 ? 'Log' : 'Edit'} →
          </span>
        </a>

        <!-- 2. Duties & Hospitality Signup Card -->
        <a
          href="/portal/snacks"
          class="group flex items-start justify-between gap-4 rounded-xl border border-stone-200/80 bg-white p-4.5 shadow-xs transition hover:border-gold-400/60 hover:shadow-sm sm:p-5"
        >
          <div class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-copper-50 text-base text-copper-600 ring-1 ring-copper-200/60">
              ☕
            </span>
            <div>
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
                Duties &amp; Hospitality
              </span>
              <h3 class="mt-0.5 font-sans text-base font-bold text-navy-950">
                {mySnackDates.length > 0
                  ? `${mySnackDates.length} Signup${mySnackDates.length > 1 ? 's' : ''} Claimed`
                  : 'Duty & Snack Signups'}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-stone-600">
                {mySnackDates.length > 0
                  ? `Your next call: ${formatEventDate(mySnackDates[0].date)}`
                  : `${openSnackSlotsCount} open duty & hospitality slots available.`}
              </p>
            </div>
          </div>
          <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-copper-600 transition group-hover:translate-x-0.5">
            Claim →
          </span>
        </a>

        <!-- 3. Digital Music Folder Summary Card -->
        <a
          href="/portal/music"
          class="group flex items-start justify-between gap-4 rounded-xl border border-stone-200/80 bg-white p-4.5 shadow-xs transition hover:border-gold-400/60 hover:shadow-sm sm:p-5"
        >
          <div class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-navy-950 text-sm font-bold text-gold-300">
              ♫
            </span>
            <div>
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
                Music Library
              </span>
              <h3 class="mt-0.5 font-sans text-base font-bold text-navy-950">
                {totalScoreFiles} Scores & Part Tracks
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-stone-600">
                {uniqueConcertPrograms} active concert folder{uniqueConcertPrograms === 1 ? '' : 's'}
                {totalMarkingsDocs > 0 ? ' · Director markings' : ''} · Tablet & print ready.
              </p>
            </div>
          </div>
          <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-copper-600 transition group-hover:translate-x-0.5">
            Open →
          </span>
        </a>

        <!-- 4. Choir Formation & Seating Card -->
        <a
          href="/portal/seating"
          class="group flex items-start justify-between gap-4 rounded-xl border border-stone-200/80 bg-white p-4.5 shadow-xs transition hover:border-gold-400/60 hover:shadow-sm sm:p-5"
        >
          <div class="flex items-start gap-3.5">
            <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-sm bg-stone-100 text-sm font-bold text-stone-700 ring-1 ring-stone-200/80">
              🪑
            </span>
            <div>
              <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
                Seating &amp; Attendance
              </span>
              <h3 class="mt-0.5 font-sans text-base font-bold text-navy-950">
                {mySeatLocation
                  ? `${mySeatLocation.rowName}, Seat #${mySeatLocation.seatIndex}`
                  : `${publishedCharts.length} Formation Chart${publishedCharts.length === 1 ? '' : 's'}`}
              </h3>
              <p class="mt-1 text-sm leading-relaxed text-stone-600">
                {mySeatLocation
                  ? `${mySeatLocation.chartTitle} · Voice part ${mySeatLocation.voicePart || singer.voicePart}`
                  : 'View published concert seating charts & choir positions.'}
              </p>
            </div>
          </div>
          <span class="shrink-0 text-xs font-semibold uppercase tracking-wider text-copper-600 transition group-hover:translate-x-0.5">
            View →
          </span>
        </a>
      </div>
    </div>

    <!-- Full Upcoming Rehearsal & Concert Schedule -->
    <section class="overflow-hidden rounded-2xl border border-stone-200/80 bg-white shadow-xs">
      <div class="flex flex-wrap items-center justify-between gap-3 border-b border-stone-200/60 px-5 py-4 sm:px-6">
        <div>
          <h2 class="font-editorial text-2xl font-bold text-navy-950">
            Upcoming Schedule
          </h2>
          <p class="mt-0.5 text-sm text-stone-600">
            Ensemble rehearsal calls, dress rehearsals, and concert times
          </p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
          {isAdmin && (
            <CalendarAdminControls client:load calendarId={calendarId} />
          )}
          <span class="rounded-sm bg-[#FAF7F2] border border-stone-200/80 px-3 py-1 text-xs font-semibold text-navy-950">
            {upcomingEvents.length} calls
          </span>
        </div>
      </div>

      <ul class="divide-y divide-stone-200/60">
        {upcomingEvents.map((ev) => {
          const { weekday, month, day } = formatShortMonthDay(ev.date);
          const isAbsent = myUpcomingAbsences.some((a) => a.eventId === ev.eventId);

          return (
            <li class="flex flex-col gap-3 px-5 py-4 transition hover:bg-[#FAF7F2]/60 sm:flex-row sm:items-start sm:justify-between sm:px-6">
              <div class="flex items-start gap-4">
                <div class="flex h-14 w-14 shrink-0 flex-col items-center justify-center rounded-xl border border-stone-200/80 bg-[#FAF7F2] text-center shadow-2xs">
                  <span class="text-xs font-semibold uppercase tracking-wider text-copper-600">
                    {month}
                  </span>
                  <span class="text-lg font-bold leading-tight text-navy-950">{day}</span>
                  <span class="text-xs font-medium text-stone-500">{weekday}</span>
                </div>

                <div class="min-w-0">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-sans text-base font-bold text-navy-950">
                      {ev.title}
                    </h3>
                    <span
                      class={`rounded-full border px-2.5 py-0.5 text-xs font-semibold ${eventTypeBadgeColor(
                        ev.type
                      )}`}
                    >
                      {ev.type}
                    </span>
                    {isAbsent && (
                      <span class="rounded-full bg-rose-100 px-2.5 py-0.5 text-xs font-semibold text-rose-800">
                        Marked Absent
                      </span>
                    )}
                  </div>
                  <div class="mt-1 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-stone-600">
                    <span class="font-semibold text-navy-900">{ev.time}</span>
                    <LocationDirectionsButton client:load location={ev.location} />
                  </div>
                  {ev.notes && (
                    <div class="mt-2 whitespace-pre-line rounded-lg border border-stone-200/70 bg-[#FAF7F2] px-3.5 py-2 text-sm leading-relaxed text-stone-700">
                      {ev.notes}
                    </div>
                  )}
                </div>
              </div>

              <div class="flex flex-wrap items-center gap-2 sm:flex-col sm:items-end">
                <QuickLateNoticeModal
                  client:load
                  eventId={ev.eventId}
                  eventTitle={ev.title}
                  eventDate={ev.date}
                  sectionGroup={singer.sectionGroup}
                  buttonLabel={isAbsent ? 'Edit Notice' : 'Report Conflict / Late'}
                  buttonVariant="ghost"
                />

                {(ev.snack1Name || ev.snack2Name || ev.snack3Name || ev.snack4Name) && (
                  <div class="shrink-0 rounded-lg bg-[#FAF7F2] border border-stone-200/60 px-3 py-1.5 text-xs text-stone-600 sm:text-right">
                    <span class="block text-xs font-semibold uppercase tracking-wider text-copper-600">
                      {ev.type === 'Concert' || ev.type === 'Dress' ? 'Volunteer Crew' : 'Hospitality'}
                    </span>
                    <span class="font-medium text-navy-950">
                      {[ev.snack1Name, ev.snack2Name, ev.snack3Name, ev.snack4Name]
                        .filter(Boolean)
                        .map((s) => parseSnackEntry(s).name)
                        .join(', ')}
                    </span>
                  </div>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  </div>
</PortalLayout>

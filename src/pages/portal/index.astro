---
import PortalLayout from '../../layouts/PortalLayout.astro';
import CalendarSubscribeModal from '../../components/portal/CalendarSubscribeModal';
import CalendarAdminControls from '../../components/portal/CalendarAdminControls';
import LocationDirectionsButton from '../../components/common/LocationDirectionsButton';
import QuickLateNoticeModal from '../../components/portal/QuickLateNoticeModal';
import { getCalendarFeedToken } from '../../lib/calendar';
import { getCalendarId } from '../../lib/env';
import {
  getAbsences,
  getBulletinMessages,
  getPortalConfig,
  getRepertoire,
  getRoster,
  getSchedule,
  getSeatingCharts,
} from '../../lib/google';
import { findSingerSeatInChart, parseSnackEntry } from '../../types/choir';
import {
  eventTypeBadgeColor,
  formatEventDate,
  formatShortMonthDay,
  getTodayIso,
} from '../../lib/utils';

const singer = Astro.locals.singer!;
const [config, schedule, absences, repertoire, feedToken, seatingCharts, bulletinMessages, roster] =
  await Promise.all([
    getPortalConfig(Astro.locals),
    getSchedule(Astro.locals),
    getAbsences(Astro.locals),
    getRepertoire(Astro.locals),
    getCalendarFeedToken(Astro.locals),
    getSeatingCharts(Astro.locals),
    getBulletinMessages(Astro.locals),
    getRoster(Astro.locals),
  ]);

const sectionLeaders = singer.sectionGroup
  ? roster
      .filter(
        (s) => s.active && s.role === 'Section_Leader' && s.sectionGroup === singer.sectionGroup
      )
      .map((s) => s.name)
  : [];
const conductorName = config.Conductor_Name || 'Adam Reinwald';

const latestDispatch = bulletinMessages[0];

const isAdmin = singer.role === 'Admin';
const calendarId = getCalendarId(Astro.locals);

const today = getTodayIso(config.Calendar_Timezone || 'America/Chicago');
const upcomingEvents = schedule.filter((ev) => ev.date >= today);
const nextEvent = upcomingEvents[0];
const isCallToday = Boolean(nextEvent && nextEvent.date === today);

const myUpcomingConflicts = absences.filter(
  (a) =>
    a.singerEmail === singer.email &&
    (a.status === 'Absent' || a.status === 'Late') &&
    a.date >= today
);
const myUpcomingAbsences = myUpcomingConflicts.filter((a) => a.status === 'Absent');
const myUpcomingLates = myUpcomingConflicts.filter((a) => a.status === 'Late');

const nextEventConflict = nextEvent
  ? absences.find(
      (a) =>
        a.singerEmail === singer.email &&
        a.eventId === nextEvent.eventId &&
        (a.status === 'Absent' || a.status === 'Late')
    )
  : undefined;

const mySnackDates = upcomingEvents.filter((ev) =>
  [ev.snack1Name, ev.snack2Name, ev.snack3Name, ev.snack4Name].some(
    (raw) => parseSnackEntry(raw).name.toLowerCase() === singer.name.toLowerCase()
  )
);

const openSnackSlotsCount = upcomingEvents.reduce(
  (acc, ev) =>
    acc +
    (ev.snack1Name ? 0 : 1) +
    (ev.snack2Name ? 0 : 1) +
    (ev.snack3Name ? 0 : 1) +
    (ev.snack4Name ? 0 : 1),
  0
);

const totalScoreFiles = repertoire.reduce(
  (sum, p) => sum + p.files.filter((f) => !f.isDoc).length,
  0
);
const totalMarkingsDocs = repertoire.reduce(
  (sum, p) => sum + p.files.filter((f) => f.isDoc).length,
  0
);
const uniqueConcertPrograms = new Set(
  repertoire.map((p) => p.concertTitle || p.title)
).size;

const isOnLeave = singer.status === 'On_Leave';

const publishedCharts = seatingCharts.filter((c) => c.status === 'Published');
const primaryChart = publishedCharts[0];
const mySeatLocation = primaryChart ? findSingerSeatInChart(primaryChart, singer.email) : null;

const httpsFeedUrl = `${Astro.url.origin}/api/calendar.ics?token=${feedToken}`;
const webcalFeedUrl = httpsFeedUrl.replace(/^https?:\/\//i, 'webcal://');
---

<PortalLayout title="Overview">
  <div class="space-y-10 sm:space-y-12">
    {/* Season Leave Status Notice */}
    {isOnLeave && (
      <div class="border-l-2 border-copper-500 bg-[#f5efe8] px-5 py-4">
        <p class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
          Season Leave Active
        </p>
        <p class="mt-1 text-sm leading-relaxed text-stone-700">
          You are paused from rehearsal roll call and absence alerts for the current cycle while retaining full access to scores, schedules, and ensemble documents.
        </p>
      </div>
    )}

    {/* Optional Board Announcement Banner from Config Sheet */}
    {config.Portal_Announcement && (
      <div class="flex flex-col gap-1.5 border-y border-stone-300/80 bg-[#f5efe8]/70 px-4 py-3.5 sm:flex-row sm:items-baseline sm:gap-4">
        <span class="shrink-0 text-[10px] font-semibold uppercase tracking-[0.2em] text-copper-600">
          Season Note
        </span>
        <p class="text-sm leading-relaxed text-stone-800">
          {config.Portal_Announcement}
        </p>
      </div>
    )}

    {/* Editorial Masthead & Calendar Subscription */}
    <header class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <p class="text-[11px] font-semibold uppercase tracking-[0.2em] text-copper-600">
          {singer.sectionGroup && singer.voicePart
            ? `${singer.sectionGroup} Section · ${singer.voicePart}`
            : singer.role === 'Admin'
              ? 'Artistic Staff & Administration'
              : singer.role.replace('_', ' ')}
        </p>
        <h1 class="mt-2 font-editorial text-4xl font-normal tracking-tight text-navy-950 sm:text-5xl">
          Welcome back, {singer.name.split(' ')[0]}
        </h1>
      </div>

      <CalendarSubscribeModal
        client:load
        httpsFeedUrl={httpsFeedUrl}
        webcalFeedUrl={webcalFeedUrl}
      />
    </header>

    {/* Full-Width Editorial Call Sheet Spread + 4-Column Typographic Ledger */}
    <div class="space-y-0">
      <section
        aria-label="Next Ensemble Call"
        class="border-t-2 border-navy-950 border-b border-stone-300/90 py-8 sm:py-10"
      >
        <div class="grid gap-8 lg:grid-cols-12 lg:items-stretch lg:gap-10">
          {/* Left Column: Call Title, Time, Venue & Primary Actions */}
          <div class="flex flex-col justify-between lg:col-span-7">
            <div>
              <div class="flex flex-wrap items-center gap-2.5 text-[11px] font-semibold uppercase tracking-[0.2em]">
                {isCallToday && (
                  <span class="h-2 w-2 rounded-full bg-copper-500 animate-pulse" aria-hidden="true" />
                )}
                <span class="text-copper-600">
                  {isCallToday ? 'Today’s Ensemble Call' : 'Next Ensemble Call'}
                </span>
                {nextEvent && (
                  <span
                    class={`rounded-sm border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] ${eventTypeBadgeColor(
                      nextEvent.type
                    )}`}
                  >
                    {nextEvent.type}
                  </span>
                )}
              </div>

              {nextEvent ? (
                <div class="mt-3.5">
                  <h2 class="font-editorial text-3xl font-normal leading-[1.1] tracking-tight text-navy-950 sm:text-4xl lg:text-[2.75rem]">
                    {nextEvent.title}
                  </h2>

                  <div class="mt-4 flex flex-wrap items-center gap-x-3.5 gap-y-2 text-sm text-stone-700">
                    <span class="font-editorial text-xl font-medium tracking-wide text-navy-950 sm:text-[1.35rem]">
                      {isCallToday ? 'Today, ' : ''}{formatEventDate(nextEvent.date)} · {nextEvent.time}
                    </span>
                    <span class="text-stone-300" aria-hidden="true">·</span>
                    <LocationDirectionsButton
                      client:load
                      location={nextEvent.location}
                      variant="inline"
                    />
                  </div>

                  {nextEventConflict && (
                    <div
                      class:list={[
                        'mt-5 border-l-2 px-4 py-3 text-xs sm:text-sm',
                        nextEventConflict.status === 'Late'
                          ? 'border-amber-500 bg-amber-50/80 text-amber-950'
                          : 'border-rose-400 bg-rose-50/80 text-rose-950',
                      ]}
                    >
                      <p class="text-[10px] font-semibold uppercase tracking-[0.16em]">
                        {nextEventConflict.status === 'Late'
                          ? 'Running Late Notice Active'
                          : 'Absence Logged for This Call'}
                      </p>
                      <p class="mt-0.5 text-xs text-stone-700">
                        {nextEventConflict.reason ||
                          (nextEventConflict.status === 'Late' ? 'Running late' : 'Absence recorded')}
                      </p>
                    </div>
                  )}
                </div>
              ) : (
                <p class="mt-4 text-sm leading-relaxed text-stone-600">
                  No upcoming ensemble calls are posted on the schedule at this moment.
                </p>
              )}
            </div>

            <div class="mt-7 flex flex-wrap items-center gap-3 pt-1">
              <a
                href="/portal/music"
                class="inline-flex items-center justify-center rounded-sm bg-navy-950 px-5 py-2.5 text-xs font-semibold uppercase tracking-[0.16em] text-ivory-50 transition hover:bg-navy-900"
              >
                Open Digital Scores ({totalScoreFiles})
              </a>
              {nextEvent && (
                <QuickLateNoticeModal
                  client:load
                  eventId={nextEvent.eventId}
                  eventTitle={nextEvent.title}
                  eventDate={nextEvent.date}
                  sectionGroup={singer.sectionGroup || ''}
                  sectionLeaders={sectionLeaders}
                  conductorName={conductorName}
                  buttonVariant="hero"
                  buttonLabel={
                    nextEventConflict
                      ? nextEventConflict.status === 'Late'
                        ? 'Update Late ETA'
                        : 'Update Notice'
                      : isCallToday
                      ? 'Running Late / Conflict'
                      : 'Report Conflict'
                  }
                />
              )}
            </div>
          </div>

          {/* Right Column: Warm Laid-Paper Call Sheet Slip */}
          <div class="flex flex-col justify-between rounded-sm border border-stone-200/90 bg-[#f5efe8]/75 p-5 sm:p-6 lg:col-span-5">
            <div>
              <span class="block text-[10px] font-semibold uppercase tracking-[0.2em] text-copper-600">
                Call Sheet &amp; Rehearsal Focus
              </span>
              {nextEvent?.notes ? (
                <p class="mt-3 whitespace-pre-line text-sm leading-relaxed text-stone-700">
                  {nextEvent.notes}
                </p>
              ) : (
                <p class="mt-3 text-sm leading-relaxed text-stone-600">
                  Please have all current concert folder scores and a pencil ready at downbeat. Rehearsal order and director markings are updated in the Music Library.
                </p>
              )}
            </div>

            {nextEvent && (
              <div class="mt-6 border-t border-stone-300/70 pt-3.5 text-xs text-stone-600">
                {(nextEvent.snack1Name ||
                  nextEvent.snack2Name ||
                  nextEvent.snack3Name ||
                  nextEvent.snack4Name) ? (
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500">
                      {nextEvent.type === 'Concert' || nextEvent.type === 'Dress'
                        ? 'Call Crew'
                        : 'Sign-ups'}
                    </span>
                    <span class="font-medium text-navy-950">
                      {[
                        nextEvent.snack1Name,
                        nextEvent.snack2Name,
                        nextEvent.snack3Name,
                        nextEvent.snack4Name,
                      ]
                        .filter(Boolean)
                        .map((s) => parseSnackEntry(s).name)
                        .join(', ')}
                    </span>
                  </div>
                ) : (
                  <div class="flex items-baseline justify-between gap-2">
                    <span class="text-[10px] font-semibold uppercase tracking-[0.16em] text-stone-500">
                      Season Horizon
                    </span>
                    <span class="font-medium text-navy-950">
                      {upcomingEvents.length} scheduled call{upcomingEvents.length === 1 ? '' : 's'}
                    </span>
                  </div>
                )}
              </div>
            )}
          </div>
        </div>
      </section>

      {/* 4-Column Horizontal Typographic Status Ledger */}
      <nav
        aria-label="Member Status & Quick Workspaces"
        class="grid grid-cols-1 border-b border-stone-300/80 sm:grid-cols-2 lg:grid-cols-4"
      >
        {/* 01. Attendance */}
        <a
          href="/portal/absences"
          class="group flex flex-col justify-between border-b border-stone-200/90 py-6 transition-colors hover:bg-[#f5efe8]/60 sm:pr-6 lg:border-b-0 lg:py-7"
        >
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
              01 · Attendance
            </span>
            <h3 class="mt-2 font-editorial text-2xl font-medium leading-snug text-navy-950">
              {myUpcomingConflicts.length === 0
                ? 'All Calls Confirmed'
                : myUpcomingAbsences.length > 0 && myUpcomingLates.length > 0
                ? `${myUpcomingAbsences.length} Absence, ${myUpcomingLates.length} Late`
                : myUpcomingAbsences.length > 0
                ? `${myUpcomingAbsences.length} Absence${myUpcomingAbsences.length > 1 ? 's' : ''} Logged`
                : `${myUpcomingLates.length} Late Notice${myUpcomingLates.length > 1 ? 's' : ''}`}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-stone-600">
              {myUpcomingConflicts.length === 0
                ? `Present across all ${upcomingEvents.length} scheduled dates.`
                : `Next notice: ${formatEventDate(myUpcomingConflicts[0].date)}`}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-950 transition group-hover:text-copper-600">
            <span>{myUpcomingConflicts.length === 0 ? 'Log Conflict' : 'Manage'}</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>

        {/* 02. Sign-Ups & Duties */}
        <a
          href="/portal/snacks"
          class="group flex flex-col justify-between border-b border-stone-200/90 py-6 transition-colors hover:bg-[#f5efe8]/60 sm:border-l sm:pl-6 lg:border-b-0 lg:px-6 lg:py-7"
        >
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
              02 · Sign-Ups
            </span>
            <h3 class="mt-2 font-editorial text-2xl font-medium leading-snug text-navy-950">
              {mySnackDates.length > 0
                ? `${mySnackDates.length} Date${mySnackDates.length > 1 ? 's' : ''} Claimed`
                : `${openSnackSlotsCount} Open Slots`}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-stone-600">
              {mySnackDates.length > 0
                ? `Next commitment: ${formatEventDate(mySnackDates[0].date)}`
                : 'Rehearsal duties, hospitality & concert crew sign-ups.'}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-950 transition group-hover:text-copper-600">
            <span>{mySnackDates.length > 0 ? 'View Signups' : 'Claim Slot'}</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>

        {/* 03. Music Library */}
        <a
          href="/portal/music"
          class="group flex flex-col justify-between border-b border-stone-200/90 py-6 transition-colors hover:bg-[#f5efe8]/60 sm:border-b-0 sm:pr-6 lg:border-l lg:px-6 lg:py-7"
        >
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
              03 · Repertoire
            </span>
            <h3 class="mt-2 font-editorial text-2xl font-medium leading-snug text-navy-950">
              {totalScoreFiles} Digital Scores
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-stone-600">
              {uniqueConcertPrograms} active program{uniqueConcertPrograms === 1 ? '' : 's'}
              {totalMarkingsDocs > 0 ? ' · Markings posted' : ' · Part tracks & octavos'}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-950 transition group-hover:text-copper-600">
            <span>Open Library</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>

        {/* 04. Stage Formation */}
        <a
          href="/portal/seating"
          class="group flex flex-col justify-between py-6 transition-colors hover:bg-[#f5efe8]/60 sm:border-l sm:border-stone-200/90 sm:pl-6 lg:py-7"
        >
          <div>
            <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
              04 · Seating Chart
            </span>
            <h3 class="mt-2 font-editorial text-2xl font-medium leading-snug text-navy-950">
              {mySeatLocation
                ? `${mySeatLocation.rowName}, Seat ${mySeatLocation.seatIndex}`
                : `${publishedCharts.length} Formation Chart${publishedCharts.length === 1 ? '' : 's'}`}
            </h3>
            <p class="mt-1.5 text-xs leading-relaxed text-stone-600">
              {mySeatLocation
                ? `${mySeatLocation.chartTitle}${mySeatLocation.voicePart || singer.voicePart ? ` · ${mySeatLocation.voicePart || singer.voicePart}` : ''}`
                : 'Published concert seating & standing positions.'}
            </p>
          </div>
          <span class="mt-4 inline-flex items-center gap-1 text-[11px] font-semibold uppercase tracking-[0.14em] text-navy-950 transition group-hover:text-copper-600">
            <span>View Formation</span>
            <span aria-hidden="true" class="transition-transform group-hover:translate-x-0.5">→</span>
          </span>
        </a>
      </nav>

      {/* Latest Mailing List Dispatch Strip (singers@kantorei.net) */}
      {latestDispatch && (
        <div class="border-b border-stone-300/80 bg-[#f5efe8]/55 px-4 py-5 sm:px-6">
          <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-center">
            <div class="min-w-0">
              <div class="flex flex-wrap items-center gap-2 text-[10px] font-semibold uppercase tracking-[0.18em]">
                <span class="text-copper-600">Latest List Dispatch</span>
                <span class="text-stone-300" aria-hidden="true">·</span>
                <span class="text-stone-600">{latestDispatch.fromName}</span>
                {latestDispatch.pinned && (
                  <span class="rounded-xs border border-copper-300 bg-[#f9efe8] px-1.5 py-0.2 text-[9px] text-copper-600">
                    Pinned
                  </span>
                )}
              </div>
              <a
                href={`/portal/messages#${latestDispatch.id}`}
                class="mt-1 block font-editorial text-xl font-medium text-navy-950 transition hover:text-copper-600 sm:text-2xl"
              >
                {latestDispatch.subject}
              </a>
              <p class="mt-1 line-clamp-1 text-xs text-stone-600">
                {latestDispatch.bodyText.replace(/\s+/g, ' ').slice(0, 160)}…
              </p>
            </div>

            <a
              href="/portal/messages"
              class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-sm border border-stone-300 bg-white px-3.5 py-2 text-[11px] font-semibold uppercase tracking-[0.15em] text-navy-950 transition hover:border-copper-400 hover:text-copper-600 sm:self-center"
            >
              <span>Read Bulletin ({bulletinMessages.length})</span>
              <span aria-hidden="true">→</span>
            </a>
          </div>
        </div>
      )}
    </div>

    {/* Engraved-Style Season Schedule Ledger */}
    <section aria-labelledby="season-schedule-heading" class="pt-2">
      <div class="flex flex-col justify-between gap-4 border-b border-navy-950/15 pb-4 sm:flex-row sm:items-end">
        <div>
          <p class="text-[10px] font-semibold uppercase tracking-[0.2em] text-copper-600">
            Season Calendar
          </p>
          <h2
            id="season-schedule-heading"
            class="mt-1 font-editorial text-3xl font-normal tracking-tight text-navy-950 sm:text-4xl"
          >
            Upcoming Ensemble Calls
          </h2>
        </div>

        <div class="flex flex-wrap items-center gap-3">
          {isAdmin && <CalendarAdminControls client:load calendarId={calendarId} />}
          <span class="text-xs font-medium uppercase tracking-[0.14em] text-stone-500">
            {upcomingEvents.length} {upcomingEvents.length === 1 ? 'Call' : 'Calls'}
          </span>
        </div>
      </div>

      {upcomingEvents.length === 0 ? (
        <div class="border-b border-stone-200/90 py-12 text-center text-sm text-stone-500">
          No upcoming ensemble calls are currently listed.
        </div>
      ) : (
        <ul class="divide-y divide-stone-200/90 border-b border-stone-200/90">
          {upcomingEvents.map((ev) => {
            const { weekday, month, day } = formatShortMonthDay(ev.date);
            const conflict = myUpcomingConflicts.find((a) => a.eventId === ev.eventId);

            return (
              <li class="grid gap-4 py-5 transition-colors hover:bg-[#f5efe8]/45 sm:grid-cols-12 sm:items-start sm:gap-6 sm:px-2">
                {/* Engraved Date Column */}
                <div class="flex items-baseline gap-2.5 sm:col-span-2 sm:flex-col sm:gap-0.5">
                  <span class="text-[10px] font-semibold uppercase tracking-[0.18em] text-copper-600">
                    {weekday} · {month}
                  </span>
                  <span class="font-editorial text-3xl font-medium leading-none text-navy-950 sm:text-[2.15rem]">
                    {day}
                  </span>
                </div>

                {/* Call Details Column */}
                <div class="min-w-0 sm:col-span-7">
                  <div class="flex flex-wrap items-center gap-2">
                    <h3 class="font-editorial text-xl font-semibold leading-snug text-navy-950 sm:text-[1.35rem]">
                      {ev.title}
                    </h3>
                    <span
                      class={`rounded-sm border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.14em] ${eventTypeBadgeColor(
                        ev.type
                      )}`}
                    >
                      {ev.type}
                    </span>
                    {conflict && (
                      <span
                        class:list={[
                          'rounded-sm border px-2 py-0.5 text-[10px] font-semibold uppercase tracking-[0.12em]',
                          conflict.status === 'Late'
                            ? 'border-amber-300 bg-amber-50 text-amber-900'
                            : 'border-rose-200 bg-rose-50 text-rose-800',
                        ]}
                      >
                        {conflict.status === 'Late' ? 'Running Late' : 'Absent'}
                      </span>
                    )}
                  </div>

                  <div class="mt-1.5 flex flex-wrap items-center gap-x-3 gap-y-1 text-xs sm:text-sm text-stone-600">
                    <span class="font-medium text-navy-950 tabular-nums">{ev.time}</span>
                    <span class="text-stone-300" aria-hidden="true">·</span>
                    <LocationDirectionsButton
                      client:load
                      location={ev.location}
                      variant="inline"
                      className="text-xs sm:text-sm"
                    />
                  </div>

                  {ev.notes && (
                    <p class="mt-2.5 whitespace-pre-line border-l border-stone-300 pl-3.5 text-xs leading-relaxed text-stone-600 sm:text-sm">
                      {ev.notes}
                    </p>
                  )}
                </div>

                {/* Action & Sign-Ups Column */}
                <div class="flex flex-wrap items-center justify-between gap-2 sm:col-span-3 sm:flex-col sm:items-end sm:justify-start">
                  <QuickLateNoticeModal
                    client:load
                    eventId={ev.eventId}
                    eventTitle={ev.title}
                    eventDate={ev.date}
                    sectionGroup={singer.sectionGroup || ''}
                    sectionLeaders={sectionLeaders}
                    conductorName={conductorName}
                    buttonLabel={conflict ? 'Edit Notice' : 'Report Conflict'}
                    buttonVariant="ghost"
                  />

                  {(ev.snack1Name || ev.snack2Name || ev.snack3Name || ev.snack4Name) && (
                    <p class="text-xs leading-snug text-stone-500 sm:mt-1 sm:text-right">
                      <span class="text-[10px] font-semibold uppercase tracking-[0.12em] text-stone-400">
                        {ev.type === 'Concert' || ev.type === 'Dress' ? 'Crew: ' : 'Sign-ups: '}
                      </span>
                      <span class="text-stone-700">
                        {[ev.snack1Name, ev.snack2Name, ev.snack3Name, ev.snack4Name]
                          .filter(Boolean)
                          .map((s) => parseSnackEntry(s).name)
                          .join(', ')}
                      </span>
                    </p>
                  )}
                </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  </div>
</PortalLayout>

---
import { hasRole } from '../../lib/auth';

const singer = Astro.locals.singer!;
if (!hasRole(singer, ['Section_Leader', 'Admin'])) {
  return Astro.redirect('/portal');
}

const requestedTab = Astro.url.searchParams.get('tab');
if (requestedTab === 'rollcall') {
  return Astro.redirect('/portal/seating?mode=attendance');
}
if (requestedTab === 'roster') {
  return Astro.redirect('/portal/directory?view=table');
}

// Redirect all other legacy /portal/admin visits to Roster & Directory
return Astro.redirect('/portal/directory');
---

---
import PublicLayout from '../layouts/PublicLayout.astro';
import MediaGallery from '../components/public/MediaGallery';
import { getMedia, getPortalConfig } from '../lib/google';
import { getInstagramShowcase } from '../lib/media';

const [config, mediaItems] = await Promise.all([
  getPortalConfig(Astro.locals),
  getMedia(Astro.locals),
]);

const instagramShowcase = await getInstagramShowcase(config);

const choirName = config.Choir_Name || 'Kantorei';
const youtubeChannel = config.YouTube_URL || 'https://www.youtube.com/@kantoreiMN';
const instagramUrl = config.Instagram_URL || 'https://www.instagram.com/kantorei_mn';
const facebookUrl = config.Facebook_URL || 'https://www.facebook.com/kantoreimn';

// Display a curated selection of 6 featured YouTube videos before transitioning to Instagram
const FEATURED_LIMIT = 6;
const featuredVideos = mediaItems.slice(0, FEATURED_LIMIT);
const remainingVideos = mediaItems.slice(FEATURED_LIMIT);
---

<PublicLayout
  title="Media & Recordings"
  description="Watch and listen to Kantorei concert videos, lyric videos, and embedded Instagram reels and stories shared worldwide from Minnesota."
>
  <!-- Hero -->
  <section class="relative overflow-hidden bg-[#0B131E] pt-28 pb-16 text-ivory-50 sm:pt-36 sm:pb-22">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="flex flex-col justify-between gap-8 lg:flex-row lg:items-end">
        <div class="max-w-2xl">
          <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
            Performances & Recordings Shared Worldwide
          </span>
          <h1 class="mt-3 font-editorial text-4xl font-bold text-white sm:text-6xl">
            Watch & Listen to {choirName}
          </h1>
          <p class="mt-4 text-sm leading-relaxed text-zinc-300 sm:text-base">
            {choirName} performs primarily in Minnesota and shares recordings with listeners around the globe—spanning signature a cappella works, world music, and collaborations with well-known and emerging composers.
          </p>

          <!-- Quick Jump Navigation -->
          <div class="mt-6 flex flex-wrap items-center gap-2 text-xs font-medium text-zinc-300">
            <span class="text-zinc-400">Jump to:</span>
            <a
              href="#youtube"
              class="rounded-full border border-white/20 bg-white/5 px-3 py-1 transition hover:border-gold-400 hover:text-gold-300"
            >
              Featured YouTube ({featuredVideos.length})
            </a>
            <a
              href="#instagram"
              class="rounded-full border border-pink-400/30 bg-pink-500/10 px-3 py-1 text-pink-300 transition hover:border-pink-300 hover:text-pink-200"
            >
              Instagram Feed & Reels
            </a>
            <a
              href="#connect"
              class="rounded-full border border-white/20 bg-white/5 px-3 py-1 transition hover:border-gold-400 hover:text-gold-300"
            >
              Connect
            </a>
          </div>
        </div>

        <div class="flex flex-wrap gap-3">
          <a
            href={youtubeChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full bg-gold-500 px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-copper-600"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
            YouTube Channel
          </a>
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-3 text-xs font-semibold uppercase tracking-wider text-ivory-50 transition hover:border-gold-400 hover:text-gold-300"
          >
            Instagram
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 rounded-full border border-white/20 bg-white/5 px-5 py-3 text-xs font-semibold uppercase tracking-wider text-ivory-50 transition hover:border-gold-400 hover:text-gold-300"
          >
            Facebook
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- YouTube Video & Recording Grid (Curated Selection) -->
  <section id="youtube" class="scroll-mt-8 mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="mb-10 flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          Featured Selection
        </span>
        <h2 class="mt-1 font-editorial text-4xl font-bold text-navy-950">
          Featured YouTube Performances & Albums
        </h2>
        <p class="mt-2 text-sm sm:text-base text-stone-700 leading-relaxed">
          A curated selection of signature choral recordings, followed by our live Instagram feed below.
        </p>
      </div>
      <a
        href={youtubeChannel}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 text-sm font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4"
      >
        <span>Browse all on YouTube</span>
        <span>→</span>
      </a>
    </div>

    <!-- Interactive Media Gallery with Concert Hall Lightbox Theater -->
    <MediaGallery
      client:load
      featuredVideos={featuredVideos}
      remainingVideos={remainingVideos}
      youtubeChannelUrl={youtubeChannel}
    />

    <!-- Instagram Section (Directly Embedded with Captions) -->
    <div id="instagram" class="scroll-mt-8 mt-20">
      <div class="mb-8 flex flex-col justify-between gap-3 sm:flex-row sm:items-end">
        <div>
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-pink-600">
            Instagram Feed
          </span>
          <h2 class="mt-0.5 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
            Latest Posts & Reels from {instagramShowcase.handle}
          </h2>
        </div>
        <a
          href={instagramShowcase.profileUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 rounded-full border border-pink-300 bg-pink-50/70 px-4 py-2 text-xs font-bold uppercase tracking-wider text-pink-700 transition hover:bg-pink-100"
        >
          Follow on Instagram →
        </a>
      </div>

      <!-- Vertical Flowing Grid of Captioned Instagram Posts -->
      <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3 items-start">
        {instagramShowcase.posts.map((post) => (
          <div class="w-full flex justify-center">
            <blockquote
              class="instagram-media w-full overflow-hidden rounded-2xl border border-zinc-200 bg-white shadow-2xs"
              data-instgrm-captioned
              data-instgrm-permalink={`https://www.instagram.com/p/${post.shortcode}/?utm_source=ig_embed&amp;utm_campaign=loading`}
              data-instgrm-version="14"
              style="margin: 0; min-width: 280px; max-width: 100%; width: 100%;"
            >
              <iframe
                src={`https://www.instagram.com/p/${post.shortcode}/embed/captioned/`}
                title={`Instagram post from ${instagramShowcase.handle}`}
                loading="lazy"
                allowtransparency="true"
                allow="encrypted-media"
                class="w-full border-0 overflow-hidden rounded-2xl"
                style="min-height: 640px; height: 680px;"
              />
            </blockquote>
          </div>
        ))}
      </div>
    </div>

    <!-- Social Community Strip -->
    <div id="connect" class="scroll-mt-8 mt-20 rounded-3xl border border-zinc-200 bg-ivory-100 p-8 sm:p-10">
      <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
        <div class="lg:col-span-7">
          <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
            Stay Connected
          </span>
          <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950">
            Follow {choirName} Behind the Scenes
          </h2>
          <p class="mt-2 text-sm leading-relaxed text-zinc-700">
            Join us on Instagram, Facebook, and YouTube for rehearsal glimpses, composer conversations, new recording releases, and Twin Cities outreach events.
          </p>
        </div>

        <div class="flex flex-wrap gap-3 lg:col-span-5 lg:justify-end">
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-navy-900 px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-navy-800"
          >
            Instagram
          </a>
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-navy-900 px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-navy-800"
          >
            Facebook
          </a>
          <a
            href={youtubeChannel}
            target="_blank"
            rel="noopener noreferrer"
            class="rounded-full bg-gold-500 px-5 py-3 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-copper-600"
          >
            YouTube
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Optional Instagram client script for native responsive embedding -->
  <script is:inline async src="//www.instagram.com/embed.js"></script>
</PublicLayout>

---
import PublicLayout from '../layouts/PublicLayout.astro';
import AuditionForm from '../components/public/AuditionForm';
import { getEnv } from '../lib/env';
import { getPortalConfig } from '../lib/google';

const config = await getPortalConfig(Astro.locals);

const choirName = config.Choir_Name || 'Kantorei';
const publicContactEmail = config.Contact_Email || 'info@kantorei.net';

const auditionsBlurb =
  config.Auditions_Blurb ||
  'We welcome inquiries from experienced Twin Cities choral singers across all voice parts (SATB · general sections and split parts) who share our commitment to vocal health, independent preparation, and expressive a cappella ensemble singing.';

const auditionsTimingNote =
  config.Auditions_Timing_Note ||
  'We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview. Inquiries and submissions are warmly welcomed year-round. Come sing with us!';

const auditionsCadence =
  config.Auditions_Rehearsal_Cadence ||
  `${choirName} rehearses Sunday evenings at rotating venues across the Twin Cities metro area (typically 6–8 rehearsals per concert cycle), beginning each season with a community retreat.`;

const auditionsProcessNote =
  config.Auditions_Process_Note ||
  'Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview.';

const envFormUrl =
  getEnv('PUBLIC_AUDITIONS_GOOGLE_FORM_URL', Astro.locals) ||
  getEnv('AUDITIONS_FORM_URL', Astro.locals) ||
  '';
const rawFormUrl = (config.Auditions_Form_URL || config.Auditions_Google_Form_URL || envFormUrl || '').trim();
const hasCustomForm = Boolean(rawFormUrl && rawFormUrl !== 'DEMO');

let normalizedFormUrl = rawFormUrl;
if (hasCustomForm && normalizedFormUrl.includes('docs.google.com/forms')) {
  if (!normalizedFormUrl.includes('embedded=true')) {
    normalizedFormUrl += normalizedFormUrl.includes('?') ? '&embedded=true' : '?embedded=true';
  }
}
---

<PublicLayout
  title={`Auditions · ${choirName}`}
  description={`Audition for ${choirName}, one of Minnesota's premier choral ensembles led by Adam Reinwald. Rehearsals Sunday evenings at rotating venues across the Twin Cities.`}
>
  <!-- Hero Section -->
  <section class="relative overflow-hidden bg-[#0B131E] pt-28 pb-16 text-ivory-50 sm:pt-36 sm:pb-24">
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    ></div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400">
        Sing With Us · Twin Cities, Minnesota
      </span>
      <h1 class="mt-3 max-w-3xl font-editorial text-4xl font-bold text-white sm:text-6xl">
        Audition for {choirName}
      </h1>
      <p class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-200 sm:text-lg">
        {auditionsBlurb}
      </p>

      <!-- Gentle Timing Banner Highlight -->
      <div class="mt-8 max-w-3xl rounded-2xl border border-gold-400/30 bg-gold-500/10 p-5 sm:p-6 backdrop-blur-xs">
        <div class="flex items-start gap-3.5">
          <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-gold-500 text-xs font-bold text-navy-950">
            i
          </div>
          <div class="text-xs leading-relaxed text-zinc-200 sm:text-sm">
            <span class="font-bold text-gold-300">Audition Schedule &amp; Format:</span>{' '}
            {auditionsTimingNote}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 3 Core Ensemble Pillars -->
  <section class="border-b border-zinc-200 bg-ivory-100/60 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          Ensemble Culture &amp; Commitment
        </span>
        <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
          What Singing in {choirName} Looks Like
        </h2>
      </div>

      <div class="mt-10 grid gap-6 md:grid-cols-3">
        <div class="rounded-3xl border border-zinc-200 bg-white p-7 shadow-2xs">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-gold-500">
            Rehearsal Cadence
          </span>
          <h3 class="mt-2 font-editorial text-2xl font-bold text-navy-950">
            Sunday Calls (Rotating Venues)
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600">
            {auditionsCadence}
          </p>
        </div>

        <div class="rounded-3xl border border-zinc-200 bg-white p-7 shadow-2xs">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-gold-500">
            Audition Format
          </span>
          <h3 class="mt-2 font-editorial text-2xl font-bold text-navy-950">
            What to Expect
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600">
            {auditionsProcessNote}
          </p>
        </div>

        <div class="rounded-3xl border border-zinc-200 bg-white p-7 shadow-2xs">
          <span class="text-xs font-bold uppercase tracking-[0.16em] text-gold-500">
            Ensemble Access
          </span>
          <h3 class="mt-2 font-editorial text-2xl font-bold text-navy-950">
            Zero Mandatory Dues
          </h3>
          <p class="mt-3 text-sm leading-relaxed text-zinc-600">
            {choirName} eliminates financial barriers to choral participation: there are no mandatory singer dues or music fees. All digital sheet music and rehearsal audio files are provided directly in our Singer Portal.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Audition Form Section -->
  <section id="form" class="scroll-mt-20 py-16 sm:py-24">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="text-center">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          Audition Inquiry Form
        </span>
        <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950 sm:text-5xl">
          Submit Your Audition Interest
        </h2>
        <p class="mx-auto mt-3 max-w-2xl text-sm leading-relaxed text-zinc-600 sm:text-base">
          Please fill out the form below to let Artistic Director Adam Reinwald know about your vocal background and interest in {choirName}. We welcome inquiries at any point during the season!
        </p>
      </div>

      <div class="mt-10">
        {hasCustomForm ? (
          <div class="space-y-4">
            <div class="flex flex-wrap items-center justify-between gap-3 rounded-2xl border border-gold-200/80 bg-amber-50/80 p-4 text-xs sm:text-sm">
              <span class="font-semibold text-navy-950">Submitting via Google Form</span>
              <a
                href={rawFormUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 font-bold text-navy-900 underline decoration-gold-500 hover:text-gold-600"
              >
                Open Google Form in New Tab &nearr;
              </a>
            </div>
            <div class="overflow-hidden rounded-3xl border border-zinc-200 bg-white p-2 shadow-sm sm:p-4">
              <iframe
                src={normalizedFormUrl}
                width="100%"
                height="950"
                class="w-full rounded-2xl border-0"
                title={`${choirName} Audition Form`}
              >
                Loading audition form...
              </iframe>
            </div>
            <div class="text-center">
              <a
                href={rawFormUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center gap-1.5 text-xs font-semibold text-navy-900 underline decoration-gold-500 underline-offset-4 hover:text-gold-500"
              >
                Having trouble with the embed above? Open the Google Form directly &nearr;
              </a>
            </div>
          </div>
        ) : (
          <AuditionForm
            client:load
            choirName={choirName}
            contactEmail={publicContactEmail}
            googleFormUrl={rawFormUrl || undefined}
          />
        )}
      </div>
    </div>
  </section>

  <!-- FAQ / What to Expect Section -->
  <section class="border-t border-zinc-200 bg-ivory-50 py-16 sm:py-20">
    <div class="mx-auto max-w-4xl px-4 sm:px-6">
      <div class="text-center">
        <span class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500">
          Preparation &amp; Details
        </span>
        <h2 class="mt-2 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
          Frequently Asked Questions
        </h2>
      </div>

      <div class="mt-10 space-y-4">
        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            When are audition calls held?
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. However, we enthusiastically welcome inquiries and interest submissions throughout the entire year as openings arise. Come sing with us!
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            What happens during the audition?
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            What is the rehearsal schedule and location?
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            {auditionsCadence} Kantorei singers prepare music independently between rehearsals using digital scores and part-predominant audio tracks provided in the Singer Portal.
          </p>
        </div>

        <div class="rounded-2xl border border-zinc-200 bg-white p-6 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            Are there singer dues or expenses?
          </h3>
          <p class="mt-2 text-sm leading-relaxed text-zinc-600">
            No! {choirName} is proud to be tuition-free and dues-free. We believe choral excellence should be accessible to all qualified singers regardless of economic circumstances.
          </p>
        </div>
      </div>

      <!-- Singer Portal Companion Callout -->
      <div class="mt-12 rounded-3xl border border-zinc-200 bg-white p-6 text-center shadow-2xs sm:p-8">
        <p class="text-sm font-semibold text-navy-950">
          Already an active ensemble member?
        </p>
        <p class="mt-1 text-xs text-zinc-500">
          Access your digital scores, rehearsal tracks, seating charts, and calendar in the portal.
        </p>
        <div class="mt-4">
          <a
            href="/login"
            class="inline-flex items-center gap-2 rounded-full border border-navy-900 bg-navy-950 px-6 py-2.5 text-xs font-bold uppercase tracking-wider text-white transition hover:bg-gold-500"
          >
            Go to Singer Portal &rarr;
          </a>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

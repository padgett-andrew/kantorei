---
import PublicLayout from "../layouts/PublicLayout.astro";
import { getBoardMembers, getLeadership, getPortalConfig } from "../lib/google";
import { getSiteUrl, buildBreadcrumbsSchema } from "../lib/seo";

const [config, boardMembers, leadership] = await Promise.all([
  getPortalConfig(Astro.locals),
  getBoardMembers(Astro.locals),
  getLeadership(Astro.locals),
]);

const choirName = config.Choir_Name || "Kantorei";
const publicContactEmail = config.Contact_Email || "info@kantorei.net";
const siteUrl = getSiteUrl(Astro.locals);
const breadcrumbs = buildBreadcrumbsSchema(
  [
    { name: "Home", path: "/" },
    { name: "About & Leadership", path: "/about" },
  ],
  siteUrl,
);
const aboutHeaderTitle =
  config.About_Header_Title ||
  "Vocal health, effortless sound, and singing for a lifetime.";
const missionStatement =
  config.Mission_Statement ||
  "Expanding the worldview of artists and audiences through passionate and crafted artistic performances, partnerships, and projects.";
const visionStatement =
  config.Vision_Statement ||
  "Fascinatingly remarkable artistic expression, inviting deep meaning and belonging.";
const auditionsBlurb =
  config.Auditions_Blurb ||
  "We welcome inquiries from experienced Twin Cities choral singers across all voice parts (SATB · general sections and split parts) who share our commitment to vocal health, independent preparation, and expressive a cappella ensemble singing.";
const auditionsTimingNote =
  config.Auditions_Timing_Note ||
  "We hold auditions in the Spring (usually mid-May) and the Fall (mid-August) to fill out a roster of singers for the coming season. Auditions are heard by Artistic Director Adam Reinwald and section leaders, and consist of singing a prepared selection a cappella, some basic musicianship checks, and a brief interview. Inquiries and submissions are warmly welcomed year-round. Come sing with us!";
---

<PublicLayout
  title={`About ${choirName} | Twin Cities Chamber Choir · History & Leadership`}
  description={`Founded in 1988 by Dr. Axel Theimer and led by Artistic Director Adam Reinwald, ${choirName} is one of the premier a cappella choral ensembles in the Twin Cities, Minnesota. Discover our story, vocal health legacy, and leadership.`}
  keywords="about kantorei, kantorei minnesota, best choirs in the twin cities, chamber choir minneapolis, a cappella choir st paul, axel theimer, adam reinwald, minnesota choral music, kantorei net"
  structuredData={breadcrumbs}
>
  <section
    class="relative overflow-hidden bg-[#0B131E] pt-28 pb-16 text-ivory-50 sm:pt-36 sm:pb-24"
  >
    <div
      class="pointer-events-none absolute inset-0 opacity-25"
      style="background: radial-gradient(circle at 18% 30%, #b16437 0%, transparent 45%), radial-gradient(circle at 82% 70%, #2a4365 0%, transparent 55%);"
    >
    </div>
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <span
        class="text-xs font-semibold uppercase tracking-[0.2em] text-gold-400"
      >
        Founded in 1988 · Minnesota
      </span>
      <h1
        class="mt-3 max-w-3xl font-editorial text-4xl font-bold text-white sm:text-6xl"
      >
        {aboutHeaderTitle}
      </h1>
      <p
        class="mt-5 max-w-3xl text-base leading-relaxed text-zinc-200 sm:text-lg"
      >
        Founded in 1988 by Dr. Axel Theimer, and now led by Adam Reinwald, {
          choirName
        } is one of the premier choral ensembles in Minnesota.
      </p>
    </div>
  </section>

  <!-- Mission, Vision & Core Ensemble Story -->
  <section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
    <div class="grid gap-6 md:grid-cols-2">
      <div class="rounded-3xl border border-zinc-200 bg-ivory-100 p-8">
        <span
          class="text-xs font-bold uppercase tracking-[0.18em] text-gold-500"
        >
          Mission Statement
        </span>
        <p
          class="mt-3 font-editorial text-2xl font-bold leading-snug text-navy-950 sm:text-3xl"
        >
          “{missionStatement}”
        </p>
      </div>

      <div
        class="rounded-3xl border border-zinc-200 bg-navy-950 p-8 text-ivory-50"
      >
        <span
          class="text-xs font-bold uppercase tracking-[0.18em] text-gold-400"
        >
          Vision Statement
        </span>
        <p
          class="mt-3 font-editorial text-2xl font-bold leading-snug text-white sm:text-3xl"
        >
          “{visionStatement}”
        </p>
      </div>
    </div>

    <div class="mt-14 grid gap-10 lg:grid-cols-12 lg:items-start">
      <div class="space-y-5 lg:col-span-7">
        <h2 class="font-editorial text-3xl font-bold text-navy-950 sm:text-4xl">
          About {choirName}
        </h2>
        <p class="text-base leading-relaxed text-zinc-700">
          {
            config.About_History_P1 ||
              `Founded in 1988 by Dr. Axel Theimer, and now led by Adam Reinwald, ${choirName} is one of the premier choral ensembles in Minnesota. With an integral focus on vocal health, ${choirName}’s singers have set a standard in Minnesota for rich and effortless choral sound. ${choirName} performs a wide range of mostly a cappella music from around the world. Most concerts include signature pieces complementing pieces from both well-known and emerging composers.`
          }
        </p>
        <p class="text-base leading-relaxed text-zinc-700">
          {
            config.About_History_P2 ||
              `${choirName} performs primarily in Minnesota and shares recordings worldwide. Through its outreach programming, ${choirName} invites audiences of all ages to share its pursuit of singing for a lifetime.`
          }
        </p>
        <p class="text-xs sm:text-sm leading-relaxed text-zinc-500 italic border-l-2 border-gold-400 pl-3">
          Note: {choirName} (Minnesota, operating at <span class="font-semibold text-zinc-700">kantorei.net</span>) is an independent 501(c)(3) arts organization based in Minneapolis & Saint Paul, distinct from the ensemble of the same name based in Denver, Colorado (kantorei.org).
        </p>
      </div>

      <div class="grid gap-4 sm:grid-cols-2 lg:col-span-5">
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            Signature & Emerging Works
          </h3>
          <p class="mt-1.5 text-sm text-zinc-600">
            Every program pairs treasured ensemble signature pieces with global
            a cappella traditions and fresh voices in choral composition.
          </p>
        </div>
        <div class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-2xs">
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            Worldwide Recordings
          </h3>
          <p class="mt-1.5 text-sm text-zinc-600">
            Studio albums, concert captures, and lyric videos connect listeners
            around the world to Minnesota choral artistry.
          </p>
        </div>
        <div
          class="rounded-2xl border border-zinc-200 bg-white p-5 shadow-2xs sm:col-span-2"
        >
          <h3 class="font-editorial text-xl font-bold text-navy-950">
            Lifelong Choral Community
          </h3>
          <p class="mt-1.5 text-sm text-zinc-600">
            Singers from diverse professional and musical backgrounds rehearse
            Sunday evenings at rotating venues across the Twin Cities and
            collaborate through annual retreats, outreach, and <em
              >Friends of Kantorei</em
            > events.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Artistic Leadership & Governance -->
  <section class="border-t border-zinc-200 bg-ivory-100/70 py-16 sm:py-20">
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div class="max-w-2xl">
        <span
          class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500"
        >
          Artistic & Organizational Leadership
        </span>
        <h2 class="mt-2 font-editorial text-4xl font-bold text-navy-950">
          Conductors, Founding Legacy & Board
        </h2>
      </div>

      <div class="mt-10 grid gap-8 lg:grid-cols-3">
        {
          leadership.map((leader) => (
            <article class="flex flex-col justify-between rounded-3xl border border-zinc-200 bg-white p-7 shadow-2xs">
              <div>
                {leader.imageUrl && (
                  <div class="mb-6 overflow-hidden rounded-2xl bg-zinc-100 aspect-[4/3] w-full">
                    <img
                      src={leader.imageUrl}
                      alt={`Portrait of ${leader.name}`}
                      class="h-full w-full object-cover object-center transition duration-300 hover:scale-[1.02]"
                      loading="lazy"
                    />
                  </div>
                )}
                <span class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600">
                  {leader.title}
                </span>
                <h3 class="mt-1.5 font-editorial text-3xl font-bold text-navy-950">
                  {leader.name}
                </h3>
                <div class="mt-4 space-y-3 text-sm sm:text-base leading-relaxed text-stone-700">
                  {leader.bio.split("\n\n").map((paragraph) => (
                    <p>{paragraph}</p>
                  ))}
                </div>
              </div>
              <div class="mt-6 border-t border-stone-200/60 pt-4">
                {leader.email ? (
                  <a
                    href={`mailto:${leader.email}`}
                    class="text-xs sm:text-sm font-semibold text-copper-600 underline decoration-copper-300 underline-offset-4 hover:text-navy-950"
                  >
                    {leader.email}
                  </a>
                ) : (
                  <span class="text-xs sm:text-sm font-medium text-stone-500">
                    {leader.name.includes("Theimer")
                      ? `Founded ${choirName} in 1988`
                      : `Artistic Staff · Twin Cities, MN`}
                  </span>
                )}
              </div>
            </article>
          ))
        }
      </div>

      <!-- Board of Directors -->
      <div
        class="mt-10 rounded-2xl border border-stone-200/80 bg-white p-7 sm:p-9 shadow-xs"
      >
        <div
          class="flex flex-col justify-between gap-3 sm:flex-row sm:items-end"
        >
          <div>
            <span
              class="text-xs font-semibold uppercase tracking-[0.16em] text-copper-600"
            >
              501(c)(3) Nonprofit Governance
            </span>
            <h3
              class="mt-1 font-editorial text-2xl font-bold text-navy-950 sm:text-3xl"
            >
              Board of Directors
            </h3>
          </div>
          <p class="max-w-md text-sm leading-relaxed text-stone-600">
            Volunteer governing board of singers and community members
            overseeing {choirName}’s mission, operations, and long-term
            sustainability.
          </p>
        </div>

        <div
          class="mt-6 grid gap-3.5 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4"
        >
          {
            boardMembers.map((member) => (
              <div class="rounded-xl border border-stone-200/60 bg-[#FAF7F2] px-4 py-3.5">
                <p class="font-semibold text-navy-950 text-sm sm:text-base">
                  {member.name}
                </p>
                <p class="mt-0.5 text-sm text-stone-600">{member.role}</p>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- Sing With Us / Auditions Callout -->
  <section
    id="auditions"
    class="scroll-mt-20 border-t border-zinc-200 bg-white py-16 sm:py-20"
  >
    <div class="mx-auto max-w-6xl px-4 sm:px-6">
      <div
        class="rounded-3xl border border-zinc-200 bg-ivory-100/80 p-8 sm:p-12"
      >
        <div class="grid gap-8 lg:grid-cols-12 lg:items-center">
          <div class="space-y-4 lg:col-span-8">
            <span
              class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500"
            >
              Sing With Us
            </span>
            <h2
              class="font-editorial text-3xl font-bold text-navy-950 sm:text-4xl"
            >
              Audition for {choirName}
            </h2>
            <p class="text-base leading-relaxed text-zinc-700">
              {auditionsBlurb}
            </p>
            <div
              class="rounded-2xl border border-gold-200/60 bg-amber-50/70 p-4 text-sm text-zinc-800"
            >
              <span class="font-semibold text-navy-950">Audition Schedule:</span
              >
              {auditionsTimingNote}
            </div>
          </div>

          <div
            class="flex flex-col gap-3 sm:flex-row lg:col-span-4 lg:flex-col lg:items-stretch"
          >
            <a
              href="/auditions"
              class="inline-flex items-center justify-center gap-2 rounded-full bg-gold-500 px-6 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-white shadow-xs transition hover:bg-copper-600"
            >
              View Audition Details & Form →
            </a>
            <a
              href={`mailto:${publicContactEmail}?subject=${encodeURIComponent(
                `${choirName} Audition Inquiry`,
              )}`}
              class="inline-flex items-center justify-center gap-2 rounded-full border border-zinc-300 bg-white px-6 py-3.5 text-center text-xs font-bold uppercase tracking-wider text-navy-950 transition hover:bg-zinc-50"
            >
              Email Direct Inquiry
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>
</PublicLayout>

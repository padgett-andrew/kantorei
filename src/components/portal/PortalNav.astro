---
import type { Singer } from '../../types/choir';
import { voicePartBadgeColor } from '../../lib/utils';

interface Props {
  singer: Singer;
  choirName: string;
  currentPath: string;
}

const { singer, choirName, currentPath } = Astro.props;
const showAdminTab = singer.role === 'Admin' || singer.role === 'Section_Leader';
const isOnLeave = singer.status === 'On_Leave';

const tabs = [
  { href: '/portal', label: 'Overview', exact: true },
  { href: '/portal/music', label: 'Scores & Audio', exact: false },
  { href: '/portal/absences', label: 'Absences', exact: false },
  { href: '/portal/snacks', label: 'Duties & Hospitality', exact: false },
  { href: '/portal/directory', label: 'Directory', exact: false },
  { href: '/portal/handbook', label: 'Handbook & Vision', exact: false },
  ...(showAdminTab
    ? [{ href: '/portal/admin', label: 'Roll Call & Roster', exact: false }]
    : []),
];

const badgeClass = voicePartBadgeColor(singer.voicePart);
---

<header class="sticky top-0 z-30 border-b border-zinc-200/80 bg-white/90 backdrop-blur-md">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex items-center justify-between gap-2 py-2.5 sm:py-3">
      <a href="/portal" class="flex min-w-0 items-center gap-2 sm:gap-2.5">
        <img
          src="/images/kantorei-logo-transparent.webp"
          alt={`${choirName} logo`}
          width="96"
          height="50"
          class="h-8 w-auto shrink-0 object-contain sm:h-9"
        />
        <span class="hidden rounded-full bg-copper-100 px-2.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-gold-500 xs:inline-block sm:inline-block">
          Singer Portal
        </span>
      </a>

      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2.5">
        <div class="flex items-center gap-1.5">
          <span class="hidden text-sm font-semibold text-zinc-800 md:inline">{singer.name}</span>
          <span class={`rounded-full border px-2 py-0.5 text-[11px] font-bold ${badgeClass}`}>
            {singer.voicePart}
          </span>
          {isOnLeave && (
            <span class="rounded-full border border-indigo-200 bg-indigo-50 px-2 py-0.5 text-[10px] font-semibold text-indigo-700">
              🌙 Leave
            </span>
          )}
          {singer.role !== 'Singer' && (
            <span class="hidden rounded-full bg-navy-900 px-2.5 py-0.5 text-[11px] font-semibold text-gold-300 sm:inline-block">
              {singer.role.replace('_', ' ')}
            </span>
          )}
        </div>

        <a
          href="/"
          class="rounded-xl border border-zinc-200 bg-zinc-50/70 px-2.5 py-1.5 text-xs font-medium text-zinc-600 transition hover:border-zinc-300 hover:bg-white hover:text-zinc-900"
        >
          Public Site
        </a>

        <form method="POST" action="/api/auth/logout">
          <button
            type="submit"
            class="cursor-pointer rounded-xl border border-zinc-200 px-2.5 py-1.5 text-xs font-medium text-zinc-600 transition hover:border-rose-200 hover:bg-rose-50 hover:text-rose-700"
          >
            Sign Out
          </button>
        </form>
      </div>
    </div>

    <!-- Modern Pill Navigation Bar (Touch-Scrollable on Mobile & iPad) -->
    <nav
      class="scrollbar-none -mx-1 flex items-center gap-1 overflow-x-auto pb-2.5 pt-0.5 px-1"
      aria-label="Singer Portal Navigation"
    >
      {tabs.map((tab) => {
        const isActive = tab.exact
          ? currentPath === tab.href || currentPath === `${tab.href}/`
          : currentPath.startsWith(tab.href);
        return (
          <a
            href={tab.href}
            class:list={[
              'shrink-0 rounded-xl px-3.5 py-1.5 text-xs sm:text-sm font-medium transition-all',
              isActive
                ? 'bg-navy-900 text-white font-semibold shadow-2xs'
                : 'text-zinc-600 hover:bg-zinc-100/80 hover:text-navy-950',
            ]}
          >
            {tab.label}
          </a>
        );
      })}
    </nav>
  </div>
</header>

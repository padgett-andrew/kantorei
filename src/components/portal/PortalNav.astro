---
import type { Singer } from '../../types/choir';
import UserProfileMenu from './UserProfileMenu';

interface Props {
  singer: Singer;
  choirName: string;
  currentPath: string;
  masterSheetUrl?: string;
  repertoireDriveUrl?: string;
  calendarUrl?: string;
  isSheetAdmin?: boolean;
}

const {
  singer,
  choirName,
  currentPath,
  masterSheetUrl = 'https://docs.google.com/spreadsheets',
  repertoireDriveUrl,
  calendarUrl,
  isSheetAdmin = singer.role === 'Admin',
} = Astro.props;

const tabs = [
  { href: '/portal', label: 'Schedule', exact: true },
  { href: '/portal/music', label: 'Music', exact: false },
  { href: '/portal/absences', label: 'Absences', exact: false },
  { href: '/portal/snacks', label: 'Hospitality', exact: false },
  { href: '/portal/seating', label: 'Seating', exact: false },
  { href: '/portal/directory', label: 'Roster', exact: false },
  { href: '/portal/handbook', label: 'Documents', exact: false },
];
---

<header class="sticky top-0 z-30 border-b border-white/10 bg-[#0B131E] text-white shadow-md">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex h-16 items-center justify-between gap-4">
      {/* Left: Brand Breadcrumb (Kantorei -> Public Site / Portal -> Overview) + Navigation Tabs */}
      <div class="flex min-w-0 items-center gap-3 sm:gap-5 lg:gap-7">
        <div class="flex shrink-0 items-center gap-2 sm:gap-2.5">
          <a
            href="/"
            class="group flex items-center gap-1 opacity-90 transition hover:opacity-100"
            title="Visit Kantorei Public Website (kantorei.net)"
          >
            <img
              src="/images/kantorei-logo-light.webp"
              alt={`${choirName} public website`}
              width="110"
              height="57"
              class="h-7 w-auto shrink-0 object-contain transition-transform group-hover:scale-[1.03] sm:h-8"
            />
          </a>

          <span class="text-sm font-light text-stone-600 select-none" aria-hidden="true">/</span>

          <a
            href="/portal"
            class="rounded-sm border border-copper-400/35 bg-copper-500/20 px-2 py-0.5 text-[10px] sm:text-[11px] font-semibold uppercase tracking-wider text-copper-300 transition hover:border-copper-400/60 hover:bg-copper-500/35 hover:text-white"
            title="Singer Portal Overview"
          >
            Portal
          </a>
        </div>

        {/* Primary Navigation Tabs — Next to Logo */}
        <nav
          class="scrollbar-none hidden sm:flex items-center gap-1 overflow-x-auto py-1"
          aria-label="Singer Portal Navigation"
        >
          {tabs.map((tab) => {
            const isActive = tab.exact
              ? currentPath === tab.href || currentPath === `${tab.href}/`
              : currentPath.startsWith(tab.href);
            return (
              <a
                href={tab.href}
                class:list={[
                  'shrink-0 rounded-md px-2.5 py-1 text-xs font-medium transition-colors border',
                  isActive
                    ? 'border-copper-400/40 bg-copper-500/25 font-semibold text-copper-300 shadow-2xs'
                    : 'border-transparent text-stone-300 hover:bg-white/10 hover:text-white',
                ]}
              >
                {tab.label}
              </a>
            );
          })}
        </nav>
      </div>

      {/* Right: Quick Public Site link + User Profile Menu */}
      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <a
          href="/"
          class="hidden sm:inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-stone-300 transition hover:border-white/25 hover:bg-white/10 hover:text-white"
          title="Return to Kantorei Public Website"
        >
          <span class="text-stone-400">←</span>
          <span>Public Site</span>
        </a>

        <UserProfileMenu
          client:load
          singer={singer}
          isSheetAdmin={isSheetAdmin}
          masterSheetUrl={masterSheetUrl}
          repertoireDriveUrl={repertoireDriveUrl}
          calendarUrl={calendarUrl}
        />
      </div>
    </div>
  </div>
</header>

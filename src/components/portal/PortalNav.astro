---
import type { Singer } from '../../types/choir';
import UserProfileMenu from './UserProfileMenu';

interface Props {
  singer: Singer;
  choirName: string;
  currentPath: string;
  masterSheetUrl?: string;
  repertoireDriveUrl?: string;
  calendarUrl?: string;
  isSheetAdmin?: boolean;
}

const {
  singer,
  choirName,
  currentPath,
  masterSheetUrl = 'https://docs.google.com/spreadsheets',
  repertoireDriveUrl,
  calendarUrl,
  isSheetAdmin = singer.role === 'Admin',
} = Astro.props;

const tabs = [
  { href: '/portal', label: 'Schedule', exact: true },
  { href: '/portal/music', label: 'Music', exact: false },
  { href: '/portal/absences', label: 'Absences', exact: false },
  { href: '/portal/snacks', label: 'Hospitality', exact: false },
  { href: '/portal/seating', label: 'Seating', exact: false },
  { href: '/portal/directory', label: 'Roster', exact: false },
  { href: '/portal/handbook', label: 'Documents', exact: false },
];
---

<header class="sticky top-0 z-30 border-b border-stone-200/80 bg-[#FAF7F2]/95 text-navy-950 backdrop-blur-sm">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex min-h-[4.5rem] items-center justify-between gap-4 py-2">
      <div class="flex min-w-0 items-center gap-3 sm:gap-6">
        <div class="flex shrink-0 items-center gap-2.5">
          <a
            href="/"
            class="group flex items-center opacity-90 transition hover:opacity-100"
            title={`Visit ${choirName} public website`}
          >
            <img
              src="/images/kantorei-logo-transparent.webp"
              alt={`${choirName} home`}
              width="110"
              height="57"
              class="h-8 w-auto shrink-0 object-contain transition-transform group-hover:scale-[1.02] sm:h-9"
            />
          </a>
          <span class="h-7 border-l border-stone-300" aria-hidden="true"></span>
          <a
            href="/portal"
            aria-current={currentPath === '/portal' || currentPath === '/portal/' ? 'page' : undefined}
            class="font-editorial text-lg font-semibold leading-none text-navy-950 transition hover:text-copper-600 sm:text-xl"
            title="Singer Portal overview"
          >
            Singer Portal
          </a>
        </div>

        <nav
          class="scrollbar-none hidden items-center gap-4 overflow-x-auto py-2 lg:flex"
          aria-label="Singer Portal Navigation"
        >
          {tabs.map((tab) => {
            const isActive = tab.exact
              ? currentPath === tab.href || currentPath === `${tab.href}/`
              : currentPath.startsWith(tab.href);
            return (
              <a
                href={tab.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative shrink-0 py-2 text-xs font-medium transition-colors after:absolute after:right-0 after:bottom-0 after:left-0 after:h-px after:origin-left after:bg-copper-500 after:transition-transform',
                  isActive
                    ? 'text-navy-950 after:scale-x-100'
                    : 'text-stone-600 after:scale-x-0 hover:text-navy-950 hover:after:scale-x-100',
                ]}
              >
                {tab.label}
              </a>
            );
          })}
        </nav>
      </div>

      <div class="flex shrink-0 items-center gap-2 sm:gap-3">
        <a
          href="/"
          class="hidden items-center gap-1.5 border-r border-stone-300 pr-3 text-xs font-medium text-stone-600 transition hover:text-copper-600 sm:inline-flex"
          title="Return to the public website"
        >
          <span aria-hidden="true">←</span>
          <span>Public Site</span>
        </a>
        <UserProfileMenu
          client:load
          singer={singer}
          isSheetAdmin={isSheetAdmin}
          masterSheetUrl={masterSheetUrl}
          repertoireDriveUrl={repertoireDriveUrl}
          calendarUrl={calendarUrl}
        />
      </div>
    </div>
  </div>
</header>

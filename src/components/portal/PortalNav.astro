---
import type { Singer } from '../../types/choir';
import UserProfileMenu from './UserProfileMenu';

interface Props {
  singer: Singer;
  choirName: string;
  currentPath: string;
  masterSheetUrl?: string;
  repertoireDriveUrl?: string;
  calendarUrl?: string;
  isSheetAdmin?: boolean;
}

const {
  singer,
  choirName,
  currentPath,
  masterSheetUrl = 'https://docs.google.com/spreadsheets',
  repertoireDriveUrl,
  calendarUrl,
  isSheetAdmin = singer.role === 'Admin',
} = Astro.props;

const tabs = [
  { href: '/portal', label: 'Schedule', exact: true },
  { href: '/portal/music', label: 'Music', exact: false },
  { href: '/portal/absences', label: 'Absences', exact: false },
  { href: '/portal/snacks', label: 'Sign-Ups', exact: false },
  { href: '/portal/seating', label: 'Seating', exact: false },
  { href: '/portal/directory', label: 'Roster', exact: false },
  { href: '/portal/handbook', label: 'Documents', exact: false },
];
---

<header
  id="portal-header"
  class="sticky top-0 z-30 border-b border-stone-200/90 bg-[#FAF7F2]/95 text-navy-950 backdrop-blur-md transition-transform duration-300 ease-out will-change-transform"
>
  <div class="mx-auto max-w-6xl px-4 sm:px-8">
    <div class="flex min-h-[4.5rem] items-center justify-between gap-4 py-2">
      <div class="flex min-w-0 items-center gap-4 sm:gap-8">
        <div class="flex shrink-0 items-center gap-3">
          <a
            href="/"
            class="group flex items-center opacity-90 transition hover:opacity-100"
            title={`Visit ${choirName} public website`}
          >
            <img
              src="/images/kantorei-logo-transparent.webp"
              alt={`${choirName} home`}
              width="110"
              height="57"
              class="h-8 w-auto shrink-0 object-contain transition-transform group-hover:scale-[1.02] sm:h-9"
            />
          </a>
          <span class="h-6 border-l border-stone-300/80" aria-hidden="true"></span>
          <a
            href="/portal"
            aria-current={currentPath === '/portal' || currentPath === '/portal/' ? 'page' : undefined}
            class="font-editorial text-xl font-medium tracking-tight leading-none text-navy-950 transition hover:text-copper-600 sm:text-[1.35rem]"
            title="Singer Portal overview"
          >
            Singer Portal
          </a>
        </div>

        <nav
          class="scrollbar-none hidden items-center gap-5 overflow-x-auto py-2 xl:flex"
          aria-label="Singer Portal Navigation"
        >
          {tabs.map((tab) => {
            const isActive = tab.exact
              ? currentPath === tab.href || currentPath === `${tab.href}/`
              : currentPath.startsWith(tab.href);
            return (
              <a
                href={tab.href}
                aria-current={isActive ? 'page' : undefined}
                class:list={[
                  'relative shrink-0 py-2 text-[11px] font-medium uppercase tracking-[0.15em] transition-colors after:absolute after:right-0 after:bottom-0 after:left-0 after:h-[1.5px] after:origin-left after:bg-copper-500 after:transition-transform',
                  isActive
                    ? 'text-navy-950 after:scale-x-100'
                    : 'text-stone-500 after:scale-x-0 hover:text-navy-950 hover:after:scale-x-100',
                ]}
              >
                {tab.label}
              </a>
            );
          })}
        </nav>
      </div>

      <div class="flex shrink-0 items-center gap-3">
        <a
          href="/"
          class="hidden items-center gap-1.5 border-r border-stone-300/80 pr-3.5 text-[11px] font-medium uppercase tracking-[0.14em] text-stone-500 transition hover:text-copper-600 sm:inline-flex"
          title="Return to the public website"
        >
          <span>Public Site</span>
          <span aria-hidden="true" class="text-stone-400">↗</span>
        </a>
        <UserProfileMenu
          client:load
          singer={singer}
          isSheetAdmin={isSheetAdmin}
          masterSheetUrl={masterSheetUrl}
          repertoireDriveUrl={repertoireDriveUrl}
          calendarUrl={calendarUrl}
        />
      </div>
    </div>
  </div>
</header>

<script>
  function initPortalHeaderScroll() {
    const header = document.getElementById('portal-header');
    if (!header) return;

    let lastScrollY = Math.max(0, window.scrollY);
    let ticking = false;
    const TOP_OFFSET = 64;
    const SCROLL_DELTA = 8;

    function showHeader() {
      header!.classList.remove('-translate-y-full');
    }

    function hideHeader() {
      header!.classList.add('-translate-y-full');
    }

    function updateHeader() {
      ticking = false;
      const currentY = Math.max(0, window.scrollY);

      // Always reveal near the top of the document
      if (currentY <= TOP_OFFSET) {
        showHeader();
        lastScrollY = currentY;
        return;
      }

      // Keep header pinned if profile menu is open or focus is inside header
      const isMenuOpen = header!.querySelector('[aria-expanded="true"]') !== null;
      const hasFocus = header!.contains(document.activeElement);
      if (isMenuOpen || hasFocus) {
        showHeader();
        lastScrollY = currentY;
        return;
      }

      const diff = currentY - lastScrollY;

      // Ignore tiny scroll tremors below hysteresis threshold
      if (Math.abs(diff) < SCROLL_DELTA) {
        return;
      }

      // Guard against iOS rubber-band bounce at the very bottom of the page
      const maxScroll = document.documentElement.scrollHeight - window.innerHeight;
      if (maxScroll > 0 && currentY >= maxScroll - 12 && diff < 0) {
        return;
      }

      if (diff > 0) {
        hideHeader();
      } else {
        showHeader();
      }

      lastScrollY = currentY;
    }

    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          window.requestAnimationFrame(updateHeader);
          ticking = true;
        }
      },
      { passive: true },
    );

    // Reveal immediately if a keyboard user tabs into any link/button in the header
    header.addEventListener('focusin', showHeader);
  }

  initPortalHeaderScroll();
  document.addEventListener('astro:after-swap', initPortalHeaderScroll);
</script>

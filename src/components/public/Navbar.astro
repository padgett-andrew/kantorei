---
interface Props {
  choirName?: string;
  currentPath?: string;
  isSignedIn?: boolean;
  facebookUrl?: string;
  instagramUrl?: string;
  youtubeUrl?: string;
}

const {
  choirName = 'Kantorei',
  currentPath = '/',
  isSignedIn = false,
  facebookUrl = 'https://www.facebook.com/kantoreimn',
  instagramUrl = 'https://www.instagram.com/kantorei_mn',
  youtubeUrl = 'https://www.youtube.com/@kantoreiMN',
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/concerts', label: 'Concerts & Tickets' },
  { href: '/media', label: 'Media' },
  { href: '/about', label: 'About' },
  { href: '/support', label: 'Support' },
  { href: isSignedIn ? '/portal' : '/login', label: isSignedIn ? 'Singer Portal' : 'Singer Login' },
];
---

<header
  id="site-header"
  class="fixed top-0 inset-x-0 z-50 transition-all duration-300 border-b border-transparent bg-transparent text-white"
>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3.5 sm:px-6">
    <a href="/" class="group flex items-center gap-3" aria-label={`${choirName} Home`}>
      <img
        src="/images/kantorei-logo-light.webp"
        alt={`${choirName} logo`}
        width="128"
        height="67"
        class="h-10 sm:h-11 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </a>

    <nav class="hidden items-center gap-6 lg:gap-8 md:flex" aria-label="Primary">
      {navLinks.map((link) => {
        const active =
          link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'text-xs font-medium uppercase tracking-[0.16em] transition-colors',
              active
                ? 'text-white underline decoration-gold-400 decoration-2 underline-offset-8'
                : 'text-zinc-200 hover:text-white',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden items-center gap-4 md:flex">
      <!-- Social Media Channels -->
      <div class="flex items-center gap-1 border-r border-white/15 pr-3 text-zinc-300">
        {facebookUrl && (
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on Facebook`}
            title="Facebook"
            class="rounded-sm p-1.5 transition-colors hover:text-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" />
            </svg>
          </a>
        )}
        {instagramUrl && (
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on Instagram`}
            title="Instagram"
            class="rounded-sm p-1.5 transition-colors hover:text-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        )}
        {youtubeUrl && (
          <a
            href={youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on YouTube`}
            title="YouTube"
            class="rounded-sm p-1.5 transition-colors hover:text-white"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        )}
      </div>

      <a
        href="/concerts"
        class="rounded-sm bg-copper-500 px-4 py-2 text-xs font-semibold uppercase tracking-[0.16em] text-white shadow-xs transition hover:bg-copper-600"
      >
        Buy Tickets
      </a>
    </div>

    <!-- Editorial Minimal Mobile Menu Toggle -->
    <details class="group/menu relative md:hidden">
      <summary
        class="flex cursor-pointer list-none items-center gap-2 border-0 bg-transparent p-1 text-xs font-medium uppercase tracking-[0.2em] text-ivory-100 hover:text-white transition-colors focus:outline-none select-none"
        aria-label="Toggle navigation menu"
      >
        <span>MENU</span>
        <!-- Custom two-line minimal icon (no border, no background fill) -->
        <span class="flex flex-col justify-center gap-[4px] w-4 py-0.5" aria-hidden="true">
          <span
            class="block h-[1.5px] w-full rounded-full bg-ivory-100 transition-all duration-200 origin-center group-open/menu:rotate-45 group-open/menu:translate-y-[2.75px]"
          ></span>
          <span
            class="block h-[1.5px] w-full rounded-full bg-ivory-100 transition-all duration-200 origin-center group-open/menu:-rotate-45 group-open/menu:-translate-y-[2.75px]"
          ></span>
        </span>
      </summary>

      <!-- Dropdown Panel in Rich Slate -->
      <div class="absolute right-0 mt-3 w-64 rounded-xl border border-white/10 bg-[#0B131E]/98 p-4 shadow-2xl backdrop-blur-xl">
        <div class="flex flex-col gap-1.5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-md px-3 py-2 text-xs font-medium uppercase tracking-[0.14em] text-zinc-200 hover:bg-white/10 hover:text-white transition-colors"
            >
              {link.label}
            </a>
          ))}
          <hr class="my-2 border-white/10" />
          <a
            href="/concerts"
            class="rounded-sm bg-copper-500 px-4 py-2.5 text-center text-xs font-semibold uppercase tracking-[0.16em] text-white hover:bg-copper-600 transition"
          >
            Buy Tickets
          </a>
          <div class="mt-3 flex items-center justify-center gap-3 border-t border-white/10 pt-3 text-zinc-400">
            {facebookUrl && (
              <a
                href={facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on Facebook`}
                title="Facebook"
                class="flex h-8 w-8 items-center justify-center rounded-sm border border-white/15 hover:bg-white/10 hover:text-white transition-colors"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" />
                </svg>
              </a>
            )}
            {instagramUrl && (
              <a
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on Instagram`}
                title="Instagram"
                class="flex h-8 w-8 items-center justify-center rounded-sm border border-white/15 hover:bg-white/10 hover:text-white transition-colors"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </a>
            )}
            {youtubeUrl && (
              <a
                href={youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on YouTube`}
                title="YouTube"
                class="flex h-8 w-8 items-center justify-center rounded-sm border border-white/15 hover:bg-white/10 hover:text-white transition-colors"
              >
                <svg class="h-3.5 w-3.5 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

<script>
  function handleNavbarScroll() {
    const header = document.getElementById('site-header');
    if (!header) return;

    if (window.scrollY > 20) {
      header.classList.add('bg-[#0B131E]/95', 'backdrop-blur-md', 'border-white/10', 'shadow-md');
      header.classList.remove('bg-transparent', 'border-transparent');
    } else {
      header.classList.remove('bg-[#0B131E]/95', 'backdrop-blur-md', 'border-white/10', 'shadow-md');
      header.classList.add('bg-transparent', 'border-transparent');
    }
  }

  window.addEventListener('scroll', handleNavbarScroll, { passive: true });
  handleNavbarScroll();
</script>

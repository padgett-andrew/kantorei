---
interface Props {
  choirName?: string;
  currentPath?: string;
  isSignedIn?: boolean;
  facebookUrl?: string;
  instagramUrl?: string;
  youtubeUrl?: string;
}

const {
  choirName = 'Kantorei',
  currentPath = '/',
  isSignedIn = false,
  facebookUrl = 'https://www.facebook.com/kantoreimn',
  instagramUrl = 'https://www.instagram.com/kantorei_mn',
  youtubeUrl = 'https://www.youtube.com/@kantoreiMN',
} = Astro.props;

const navLinks = [
  { href: '/', label: 'Home' },
  { href: '/concerts', label: 'Concerts & Tickets' },
  { href: '/media', label: 'Media' },
  { href: '/about', label: 'About' },
  { href: '/support', label: 'Support' },
  { href: isSignedIn ? '/portal' : '/login', label: isSignedIn ? 'Singer Portal' : 'Singer Login' },
];
---

<header class="sticky top-0 z-40 border-b border-zinc-200/80 bg-ivory-50/95 backdrop-blur-md">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">
    <a href="/" class="group flex items-center gap-3" aria-label={`${choirName} Home`}>
      <img
        src="/images/kantorei-logo-transparent.webp"
        alt={`${choirName} logo`}
        width="128"
        height="67"
        class="h-11 w-auto object-contain transition-transform duration-200 group-hover:scale-[1.02]"
      />
    </a>

    <nav class="hidden items-center gap-5 lg:gap-7 md:flex" aria-label="Primary">
      {navLinks.map((link) => {
        const active =
          link.href === '/'
            ? currentPath === '/'
            : currentPath.startsWith(link.href);
        return (
          <a
            href={link.href}
            class:list={[
              'text-sm font-medium transition-colors',
              active
                ? 'text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-8'
                : 'text-zinc-600 hover:text-navy-900',
            ]}
          >
            {link.label}
          </a>
        );
      })}
    </nav>

    <div class="hidden items-center gap-3.5 md:flex">
      <!-- Social Media Channels (Facebook, Instagram, YouTube) -->
      <div class="flex items-center gap-0.5 border-r border-zinc-300/80 pr-3 text-zinc-500">
        {facebookUrl && (
          <a
            href={facebookUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on Facebook`}
            title="Facebook"
            class="rounded-lg p-2 transition-colors hover:bg-ivory-200/80 hover:text-navy-950"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" />
            </svg>
          </a>
        )}
        {instagramUrl && (
          <a
            href={instagramUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on Instagram`}
            title="Instagram"
            class="rounded-lg p-2 transition-colors hover:bg-ivory-200/80 hover:text-navy-950"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>
          </a>
        )}
        {youtubeUrl && (
          <a
            href={youtubeUrl}
            target="_blank"
            rel="noopener noreferrer"
            aria-label={`${choirName} on YouTube`}
            title="YouTube"
            class="rounded-lg p-2 transition-colors hover:bg-ivory-200/80 hover:text-navy-950"
          >
            <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
              <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
            </svg>
          </a>
        )}
      </div>

      <a
        href="/concerts"
        class="rounded-full bg-gold-500 px-5 py-2.5 text-xs font-semibold uppercase tracking-wider text-white shadow-xs transition hover:bg-copper-600"
      >
        Buy Tickets
      </a>
    </div>

    <!-- Zero-JS Mobile Dropdown -->
    <details class="relative md:hidden">
      <summary class="flex cursor-pointer list-none items-center gap-1.5 rounded-lg border border-zinc-300 px-3 py-2 text-xs font-semibold uppercase tracking-wider text-navy-900">
        Menu
        <svg class="h-4 w-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M4 6h16M4 12h16M4 18h16" stroke-linecap="round" />
        </svg>
      </summary>
      <div class="absolute right-0 mt-2 w-64 rounded-2xl border border-zinc-200 bg-white p-4 shadow-xl">
        <div class="flex flex-col gap-2.5">
          {navLinks.map((link) => (
            <a
              href={link.href}
              class="rounded-lg px-3 py-2 text-sm font-medium text-zinc-800 hover:bg-ivory-100"
            >
              {link.label}
            </a>
          ))}
          <hr class="my-1 border-zinc-200" />
          <a
            href="/concerts"
            class="rounded-full bg-gold-500 px-4 py-2.5 text-center text-xs font-semibold uppercase tracking-wider text-white"
          >
            Buy Tickets
          </a>
          <div class="mt-2 flex items-center justify-center gap-3 border-t border-zinc-100 pt-3 text-zinc-500">
            {facebookUrl && (
              <a
                href={facebookUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on Facebook`}
                title="Facebook"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 hover:bg-zinc-100 hover:text-navy-950 transition-colors"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" />
                </svg>
              </a>
            )}
            {instagramUrl && (
              <a
                href={instagramUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on Instagram`}
                title="Instagram"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 hover:bg-zinc-100 hover:text-navy-950 transition-colors"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
                </svg>
              </a>
            )}
            {youtubeUrl && (
              <a
                href={youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                aria-label={`${choirName} on YouTube`}
                title="YouTube"
                class="flex h-9 w-9 items-center justify-center rounded-full border border-zinc-200 hover:bg-zinc-100 hover:text-navy-950 transition-colors"
              >
                <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
                </svg>
              </a>
            )}
          </div>
        </div>
      </div>
    </details>
  </div>
</header>

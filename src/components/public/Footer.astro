---
interface Props {
  choirName?: string;
  youtubeUrl?: string;
  instagramUrl?: string;
  facebookUrl?: string;
  taxExemptDisclaimer?: string;
  contactEmail?: string;
  contactPhone?: string;
  contactAddress?: string;
}

const {
  choirName = 'Kantorei',
  youtubeUrl = 'https://www.youtube.com/@kantoreiMN',
  instagramUrl = 'https://www.instagram.com/kantorei_mn',
  facebookUrl = 'https://www.facebook.com/kantoreimn',
  taxExemptDisclaimer,
  contactEmail = 'info@kantorei.net',
  contactPhone = '612-21-SINGS (612-217-4647)',
  contactAddress = '660 23rd Ave NW, Saint Paul, MN 55112',
} = Astro.props;

const year = new Date().getFullYear();
---

<footer class="border-t border-navy-800 bg-navy-950 text-ivory-100">
  <div class="mx-auto max-w-6xl px-4 py-14 sm:px-6">
    <div class="grid gap-10 md:grid-cols-12">
      <div class="md:col-span-5">
        <a href="/" class="inline-block">
          <img
            src="/images/kantorei-logo-light.webp"
            alt={`${choirName} logo`}
            width="140"
            height="73"
            class="h-12 w-auto object-contain"
          />
        </a>
        <p class="mt-4 max-w-sm text-sm leading-relaxed text-zinc-300">
          Founded in 1988 by Axel Theimer and led by Artistic Director Adam Reinwald, {choirName} is one of Minnesota’s premier choral ensembles—sharing rich, effortless a cappella sound and singing for a lifetime.
        </p>

        <!-- Social Channels: YouTube, Instagram, Facebook -->
        <div class="mt-5 flex items-center gap-3">
          {youtubeUrl && (
            <a
              href={youtubeUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${choirName} on YouTube`}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-ivory-100 transition hover:border-gold-400 hover:bg-gold-500/20 hover:text-gold-300"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z" />
              </svg>
            </a>
          )}
          {instagramUrl && (
            <a
              href={instagramUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${choirName} on Instagram`}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-ivory-100 transition hover:border-gold-400 hover:bg-gold-500/20 hover:text-gold-300"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
              </svg>
            </a>
          )}
          {facebookUrl && (
            <a
              href={facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={`${choirName} on Facebook`}
              class="flex h-9 w-9 items-center justify-center rounded-full border border-white/15 bg-white/5 text-ivory-100 transition hover:border-gold-400 hover:bg-gold-500/20 hover:text-gold-300"
            >
              <svg class="h-4 w-4 fill-current" viewBox="0 0 24 24">
                <path d="M22.675 0h-21.35c-.732 0-1.325.593-1.325 1.325v21.351c0 .731.593 1.324 1.325 1.324h11.495v-9.294h-3.128v-3.622h3.128v-2.671c0-3.1 1.893-4.788 4.659-4.788 1.325 0 2.463.099 2.795.143v3.24l-1.918.001c-1.504 0-1.795.715-1.795 1.763v2.313h3.587l-.467 3.622h-3.12v9.293h6.116c.73 0 1.323-.593 1.323-1.325v-21.35c0-.732-.593-1.325-1.325-1.325z" />
              </svg>
            </a>
          )}
        </div>

        <!-- Contact Information -->
        <div class="mt-5 space-y-1.5 text-xs text-zinc-300">
          <p class="flex items-center gap-2">
            <span class="font-medium text-gold-400">Email:</span>
            <a
              href={`mailto:${contactEmail}`}
              class="text-zinc-200 transition hover:text-white underline decoration-zinc-600 underline-offset-2"
            >
              {contactEmail}
            </a>
          </p>
          <p class="flex items-center gap-2">
            <span class="font-medium text-gold-400">Phone:</span>
            <a
              href="tel:+16122174647"
              class="text-zinc-200 transition hover:text-white underline decoration-zinc-600 underline-offset-2"
            >
              {contactPhone}
            </a>
          </p>
          <p class="flex items-start gap-2">
            <span class="font-medium text-gold-400 shrink-0">Mailing:</span>
            <span class="text-zinc-300">{contactAddress}</span>
          </p>
        </div>

        <p class="mt-4 text-xs text-zinc-500">
          {taxExemptDisclaimer || `${choirName} is a registered 501(c)(3) nonprofit arts organization in Minnesota. Contributions are tax-deductible to the fullest extent permitted by law.`}
        </p>
      </div>

      <div class="md:col-span-3">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">
          Explore
        </h3>
        <ul class="mt-4 space-y-2.5 text-sm text-zinc-300">
          <li><a href="/concerts" class="hover:text-white transition">Concerts & Tickets</a></li>
          <li><a href="/media" class="hover:text-white transition">Media & Recordings</a></li>
          <li><a href="/about" class="hover:text-white transition">About & Leadership</a></li>
          <li><a href="/auditions" class="hover:text-white transition">Audition for {choirName}</a></li>
          <li><a href="/support" class="hover:text-white transition">Tax-Deductible Giving</a></li>
        </ul>
      </div>

      <div class="md:col-span-4">
        <h3 class="font-sans text-xs font-semibold uppercase tracking-[0.16em] text-gold-400">
          Ensemble Members & Auditions
        </h3>
        <p class="mt-4 text-sm text-zinc-400">
          Interested in singing? Auditions are held each May for our fall season (inquiries welcome year-round). Current roster members can access scores and tools in the portal.
        </p>
        <div class="mt-5 flex flex-wrap gap-2.5">
          <a
            href="/auditions"
            class="inline-flex items-center gap-1.5 rounded-full border border-gold-400/40 bg-gold-500/10 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-gold-300 transition hover:border-gold-400 hover:bg-gold-500/20"
          >
            Audition Info
          </a>
          <a
            href="/portal"
            class="inline-flex items-center gap-1.5 rounded-full border border-zinc-700 bg-navy-900 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-ivory-100 transition hover:border-gold-400 hover:text-gold-300"
          >
            Singer Portal
          </a>
          <a
            href="/support"
            class="inline-flex items-center gap-1.5 rounded-full bg-gold-500 px-4 py-2 text-xs font-semibold uppercase tracking-wider text-white transition hover:bg-copper-600"
          >
            Donate Today
          </a>
        </div>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-white/10 pt-6 text-xs text-zinc-500 sm:flex-row">
      <p>© {year} {choirName} · Minnesota · kantorei.net</p>
      <p>Powered by Cloudflare Edge · Ticket Tailor · Givebutter</p>
    </div>
  </div>
</footer>

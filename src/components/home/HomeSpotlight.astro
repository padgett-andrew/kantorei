---
import AddToCalendarButton from '../common/AddToCalendarButton';
import LocationDirectionsButton from '../common/LocationDirectionsButton';
import ConcertArtwork from '../public/ConcertArtwork.astro';
import NewsletterForm from '../public/NewsletterForm';
import { buildCleanLocationQuery } from '../../lib/maps';
import type { ConcertEvent, MediaItem, PortalConfig } from '../../types/choir';
import type { YouTubeEmbedResult } from '../../lib/media';

interface Props {
  spotlightMode: 'concert' | 'recording' | 'friends';
  spotlightConcert: ConcertEvent | null;
  spotlightMedia: MediaItem | null;
  spotlightEyebrow: string;
  spotlightActionLabel: string;
  spotlightVideoEmbed: YouTubeEmbedResult | null;
  config: PortalConfig;
}

const {
  spotlightMode,
  spotlightConcert,
  spotlightMedia,
  spotlightEyebrow,
  spotlightActionLabel,
  spotlightVideoEmbed,
  config,
} = Astro.props;
---

<section class="mx-auto -mt-6 sm:-mt-10 relative z-10 max-w-4xl px-3.5 sm:px-6">
  {
    spotlightMode === "concert" && spotlightConcert && (
      <div class="rounded-2xl border border-stone-200/90 bg-[#FAF7F2] p-5 sm:p-7 shadow-sm">
        <div class="grid grid-cols-1 md:grid-cols-12 gap-6 sm:gap-7 items-center">
          {/* Left Column: 16:9 Artwork + Action Buttons */}
          <div class="md:col-span-5 flex flex-col justify-between space-y-4">
            {(spotlightConcert.heroImageUrl ||
              spotlightConcert.posterImageUrl) && (
              <ConcertArtwork
                heroImageUrl={spotlightConcert.heroImageUrl}
                posterImageUrl={spotlightConcert.posterImageUrl}
                title={spotlightConcert.title}
                aspectRatio="aspect-video w-full"
                class="rounded-xl shadow-xs"
                loading="eager"
              />
            )}

            {/* Desktop Action Buttons */}
            <div class="hidden md:flex flex-col gap-2.5 pt-0.5">
              <a
                href={`/concerts#${spotlightConcert.slug}`}
                class="w-full inline-flex items-center justify-center rounded-sm bg-copper-500 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition hover:bg-copper-600"
              >
                {spotlightActionLabel}
              </a>
              <a
                href="/concerts"
                class="text-center text-xs font-medium uppercase tracking-[0.14em] text-stone-600 underline decoration-stone-300 underline-offset-4 hover:text-navy-950 hover:decoration-copper-500 transition-colors py-0.5"
              >
                View Season &rarr;
              </a>
            </div>
          </div>

          {/* Right Column: Editorial Details & Performance Itinerary */}
          <div class="md:col-span-7 flex flex-col justify-between">
            <div>
              <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-copper-600">
                {spotlightEyebrow}
              </p>

              <h2 class="mt-1.5 font-editorial text-2xl sm:text-3xl lg:text-4xl font-medium leading-snug tracking-tight text-navy-950">
                {spotlightConcert.title}
              </h2>

              <p class="mt-2.5 text-sm sm:text-base leading-relaxed text-stone-700">
                {spotlightConcert.description}
              </p>

              {spotlightConcert.boxOfficeNote && (
                <div class="mt-3.5 flex items-start gap-2.5 rounded-lg bg-stone-100/80 border border-stone-200/80 p-3 text-xs leading-relaxed text-stone-700">
                  <span class="inline-block rounded-sm bg-copper-100 px-1.5 py-0.5 text-[10px] font-bold uppercase tracking-wider text-copper-800 shrink-0">
                    Note
                  </span>
                  <p>{spotlightConcert.boxOfficeNote}</p>
                </div>
              )}

              {/* Performance Itinerary */}
              {spotlightConcert.performances &&
              spotlightConcert.performances.length > 1 ? (
                <div class="mt-4 space-y-3.5 border-t border-b border-stone-200/70 py-3.5">
                  {spotlightConcert.performances.map((perf, pIdx) => (
                    <div
                      class={
                        pIdx > 0 ? "border-t border-stone-200/50 pt-3.5" : ""
                      }
                    >
                      <div class="flex flex-wrap items-baseline justify-between gap-2">
                        <h3 class="font-serif font-semibold text-navy-950 text-base sm:text-lg leading-snug">
                          {perf.dateDisplay}
                        </h3>
                        <div class="shrink-0">
                          <AddToCalendarButton
                            client:load
                            title={spotlightConcert.title}
                            description={spotlightConcert.description}
                            dateStr={perf.dateDisplay}
                            location={buildCleanLocationQuery(
                              perf.venueName,
                              perf.venueAddress,
                            )}
                            venueName={perf.venueName}
                            venueAddress={perf.venueAddress}
                            iconOnly={true}
                            align="right"
                          />
                        </div>
                      </div>
                      <div class="mt-1">
                        <LocationDirectionsButton
                          client:load
                          location={buildCleanLocationQuery(
                            perf.venueName,
                            perf.venueAddress,
                          )}
                          venueName={perf.venueName}
                          variant="inline"
                        />
                      </div>
                    </div>
                  ))}
                </div>
              ) : (
                <div class="mt-4 border-t border-b border-stone-200/70 py-3.5 space-y-2">
                  <div class="flex flex-wrap items-baseline justify-between gap-2">
                    <h3 class="font-serif font-semibold text-navy-950 text-base sm:text-lg leading-snug">
                      {spotlightConcert.datesDisplay}
                    </h3>
                    <div class="shrink-0">
                      <AddToCalendarButton
                        client:load
                        title={spotlightConcert.title}
                        description={spotlightConcert.description}
                        dateStr={spotlightConcert.datesDisplay}
                        location={buildCleanLocationQuery(
                          spotlightConcert.venueName,
                          spotlightConcert.venueAddress,
                        )}
                        venueName={spotlightConcert.venueName}
                        venueAddress={spotlightConcert.venueAddress}
                        iconOnly={true}
                        align="right"
                      />
                    </div>
                  </div>
                  {spotlightConcert.venueName && (
                    <div class="mt-1">
                      <LocationDirectionsButton
                        client:load
                        location={buildCleanLocationQuery(
                          spotlightConcert.venueName,
                          spotlightConcert.venueAddress,
                        )}
                        venueName={spotlightConcert.venueName}
                        variant="inline"
                      />
                    </div>
                  )}
                </div>
              )}
            </div>

            {/* Mobile Action Buttons */}
            <div class="mt-5 flex md:hidden flex-wrap items-center gap-4">
              <a
                href={`/concerts#${spotlightConcert.slug}`}
                class="inline-flex items-center justify-center rounded-sm bg-copper-500 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition hover:bg-copper-600"
              >
                {spotlightActionLabel}
              </a>
              <a
                href="/concerts"
                class="text-xs sm:text-sm font-medium uppercase tracking-[0.14em] text-stone-600 underline decoration-stone-300 underline-offset-4 hover:text-navy-950 hover:decoration-copper-500 transition-colors"
              >
                View Season &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    spotlightMode === "recording" && spotlightMedia && (
      <div class="overflow-hidden rounded-2xl border border-stone-200/90 bg-[#FAF7F2] shadow-sm">
        <div class="grid gap-0 md:grid-cols-12 md:items-center">
          <div class="md:col-span-5 bg-navy-950">
            {spotlightVideoEmbed?.embedUrl ? (
              <div class="aspect-video w-full">
                <iframe
                  src={spotlightVideoEmbed.embedUrl}
                  title={spotlightMedia.title}
                  loading="lazy"
                  allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                  allowfullscreen
                  class="h-full w-full border-0"
                />
              </div>
            ) : (
              <a
                href={spotlightMedia.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="group relative flex aspect-video w-full flex-col items-center justify-center overflow-hidden p-6 text-center text-white"
              >
                <span class="relative flex h-12 w-12 items-center justify-center rounded-full bg-gold-500 text-white shadow-lg transition group-hover:scale-105">
                  <svg
                    class="ml-0.5 h-5 w-5 fill-current"
                    viewBox="0 0 24 24"
                  >
                    <path d="M8 5v14l11-7z" />
                  </svg>
                </span>
                <span class="relative mt-2 text-xs font-semibold uppercase tracking-widest text-gold-300">
                  Watch on YouTube ↗
                </span>
              </a>
            )}
          </div>

          <div class="p-5 sm:p-7 lg:p-8 md:col-span-7 flex flex-col justify-between">
            <div>
              <p class="text-xs sm:text-sm font-bold uppercase tracking-[0.18em] text-copper-600">
                Featured Recording &bull;{" "}
                {spotlightMedia.category || "Listen & Watch"}
              </p>

              <h2 class="mt-1.5 font-editorial text-2xl sm:text-3xl lg:text-4xl font-medium leading-snug tracking-tight text-navy-950">
                {spotlightMedia.title}
              </h2>

              {spotlightMedia.subtitle && (
                <p class="mt-1 text-sm font-medium text-stone-600">
                  {spotlightMedia.subtitle}
                </p>
              )}

              {spotlightMedia.description && (
                <p class="mt-2.5 text-sm sm:text-base leading-relaxed text-stone-700 line-clamp-3">
                  {spotlightMedia.description}
                </p>
              )}
            </div>

            <div class="mt-6 flex flex-wrap items-center gap-4 sm:gap-5">
              <a
                href={spotlightMedia.youtubeUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex items-center justify-center rounded-sm bg-copper-500 px-5 py-2.5 text-xs sm:text-sm font-semibold uppercase tracking-[0.14em] text-white shadow-xs transition hover:bg-copper-600"
              >
                Watch on YouTube ↗
              </a>
              <a
                href="/media"
                class="text-xs sm:text-sm font-medium uppercase tracking-[0.14em] text-stone-600 underline decoration-stone-300 underline-offset-4 hover:text-navy-950 hover:decoration-copper-500 transition-colors"
              >
                Explore Media Library &rarr;
              </a>
            </div>
          </div>
        </div>
      </div>
    )
  }

  {
    spotlightMode === "friends" && (
      <NewsletterForm
        client:load
        variant="spotlight"
        source="Home_Spotlight_Fallback"
        title={config.Home_Spotlight_Title || "Stay in Touch with Kantorei"}
        description={
          config.Home_Spotlight_Description ||
          "We don't have any upcoming concerts scheduled right now. Join Friends of Kantorei to receive season announcements, recording releases, and priority ticket access."
        }
        buttonText={
          config.Newsletter_Button_Text || "Join Friends of Kantorei"
        }
      />
    )
  }
</section>

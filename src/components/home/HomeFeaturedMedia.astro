---
import MediaGallery from '../public/MediaGallery';
import type { MediaItem } from '../../types/choir';

interface Props {
  choirName: string;
  featuredMedia: MediaItem[];
  youtubeChannelUrl?: string;
}

const { choirName, featuredMedia, youtubeChannelUrl } = Astro.props;
---

<section class="border-t border-zinc-200 bg-white py-20">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="flex flex-col justify-between gap-4 sm:flex-row sm:items-end">
      <div>
        <span
          class="text-xs font-semibold uppercase tracking-[0.18em] text-gold-500"
        >
          Recordings Shared Worldwide
        </span>
        <h2
          class="mt-1 font-editorial text-3xl font-bold text-navy-950 sm:text-4xl"
        >
          Watch & Listen to {choirName}
        </h2>
        <p class="mt-1.5 text-xs text-zinc-600 sm:text-sm">
          Studio recordings and signature a cappella performances shared from
          Minnesota.
        </p>
      </div>
      <a
        href="/media"
        class="text-sm font-semibold text-navy-900 underline decoration-gold-500 decoration-2 underline-offset-4"
      >
        Explore Full Media Library →
      </a>
    </div>

    <div class="mt-10">
      <MediaGallery
        client:load
        featuredVideos={featuredMedia}
        youtubeChannelUrl={youtubeChannelUrl}
      />
    </div>
  </div>
</section>

